		<variableExpression><![CDATA[$F{MONTO_DOC}]]></variableExpression>
	</variable>
	<variable name="valSaldoAnt" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{SALDO}]]></variableExpression>
	</variable>
	<variable name="valMonto1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{MONTO1}]]></variableExpression>
	</variable>
	<variable name="valMonto2" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{MONTO2}]]></variableExpression>
	</variable>
	<variable name="valTotalUsado" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{MONTO1}.add($F{MONTO2})]]></variableExpression>
	</variable>
	<variable name="valSaldoCalc" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{MONTO_DOC}.subtract($F{MONTO1}.add($F{MONTO2}))]]></variableExpression>
	</variable>
