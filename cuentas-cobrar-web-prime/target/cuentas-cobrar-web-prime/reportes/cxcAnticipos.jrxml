<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="cxcAnticipos" pageWidth="1850" pageHeight="800" columnWidth="1810" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isFloatColumnFooter="true" uuid="fcfc7966-39bb-42c9-bcbe-8c2e09a14cea">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="1000"/>
	<property name="ireport.y" value="0"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["C:\\proyectos_maven\\servicios-web-prime\\src\\main\\webapp\\reportes\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="PLINEA" class="java.lang.String"/>
	<parameter name="PCOMPANIA" class="java.lang.String">
		<defaultValueExpression><![CDATA["CASABACA S.A"]]></defaultValueExpression>
	</parameter>
	<parameter name="PNO_CIA" class="java.lang.String"/>
	<parameter name="PCEDULA" class="java.lang.String"/>
	<parameter name="IMPRIME_CABECERA" class="java.lang.Boolean" isForPrompting="false"/>
	<queryString>
		<![CDATA[select no_cia,centro,no_docu,cedula,nombre, comprobante, fecha,monto_doc,NO_LINEA,
fecha_digitacion,saldo,nommoneda,no_docu, 0 valCompar,desc_concepto,
nvl((select sum(f.monto_doc) from arccrd f, arccmd g,fac_ventas_cab h
  where f.no_cia = $P{PNO_CIA} and f.no_refe = x.no_docu
  and f.no_cia = g.no_cia and f.no_docu = g.no_docu
  and g.no_cia = h.no_cia and g.no_fisico = h.no_factu),0)monto1,
nvl((select sum(f.monto_doc) from arccan f, arccmd g
  where f.no_cia =$P{PNO_CIA} and f.no_refe =  x.no_docu
  and f.no_cia = g.no_cia
  and f.no_docu = g.no_docu
  and f.aplica_como ='SA'
  and nvl(g.anulado,'N') = 'N'),0)monto2,sysdate fecha_actual,
DECODE(NVL($P{PLINEA},'0'),'0','TODOS',DESC_LINEA)DESCRIPCION,canal
from(
select  a.no_cia,a.centro,a.no_docu,c.cedula,c.nombre,a.no_fisico||a.serie_fisico comprobante, a.fecha,b.monto_doc,a.fecha_digitacion,a.saldo, nvl(d.nombre,'DOLARES') nommoneda,B.NO_LINEA,
(SELECT AR.DESCRIPCION FROM ARCJLI AR WHERE AR.NO_CIA = $P{PNO_CIA} and AR.NO_LINEA =B.NO_LINEA)DESC_LINEA,
(SELECT DESCRIPCION FROM PARAM_DET WHERE NO_CIA = $P{PNO_CIA} AND CODIGO = 'ANTCON' and CODIGO_DET = b.concepto)desc_concepto,
(select DESCRIPCION from param_DET pd
 where pd.no_cia = '10'
 and UPPER(pd.CODIGO) = 'CANALR'
 AND pd.CODIGO_DET = C.CANAL_REPUESTOS
)CANAL
from arccmd a, arcjan b,arccmc c, g_monedas d
where a.no_cia =$P{PNO_CIA}
and nvl(anulado,'N') = 'N'
and nvl(a.saldo,0) < 0
and C.CEDULA = NVL($P{PCEDULA},C.CEDULA)
and a.no_cia = b.no_cia
and a.no_docu = b.no_docu
AND B.NO_LINEA = DECODE(NVL($P{PLINEA},'0'),'0',B.NO_LINEA,$P{PLINEA})
and b.aplica_como = 'AN'
and a.no_cia = c.no_cia
and a.grupo = c.grupo
and a.no_cliente = c.no_cliente
and a.no_cia = d.empresa_id(+)
and a.moneda_id = d.moneda_id(+)
union
select a.no_cia,a.centro,a.no_docu,c.cedula,c.nombre,
a.no_fisico||a.serie_fisico,a.fecha,b.monto_doc,a.fecha_digitacion,a.saldo, nvl(d.nombre,'DOLARES') nommoneda
,B.NO_LINEA,
(SELECT AR.DESCRIPCION FROM ARCJLI AR WHERE AR.NO_CIA = $P{PNO_CIA} and AR.NO_LINEA =B.NO_LINEA)DESC_LINEA,
(SELECT DESCRIPCION FROM PARAM_DET WHERE NO_CIA = $P{PNO_CIA} AND CODIGO = 'ANTCON' and CODIGO_DET = b.concepto)desc_concepto,
(select DESCRIPCION from param_DET pd
 where pd.no_cia = '10'
 and UPPER(pd.CODIGO) = 'CANALR'
 AND pd.CODIGO_DET = C.CANAL_REPUESTOS
)CANAL
from arccmd a, arccan b,arccmc c, g_monedas d
where a.no_cia =$P{PNO_CIA}
and nvl(anulado,'N') = 'N'
and nvl(a.saldo,0) < 0
and C.CEDULA = NVL($P{PCEDULA},C.CEDULA)
and a.no_cia = b.no_cia
and a.no_docu = b.no_docu
AND B.NO_LINEA = DECODE(NVL($P{PLINEA},'0'),'0',B.NO_LINEA,$P{PLINEA})
and b.aplica_como = 'AN'
and a.no_cia = c.no_cia
and a.grupo = c.grupo
and a.no_cliente = c.no_cliente
and a.no_cia = d.empresa_id(+)
and a.moneda_id = d.moneda_id(+))x
order by nombre]]>
	</queryString>
