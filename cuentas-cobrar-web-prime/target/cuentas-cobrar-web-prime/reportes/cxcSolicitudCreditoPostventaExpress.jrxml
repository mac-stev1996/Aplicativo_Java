	<parameter name="NO_CIA" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="NO_SOLICITUD" class="java.lang.Long">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="RUTA_LOGO" class="java.lang.String"/>
	<parameter name="MODULO" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["MERCADEO"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT c.NO_SOLICITUD, c.CEDULA, c.CENTRO, ag.NOMBRE as NOM_AGENCIA, c.ANTIGUEDAD_TRA, c.BANCO, b.descripcion as NOM_BANCO,
c.CARGO, c.CIUDAD_TRA, c.DOMICILIO_CALLE, c.DOMICILIO_REFERECIA, c.EGRESO, c.EMAIL, c.ciudad_cliente,
c.ESTADO, c.ESTADO_CIVIL, e.descripcion as NOM_ECIVIL, c.FECHA, c.FECHA_EST_APROBADO, c.FECHA_EST_ENVIADO,
c.FECHA_EST_INGRESADO, c.FECHA_EST_REVISADO, c.GARANTE_CIUDAD, c.GARANTE_NOMBRES, c.GARANTE_PARENTESCO,
c.GARANTE_TELEFONO, c.GIRO_NEGOCIO, c.INGRESO, c.LUGAR_TRABAJO, c.MONTO_DISPONIBLE, c.NO_CIA, a.DESCRI as NOM_CIA, NO_CUENTA, c.NOMBRES, c.OBSERVACION_EST_APROBADO, c.OBSERVACION_EST_REVISADO, c.TELEFONO, c.TELEFONO_CEL,
c.TELEFONO_TRA, c.TIPO_CUENTA, tc.descripcion as NOM_TCUENTA, c.TIPO_VIVIENDA,  v.descripcion as NOM_TVIVIENDA, c.USUARIO, u.NOMBRE AS NOM_USUARIO, c.USUARIO_APRUEBA, c.USUARIO_ENVIA, c.USUARIO_REVISA
from CXC_CREDITO_POSTVENTA c
left join ARAFMC a on a.NO_CIA = c.NO_CIA
left join PARAM_DET e on (e.CODIGO_DET  = c.ESTADO_CIVIL AND e.CODIGO = 'ESTC' AND  e.NO_CIA = $P{NO_CIA})
left join PARAM_DET v on (v.CODIGO_DET  = c.TIPO_VIVIENDA AND v.CODIGO = 'CLIVIE' AND v.NO_CIA = $P{NO_CIA})
left join PARAM_DET tc on (tc.CODIGO_DET  = c.TIPO_CUENTA AND tc. CODIGO = 'EMTCTA' AND tc.NO_CIA = $P{NO_CIA})
left join CHE_BANCO_CTATRANSFERENCIA b on (b.CODIGO_BANCO = c.BANCO AND b.ESTADO = 'A' AND b.NO_CIA = $P{NO_CIA})
left join AGENCIAS ag on (ag.CODIGO = c.CENTRO AND ag.no_cia= $P{NO_CIA})
left join USUARIOS_SIS u on u.USUARIO = c.USUARIO
WHERE c.NO_CIA = $P{NO_CIA} AND c.NO_SOLICITUD = $P{NO_SOLICITUD}]]>
	</queryString>
