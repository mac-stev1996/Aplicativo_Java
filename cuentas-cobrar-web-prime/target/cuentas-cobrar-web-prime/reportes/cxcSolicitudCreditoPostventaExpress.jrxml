	<variable name="vAutorizacion1" class="java.lang.String">
		<variableExpression><![CDATA["DECLARO (AMOS) QUE LOS DATOS QUE ANTECEDEN  SON CIERTOS Y CORRECTOS. AUTORIZO (AMOS) EXPRESA E IRREVOCABLEMENTE A "+ $F{NOM_CIA} +" PARA QUE OBTENGA CUANTAS VECES SEAN NECESARIAS DE CUALQUIER FUENTE DE INFORMACION INCLUIDOS LOS BUROS DE CREDITO, DINARDAP (MI) NUESTRA INFORMACION DE RIESGOS CREDITICIOS, DE IGUAL FORMA QUEDA EXPRESAMENTE AUTORIZADO PARA QUE PUEDA TRANSFERIR O ENTREGAR DICHA INFORMACION A LOS BUROS DE CREDITO, DINARDAP Y/O CENTRAL DE RIESGOS SI FUERA PERTINENTE. "]]></variableExpression>
		<initialValueExpression><![CDATA[$V{vAutorizacion1}]]></initialValueExpression>
	</variable>
