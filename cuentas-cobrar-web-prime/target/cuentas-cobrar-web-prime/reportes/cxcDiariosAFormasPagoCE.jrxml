<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="cxcDiariosAFormasPagoCE" pageWidth="559" pageHeight="768" columnWidth="559" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="ee1f736a-a296-4017-81a8-abb5f74c04a8">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="P_NO_CIA" class="java.lang.String"/>
	<parameter name="P_NO_DOCU" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT ' CE' ce,
  numero_doc,
  BANCO,
  FECHA,
  CUENTA,
  monto,
  '   '
  ||simbolo_moneda('D') moneda
FROM arccmm
WHERE no_cia = $P{P_NO_CIA}
AND no_docu  = $P{P_NO_DOCU}
AND moneda   = 'D'
AND tipo_mov ='C'
AND tipo_retencion <> 'NC']]>
	</queryString>
	<field name="CE" class="java.lang.String"/>
	<field name="NUMERO_DOC" class="java.lang.String"/>
	<field name="BANCO" class="java.lang.String"/>
	<field name="FECHA" class="java.sql.Timestamp"/>
	<field name="CUENTA" class="java.lang.String"/>
