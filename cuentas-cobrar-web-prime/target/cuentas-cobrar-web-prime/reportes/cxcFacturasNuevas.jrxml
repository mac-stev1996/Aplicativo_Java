<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="cxcFacturasNuevas" language="groovy" pageWidth="1500" pageHeight="842" columnWidth="1460" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="f6684c3a-c4c5-4e3b-906d-93790256857c">
	<property name="ireport.zoom" value="0.8264462809917359"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="p_no_cia" class="java.lang.String"/>
	<parameter name="p_nombre_empresa" class="java.lang.String"/>
	<parameter name="p_usuario" class="java.lang.String"/>
	<parameter name="p_linea_negocio" class="java.lang.String"/>
	<parameter name="p_clase_cliente" class="java.lang.String"/>
	<parameter name="p_fecha_inicio" class="java.util.Date"/>
	<parameter name="p_fecha_fin" class="java.util.Date"/>
	<parameter name="p_imprime_cabecera" class="java.lang.Boolean">
		<defaultValueExpression><![CDATA[new Boolean(true)]]></defaultValueExpression>
	</parameter>
	<parameter name="p_sql_emp_relacionadas" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT a.centrod, b.nombre nomagencia, a.no_cliente, c.cedula,substr(c.nombre,1,20) nomcli,a.fecha,
a.tipo_doc, E.Descripcion desctipo_docu, a.serie,
a.no_fisico,a.serie_fisico, d.descripcion linea_negocio, a.cant_prorrogas,a.tot_lin,
a.descuento,a.impuesto,decode(a.serie_fisico,'9',a.total2,a.total1) interes,
decode(a.serie_fisico,'9',0,a.total2) total2, a.valor_ingresos,a.total,
saldo_factura,
(select distinct f.descripcion from cxc_clase_cliente f where a.no_cia = f.no_cia and c.relacion = f.clase and Rownum = 1) clase
from fac_ventas_cab a,arccmc c, agencias b, arcjli d, fac_documentos e
where a.no_cia = $P{p_no_cia}
   and trunc(a.fecha) >= trunc($P{p_fecha_inicio})
  and trunc(a.fecha)  <= trunc($P{p_fecha_fin})
  and a.serie_fisico = nvl($P{p_linea_negocio},a.serie_fisico)
  and a.cant_prorrogas = '1'
  and nvl(a.ind_anu_dev,' ') = ' '
  and  a.tipo_doc <> 'SE'
  and nvl(a.saldo_factura,0) >= 0
  and a.no_cia = c.no_cia
  and a.grupo = c.grupo
 and a.no_cliente = c.no_cliente
  and nvl(c.relacion,'EX') = nvl($P{p_clase_cliente},c.relacion)
$P!{p_sql_emp_relacionadas}
  and a.no_cia = b.no_cia
  and a.centrod = b.codigo
  and a.no_cia = d.no_cia
  and a.linea_negocio = d.no_linea
  and a.no_cia = e.no_cia
  and a.tipo_doc = e.tipo
  and e.afecta_saldo = 'S'
  order by 1,6]]>
	</queryString>
