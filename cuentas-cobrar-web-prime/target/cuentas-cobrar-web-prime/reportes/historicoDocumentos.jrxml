	<subDataset name="historicoDocumentos" uuid="f02ac5d8-542a-4a0e-8348-76daf3d022cb">
		<parameter name="p_no_cliente" class="java.lang.Long"/>
		<parameter name="p_no_cia" class="java.lang.String"/>
		<parameter name="p_linea_negocio" class="java.lang.String"/>
		<parameter name="p_tipo_doc" class="java.lang.String"/>
		<parameter name="p_anulados" class="java.lang.String"/>
		<parameter name="p_documento" class="java.lang.String"/>
		<parameter name="p_fecha_inicio" class="java.util.Date"/>
		<parameter name="p_fecha_fin" class="java.util.Date"/>
		<parameter name="p_sql_adicional0" class="java.lang.String"/>
		<parameter name="p_sql_adicional1" class="java.lang.String"/>
		<queryString>
			<![CDATA[select centro,no_fisico,serie_fisico,cant_prorrogas,tipo_doc,saldo,fecha,
decode($P{p_documento},2,CXC_GENERAL_PCK.obt_monto_original($P{p_no_cia},$P{p_no_cliente},centro,no_fisico,serie_fisico,cant_prorrogas,fecha),m_original) monto_original,
tipo_mov,CONTADO,anulado,incobrable,decode(tipo_mov,'C',CXC_GENERAL_PCK.obt_no_pedido($P{p_no_cia},centro,no_fisico,serie_fisico),null) no_pedido
from (
SELECT centro,no_fisico,serie_fisico,cant_prorrogas,tipo_doc,
		sum(saldo) SALDO,trunc(FECHA) fecha,sum(m_original) m_original,
		(select tipo_mov from arcctd  where no_cia =$P{p_no_cia}  and tipo = a.tipo_doc) tipo_mov,
		null CONTADO,anulado,decode(incobrable,'1','I','2','IV') incobrable,
		nvl(moneda_id,'D') moneda_id , 2 DOCUMENTO
		 from arccmd_all_view a
		 where no_cia =$P{p_no_cia}
		 and no_cliente = $P{p_no_cliente}
		 and serie_fisico like $P{p_linea_negocio}
		 and tipo_DOC LIKE $P{p_tipo_doc}
         and nvl(anulado,'N') LIKE $P{p_anulados}
         and trunc(fecha) >=trunc($P{p_fecha_inicio})
         and trunc(fecha) <=trunc($P{p_fecha_fin})
         $P!{p_sql_adicional0}
          group by trunc(FECHA),nvl(comentario, observacion),usuario_solicita,
          centro,serie_fisico,no_fisico,cant_prorrogas,tipo_doc,
          anulado,incobrable, negocio_id, nvl(moneda_id,'D')

          union all

          SELECT a.centrod,a.no_fisico,a.serie_fisico,a.cant_prorrogas,
		a.tipo_doc,a.saldo_factura SALDO,a.FECHA,a.TOTAL m_original,
		(select tipo_mov from arcctd  where no_cia =a.no_cia  and tipo = a.tipo_doc) tipo_mov,'CON',a.ind_anu_dev anulado,null,
		nvl(moneda_id,'D') moneda_id ,1 DOCUMENTO
		 from fac_ventas_cab a, fac_documentos b
		 where a.no_cia =$P{p_no_cia}
		 and a.tipo_doc <> 'NC'
		 and a.no_cliente = $P{p_no_cliente}
		 and a.serie_fisico like $P{p_linea_negocio}
		 and a.tipo_DOC LIKE $P{p_tipo_doc}
		 and nvl(a.saldo_factura,0) = 0
         and trunc(a.fecha) >=trunc($P{p_fecha_inicio})
         and trunc(a.fecha) <=trunc($P{p_fecha_fin})
         and nvl(a.ind_anu_dev,'N') LIKE $P{p_anulados}
         and a.no_cia = b.no_cia
         and a.tipo_doc = b.tipo

         union all

         SELECT centrod,no_fisico,nvl(serie_fisico,'1'),cant_prorrogas,
		tipo_doc,saldo_factura SALDO,FECHA,total m_original,
		(select tipo_mov from arcctd  where no_cia =a.no_cia  and tipo = a.tipo_doc) tipo_mov,'CON', ind_anu_dev anulado,null,
		nvl(moneda_id,'D') moneda_id , 1 DOCUMENTO
		 from fac_ventas_cab a
		 where no_cia =$P{p_no_cia}
		 and nvl(serie_fisico,'1') = '1'
		 and no_cliente = $P{p_no_cliente}
		 and serie_fisico like $P{p_linea_negocio}
		 and tipo_doc = 'FAN'
         and trunc(fecha) >=trunc($P{p_fecha_inicio})
         and trunc(fecha) <=trunc($P{p_fecha_fin})
         and nvl(ind_anu_dev,'N') LIKE '')x
         WHERE 1=1
         $P!{p_sql_adicional1}
          ORDER BY serie_fisico,NO_FISICO]]>
		</queryString>
		<field name="CENTRO" class="java.lang.String"/>
		<field name="NO_FISICO" class="java.lang.String"/>
		<field name="SERIE_FISICO" class="java.lang.String"/>
		<field name="CANT_PRORROGAS" class="java.math.BigDecimal"/>
		<field name="TIPO_DOC" class="java.lang.String"/>
		<field name="SALDO" class="java.math.BigDecimal"/>
		<field name="FECHA" class="java.sql.Timestamp"/>
		<field name="MONTO_ORIGINAL" class="java.math.BigDecimal"/>
		<field name="TIPO_MOV" class="java.lang.String"/>
		<field name="CONTADO" class="java.lang.String"/>
		<field name="ANULADO" class="java.lang.String"/>
		<field name="INCOBRABLE" class="java.lang.String"/>
		<field name="NO_PEDIDO" class="java.lang.String"/>
		<variable name="total_saldo" class="java.lang.Number" calculation="Sum">
			<variableExpression><![CDATA[$F{SALDO}]]></variableExpression>
		</variable>
		<variable name="total_m_original" class="java.lang.Number" calculation="Sum">
			<variableExpression><![CDATA[$F{MONTO_ORIGINAL}]]></variableExpression>
		</variable>
	</subDataset>
	<parameter name="p_no_cia" class="java.lang.String"/>
	<parameter name="p_nombre_empresa" class="java.lang.String"/>
	<parameter name="p_usuario" class="java.lang.String"/>
	<parameter name="p_no_cliente" class="java.lang.Long"/>
	<parameter name="p_linea_negocio" class="java.lang.String"/>
	<parameter name="p_tipo_doc" class="java.lang.String"/>
