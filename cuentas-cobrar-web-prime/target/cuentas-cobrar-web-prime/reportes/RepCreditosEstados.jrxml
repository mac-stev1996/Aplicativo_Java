<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="RepCreditosEstados" pageWidth="3500" pageHeight="900" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="3500" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" isIgnorePagination="true" uuid="441503f2-1753-4a76-85d2-c8fbb6c6f18b">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="4345"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String"/>
	<parameter name="fechaFin" class="java.util.Date"/>
	<parameter name="fechaIni" class="java.util.Date"/>
	<parameter name="estado" class="java.lang.String"/>
	<parameter name="IMPRIME_CABECERA" class="java.lang.Boolean" isForPrompting="false">
		<defaultValueExpression><![CDATA[new Boolean(true)]]></defaultValueExpression>
	</parameter>
	<parameter name="agencia" class="java.lang.String"/>
	<parameter name="asesor" class="java.lang.String"/>
	<parameter name="noCia" class="java.lang.String"/>
	<parameter name="NombreCia" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT CRE.SOLICITUD, CRE.FECHA_INICIA_REVISION,
nvl(CRE.FECHA_FINALIZA_REVISION,(SELECT max(E.fecha) from CXC_CREDITO_ESTADO E where E.no_cia=CRE.NO_CIA and E.solicitud = CRE.solicitud AND E.ESTADO='R')) FECHA_FINALIZA_REVISION,

NVL(cre.fecha_usuario_revision,(SELECT max(E.fecha) from CXC_CREDITO_ESTADO E where E.no_cia=CRE.NO_CIA and E.solicitud = CRE.solicitud and E.estado='E')) FECHA_ASIGNACION,
nvl((select max(E.fecha) from CXC_CREDITO_ESTADO E where E.no_cia=CRE.NO_CIA and E.solicitud = CRE.solicitud and E.estado='A')
,nvl((select max(E.fecha) from CXC_CREDITO_ESTADO E where E.no_cia=CRE.NO_CIA and E.solicitud = CRE.solicitud and E.estado='N'),
(select max(E.fecha) from CXC_CREDITO_ESTADO E where E.no_cia=CRE.NO_CIA and E.solicitud = CRE.solicitud and E.estado='D'))) FECHA_RESPUESTA,

DECODE(COTI.SVLICODI, 6,'SEMINUEVOS',3,'NUEVOS',70,'EXONERADOS','26','AUTOS OK','OTRA') lineaNegocio,
CRE.NUMERO_COTIZACION COTIZACION, COTI.CEDULA_DEUDOR CEDULA, COTI.APELLIDOS||' '|| COTI.NOMBRES cliente,  CRE.VEHICULO, COTI.total_general VALORVEHICULO,
COTI.cuota_de_alcance + COTI.saldo_financiar financiamiento,  AGE.NOMBRE CENTRO, CRE.USUARIO ASESOR,
DECODE(CRE.ESTADO, 'D', 'DEVUELTO','N','NEGADO','E','ENVIADO','R','REVISADO','A','APROBADO','I', 'INGRESADO') ESTADO,
(SELECT MAX(E.FECHA) FROM CXC_CREDITO_ESTADO E WHERE E.NO_CIA=CRE.NO_CIA AND E.SOLICITUD=CRE.SOLICITUD AND E.ESTADO='A') FECHA_APROBACION,
(SELECT MAX(E.USUARIO) FROM CXC_CREDITO_ESTADO E WHERE E.NO_CIA=CRE.NO_CIA AND E.SOLICITUD=CRE.SOLICITUD AND E.ESTADO='R') USUARIO_REVISION,
CRE.FECHA_USUARIO_REVISION FECHAHORAASIGNACION,
TO_CHAR((select max(E.fecha) from CXC_CREDITO_ESTADO E where E.no_cia=CRE.NO_CIA and E.solicitud = CRE.solicitud and E.estado='E'),'DD-MON-YYYY') FECHAENV,
TO_CHAR(CRE.FECHA_ENVIADA,'HH24:MI') HORAENV,
DECODE(CRE.ESTADO, 'N', CRE.OBSERVACION, '') motivoNegacion,
nvl(cre.observacion_file_comite,cre.observacion) observacion,
DECODE(CRE.REVISA_COMITE, 'S', 'SI','NO') comite, DECODE(CRE.ESTADO,'A', DECODE(COTI.NO_FISICO,NULL,'NO','SI')) FACTURADO,
NVL(CRE.NUMERO_REPROCESO,'0') NUMREPROCESOS,
CASE WHEN (cre.cotizacion_reaprueba is null) THEN 'NO' ELSE 'SI' END AS reaprobacion,
CASE WHEN (select count(e.solicitud) from CXC_CREDITO_ESTADO e where e.no_cia= cre.no_cia and e.solicitud= cre.solicitud and e.estado='D') >0  THEN 'NO' ELSE 'SI' END AS DocumentosCompletos
FROM CXC_CREDITO CRE, SVFCOTI COTI, AGENCIAS AGE
WHERE CRE.NO_CIA=$P{noCia}
AND CRE.NUMERO_COTIZACION = COTI.NUMERO_COTIZACION
AND CRE.NO_CIA = COTI.NO_CIA
AND CRE.CONCESIONARIO = AGE.CODIGO
AND CRE.no_cia = AGE.no_cia
AND TRUNC(CRE.FECHA_ENVIADA) >= TRUNC($P{fechaIni})
AND TRUNC(CRE.FECHA_ENVIADA) < TRUNC($P{fechaFin})+1
AND CRE.ESTADO<>'I'
AND CRE.USUARIO = nvl($P{asesor}, CRE.USUARIO)
AND CRE.CONCESIONARIO = nvl($P{agencia}, CRE.CONCESIONARIO)
AND CRE.ESTADO =  nvl($P{estado}, CRE.ESTADO)
ORDER BY CRE.FECHA_ENVIADA ASC]]>
	</queryString>
	<field name="SOLICITUD" class="java.math.BigDecimal"/>
	<field name="FECHA_INICIA_REVISION" class="java.sql.Timestamp"/>
	<field name="FECHA_FINALIZA_REVISION" class="java.sql.Timestamp"/>
	<field name="FECHA_ASIGNACION" class="java.sql.Timestamp"/>
	<field name="FECHA_RESPUESTA" class="java.sql.Timestamp"/>
	<field name="LINEANEGOCIO" class="java.lang.String"/>
	<field name="COTIZACION" class="java.math.BigDecimal"/>
	<field name="CEDULA" class="java.lang.String"/>
	<field name="CLIENTE" class="java.lang.String"/>
	<field name="VEHICULO" class="java.lang.String"/>
	<field name="VALORVEHICULO" class="java.math.BigDecimal"/>
	<field name="FINANCIAMIENTO" class="java.math.BigDecimal"/>
	<field name="CENTRO" class="java.lang.String"/>
	<field name="ASESOR" class="java.lang.String"/>
	<field name="ESTADO" class="java.lang.String"/>
	<field name="FECHA_APROBACION" class="java.sql.Timestamp"/>
	<field name="USUARIO_REVISION" class="java.lang.String"/>
	<field name="FECHAHORAASIGNACION" class="java.sql.Timestamp"/>
	<field name="FECHAENV" class="java.lang.String"/>
	<field name="HORAENV" class="java.lang.String"/>
	<field name="MOTIVONEGACION" class="java.lang.String"/>
	<field name="OBSERVACION" class="java.lang.String"/>
	<field name="COMITE" class="java.lang.String"/>
	<field name="FACTURADO" class="java.lang.String"/>
	<field name="NUMREPROCESOS" class="java.math.BigDecimal"/>
	<field name="REAPROBACION" class="java.lang.String"/>
	<field name="DOCUMENTOSCOMPLETOS" class="java.lang.String"/>
	<variable name="TiempoRevision" class="java.lang.Long" resetType="None">
		<variableExpression><![CDATA[$F{FECHA_FINALIZA_REVISION}.getTime() - $F{FECHA_INICIA_REVISION}.getTime()]]></variableExpression>
	</variable>
	<variable name="TiempoEnCola" class="java.lang.Long" resetType="None">
		<variableExpression><![CDATA[$F{COMITE}.equals( "NO" )
? $F{FECHA_RESPUESTA}.getTime() - $F{FECHA_ASIGNACION}.getTime()
: 0L]]></variableExpression>
	</variable>
	<variable name="rowCount" class="java.lang.Integer" calculation="Count"/>
	<variable name="avgRevision" class="java.lang.Long" calculation="Average">
		<variableExpression><![CDATA[$F{FECHA_FINALIZA_REVISION}.getTime() - $F{FECHA_INICIA_REVISION}.getTime()]]></variableExpression>
	</variable>
	<variable name="avgEnCola" class="java.lang.Long" calculation="Average">
		<variableExpression><![CDATA[$F{COMITE}.equals( "NO" )
? $F{FECHA_RESPUESTA}.getTime() - $F{FECHA_ASIGNACION}.getTime()
: 0L]]></variableExpression>
	</variable>
