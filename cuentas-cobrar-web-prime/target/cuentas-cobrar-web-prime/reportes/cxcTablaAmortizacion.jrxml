	<subDataset name="detalleTablaAmortizacion" uuid="ef246110-c17f-4f49-b9e4-d8756f8d6847">
		<parameter name="p_no_cia" class="java.lang.String"/>
		<parameter name="p_agencia" class="java.lang.String"/>
		<parameter name="p_no_fisico" class="java.lang.String"/>
		<parameter name="p_serie_fisico" class="java.lang.String"/>
		<parameter name="p_cant_prorrogas" class="java.lang.Integer"/>
		<parameter name="p_no_cliente" class="java.lang.String"/>
		<parameter name="p_fecha" class="java.util.Date"/>
		<queryString>
			<![CDATA[select no_docu_refe,fecha_vence,dias,
(nvl(saldo_capital,0) - OBT_SALDO_ANTCLIENTE(no_cia, centro, no_cliente, no_fisico, trunc(fecha), serie_fisico, to_number(no_docu_refe), $P{p_cant_prorrogas})) saldo_inicial,
m_original, saldo_parcial,   intereses,
(nvl(saldo_capital,0) - OBT_SALDO_ANTCLIENTE(no_cia, centro, no_cliente, no_fisico, trunc(fecha), serie_fisico, to_number(no_docu_refe), $P{p_cant_prorrogas}) - nvl(capital,0)) saldo_capital from (
select b.no_cia, b.no_cliente, b.fecha, trunc(b.fecha_vence - b.fecha) dias,
b.centro, b.no_fisico, b.serie_fisico, b.no_docu_refe, b.fecha_vence, b.saldo_parcial capital, b.m_original cuota, b.intereses,
       b.m_original, saldo_parcial, (select sum(saldo_parcial) saldo_capital
from arccmd a
where a.no_cia = b.no_cia
and a.centro = b.centro
and a.no_cliente = b.no_cliente
and a.no_fisico = b.no_fisico
and a.serie_fisico = b.serie_fisico
and trunc(a.fecha) = trunc(b.fecha)
and a.cant_prorrogas = $P{p_cant_prorrogas}) saldo_capital
from arccmd b
where b.no_cia = $P{p_no_cia}
and b.centro = $P{p_agencia}
and b.no_cliente = $P{p_no_cliente}
and b.no_fisico = $P{p_no_fisico}
and b.serie_fisico = $P{p_serie_fisico}
and trunc(b.fecha) = trunc($P{p_fecha})
and b.cant_prorrogas = $P{p_cant_prorrogas}
and tipo_doc <> 'CA'
order by to_number(b.no_docu_refe))]]>
		</queryString>
		<field name="NO_DOCU_REFE" class="java.lang.String"/>
		<field name="FECHA_VENCE" class="java.sql.Timestamp"/>
		<field name="DIAS" class="java.math.BigDecimal"/>
		<field name="SALDO_INICIAL" class="java.math.BigDecimal"/>
		<field name="M_ORIGINAL" class="java.math.BigDecimal"/>
		<field name="SALDO_PARCIAL" class="java.math.BigDecimal"/>
		<field name="INTERESES" class="java.math.BigDecimal"/>
		<field name="SALDO_CAPITAL" class="java.math.BigDecimal"/>
		<variable name="total_mensual" class="java.lang.Number" calculation="Sum">
			<variableExpression><![CDATA[$F{M_ORIGINAL}]]></variableExpression>
		</variable>
		<variable name="total_capital" class="java.lang.Number" calculation="Sum">
			<variableExpression><![CDATA[$F{SALDO_PARCIAL}]]></variableExpression>
		</variable>
		<variable name="total_interes" class="java.lang.Number" calculation="Sum">
			<variableExpression><![CDATA[$F{INTERESES}]]></variableExpression>
		</variable>
	</subDataset>
	<parameter name="p_no_cia" class="java.lang.String"/>
	<parameter name="p_agencia" class="java.lang.String"/>
	<parameter name="p_no_fisico" class="java.lang.String"/>
	<parameter name="p_serie_fisico" class="java.lang.String"/>
	<parameter name="p_cant_prorrogas" class="java.lang.Integer"/>
	<parameter name="p_no_cliente" class="java.lang.String"/>
	<parameter name="p_fecha" class="java.util.Date"/>
	<parameter name="p_nombre_empresa" class="java.lang.String"/>
	<queryString>
		<![CDATA[select   (select b.descripcion||', '
      from agencias a, arcccan b
     where a.no_cia = $P{p_no_cia}
       and a.provincia = b.provincia
       and a.ciudad = b.canton
       and a.codigo = $P{p_agencia}) CIUDAD,sum(b.saldo_parcial) total_financiar,sum(b.intereses) total_interes,  sum(b.m_original) total_pago,
c.tasa_financia,round((SELECT ((POWER((1+((c.tasa_financia/100) / 12)), 12))-1)*100  FROM DUAL),2) tasa_efectiva,
letras(sum(b.m_original), 'D') texto_letras,d.cedula,d.nombre,rtrim(d.nombre_cyj) nom_conyugue, d.cedula_cyj cedula_conyugue
from arccmd b,fac_ventas_cab c, arccmc d
where b.no_cia = $P{p_no_cia}
and b.centro = $P{p_agencia}
and b.no_cliente = $P{p_no_cliente}
and b.no_fisico = $P{p_no_fisico}
and b.serie_fisico = $P{p_serie_fisico}
and trunc(b.fecha) = trunc($P{p_fecha})
and b.cant_prorrogas = $P{p_cant_prorrogas}
and b.tipo_doc <> 'CA'
and b.no_cia=c.no_cia
and b.centro=c.centrod
and b.no_fisico=c.no_fisico
and b.serie_fisico=c.serie_fisico
and b.cant_prorrogas=c.cant_prorrogas
and b.no_cliente=c.no_cliente
and b.periodo=c.periodo
and b.no_cia=d.no_cia
and b.no_cliente=d.no_cliente
and b.grupo=d.grupo
GROUP by c.tasa_financia,d.cedula,d.nombre, d.nombre_cyj , d.cedula_cyj]]>
	</queryString>
	<field name="CIUDAD" class="java.lang.String"/>
	<field name="TOTAL_FINANCIAR" class="java.math.BigDecimal"/>
	<field name="TOTAL_INTERES" class="java.math.BigDecimal"/>
	<field name="TOTAL_PAGO" class="java.math.BigDecimal"/>
	<field name="TASA_FINANCIA" class="java.math.BigDecimal"/>
	<field name="TASA_EFECTIVA" class="java.math.BigDecimal"/>
	<field name="TEXTO_LETRAS" class="java.lang.String"/>
	<field name="CEDULA" class="java.lang.String"/>
	<field name="NOMBRE" class="java.lang.String"/>
	<field name="NOM_CONYUGUE" class="java.lang.String"/>
	<field name="CEDULA_CONYUGUE" class="java.lang.String"/>
