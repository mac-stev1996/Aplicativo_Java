	<queryString>
		<![CDATA[select a.numero_cotizacion , a.nombres, a.apellidos, a.no_cliente, a.cedula_deudor
,b.DESCRIPCION_DOCUMENTO
,b.recibe_fisico
,b.fecha_recibe_fisico
,b.usuario_recibe_fisico
,b.env_cre_cob entregado
,b.fecha_env_cre_cob FECHA_ENTREGA
,b.usu_env_cre_cob USUARIO_ENTREGA
, d.no_fisico
, b.OBSERVACION_CREDITO observaciones
,b.REC_COB_CRE RECIBE_COBRANZAS
,b.FECHA_REC_COB_CRE FECHA_RECIBE_COBRANZAS
,b.USU_REC_COB_CRE USUARIO_RECIBE_COBRANZAS
from svfcoti a
join svfcoti_documentos b
on a.no_cia = b.no_cia
and a.centro = b.centro
and a.numero_cotizacion = b.numero_cotizacion
left join fac_ventas_cab d
on a.no_cia = d.no_cia
and a.centro = d.centrod
and to_char(a.numero_cotizacion) = d.no_pedido
and d.serie_fisico in ('3', '6', '70')
where a.no_cia = $P{noCia}
$P!{query}
order by a.cedula_deudor, b.orden]]>
	</queryString>
