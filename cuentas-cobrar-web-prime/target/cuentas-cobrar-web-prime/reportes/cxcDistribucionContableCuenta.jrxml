<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="cxcDistribucionContableCuenta" pageWidth="1700" pageHeight="595" orientation="Landscape" columnWidth="1660" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="d8c59182-befe-45d9-a418-9a318c9e296e">
	<property name="ireport.zoom" value="0.75"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="P_NOCIA" class="java.lang.String"/>
	<parameter name="P_FECHA_DESDE" class="java.util.Date"/>
	<parameter name="P_FECHA_HASTA" class="java.util.Date"/>
	<parameter name="P_CENTRO" class="java.lang.String"/>
	<parameter name="P_IMPRIME_CABECERA" class="java.lang.Boolean">
		<defaultValueExpression><![CDATA[new Boolean (false)]]></defaultValueExpression>
	</parameter>
	<parameter name="TITULO" class="java.lang.String"/>
	<parameter name="P_DESC_COMPANIA" class="java.lang.String"/>
	<parameter name="P_CUENTA_DESDE" class="java.lang.String"/>
	<parameter name="P_CUENTA_HASTA" class="java.lang.String"/>
	<parameter name="NOMBRE_AGENCIA" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
  C.NO_CIA CIA, C.TIPO_DOC, C.CENTRO, C.NO_DOCU, C.ANO, C.NO_ASIENTO, C.NO_CLIENTE, C.GRUPO,
  C.CTACON_ID CODIGO, C.TIPO, C.MONTO_DOL, M.NOMBRE DESCRI, NVL(DECODE(C.TIPO,'D', C.MONTO_DOL), 0) DEBITO,
   NVL(DECODE(C.TIPO,'C', MONTO_DOL), 0) CREDITO, A.FECHA, (SELECT MAX(NUMERO_DOC) FROM ARCCMM B WHERE B.NO_CIA = A.NO_CIA AND B.NO_DOCU = A.NO_DOCU) DEPOSITO,
  (B.NO_FISICO||'-'||B.SERIE_FISICO) VINGRESO, D.CEDULA, SUBSTR(D.NOMBRE,1,25) NOMBRE
FROM ARCCMD A, ARCCDA B, ARCCDC_SCB C, ARCCMC D, CON_PLANCTAS M
WHERE A.NO_CIA = $P{P_NOCIA}
      AND A.FECHA >= $P{P_FECHA_DESDE}
      AND A.FECHA <= $P{P_FECHA_HASTA}
      AND A.CENTRO >= NVL($P{P_CENTRO}, A.CENTRO)
      AND A.NO_CIA = C.NO_CIA
      AND A.CENTRO = C.CENTRO
      AND A.NO_DOCU = C.NO_DOCU
      AND B.NO_CIA = A.NO_CIA
      AND B.NO_DOCU = A.NO_DOCU
      AND C.CTACON_ID >= NVL($P{P_CUENTA_DESDE}, C.CTACON_ID)
      AND C.CTACON_ID <= NVL($P{P_CUENTA_HASTA}, C.CTACON_ID)
      AND C.NO_CIA = M.EMPRESA_ID
      AND C.CTACON_ID = M.CTACON_ID
      AND D.NO_CIA = C.NO_CIA
      AND D.GRUPO = C.GRUPO
      AND D.NO_CLIENTE = C.NO_CLIENTE
ORDER BY A.FECHA, A.NO_DOCU, C.NO_ASIENTO]]>
	</queryString>
	<field name="CIA" class="java.lang.String"/>
	<field name="TIPO_DOC" class="java.lang.String"/>
	<field name="CENTRO" class="java.lang.String"/>
	<field name="NO_DOCU" class="java.lang.String"/>
