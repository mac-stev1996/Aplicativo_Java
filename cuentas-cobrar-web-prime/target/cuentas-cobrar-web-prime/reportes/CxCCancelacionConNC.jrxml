<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="CxCCancelacionConNC" language="groovy" pageWidth="1400" pageHeight="842" orientation="Landscape" columnWidth="1400" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="43328d24-9177-42ff-a4b4-0c85f1553580">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="66"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="p_no_cia" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="p_fecha_inicio" class="java.util.Date"/>
	<parameter name="p_fecha_fin" class="java.util.Date"/>
	<parameter name="p_nombre_empresa" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="p_modulo" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="p_usuario" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="p_imprime_cabecera" class="java.lang.Boolean">
		<defaultValueExpression><![CDATA[new Boolean (true)]]></defaultValueExpression>
	</parameter>
	<parameter name="p_linea_negocio" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="p_tipo" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="p_clase_cliente" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select a.tipo_doc, a.no_fisico docnc,a.fecha,b.centro, e.nombre nomagencia, b.tipo_doc tipodocfc, b.no_fisico docafentanc,b.serie_fisico, g.descripcion nomlinea,b.cant_prorrogas,nvl(b.no_docu_refe,'1') no_docu_refe,
d.cedula, d.nombre nombre,
c.monto_doc valornc,
(select distinct f.descripcion
   from cxc_clase_cliente f
  where d.no_cia = f.no_cia and d.relacion = f.clase and Rownum = 1) clase,
nvl((select sum(h.saldo) from arccmd h
  where b.no_cia = h.no_cia
    and b.centro = h.centro
    and b.tipo_doc = h.tipo_doc
    and b.no_fisico = h.no_fisico
    and b.serie_fisico = h.serie_fisico
    and b.cant_prorrogas = h.cant_prorrogas
    and b.no_cliente = h.no_cliente
    and trunc(b.fecha) = trunc(h.fecha)),0) saldoactual, i.total
from arccmd a,arccmd b,arccrd c,arccmc d, agencias e, arcjli g, fac_ventas_cab i
where a.no_cia = $P{p_no_cia}
and trunc(a.fecha) >= trunc($P{p_fecha_inicio})
and trunc(a.fecha) <= trunc($P{p_fecha_fin})
and a.tipo_doc in ('FD','CR','DD','NC','DC','TD','DP')
and a.no_cia = c.no_cia
and a.no_cliente = c.no_cliente
and a.no_docu = c.no_docu
and c.no_cia = b.no_cia
and c.no_cliente = b.no_cliente
and c.no_refe = b.no_docu
and b.serie_fisico = nvl($P{p_linea_negocio},b.serie_fisico)
and nvl(b.incobrable,'0') not in ('1','2')
and nvl(a.anulado,' ') = 'N'
and a.no_cia = d.no_cia
and a.grupo = d.grupo
and a.no_cliente = d.no_cliente
and b.no_cia = e.no_cia
and b.centro = e.codigo
and b.no_cia = g.no_cia
and b.serie_fisico = g.no_linea
and b.no_cia = i.no_cia
and b.centro = i.centrod
and b.tipo_doc = i.tipo_doc
and b.no_fisico = i.no_fisico
and b.serie_fisico = i.serie_fisico
and b.cant_prorrogas = i.cant_prorrogas
and b.no_cliente = i.no_cliente
and trunc(b.fecha) = trunc(i.fecha)
and (case when (nvl(d.relacion,'ER') <> 'ER' and 'SER' = $P{p_tipo}) then
    'SER'
     else (case when (nvl(d.relacion,'ER') = nvl($P{p_clase_cliente},d.relacion) and 'PCL' =$P{p_tipo}) then
            nvl(d.relacion,'ER') else nvl(d.relacion,'ER')
        end)end) = nvl($P{p_clase_cliente},d.relacion)
union
select a.tipo_doc, b.no_fisico,a.fecha,b.centro, f.nombre nomagencia, e.tipo_doc tipofc, e.no_fisico factura,e.serie_fisico, g.descripcion nomlinea,e.cant_prorrogas,nvl(b.no_docu_refe,'1') no_docu_refe,
d.cedula, d.nombre nombre,
c.monto_doc, (select distinct f.descripcion from cxc_clase_cliente f where d.no_cia = f.no_cia and d.relacion = f.clase and Rownum = 1) clase,
nvl((select sum(h.saldo) from arccmd h
  where b.no_cia = h.no_cia
    and b.centro = h.centro
    and b.tipo_doc = h.tipo_doc
    and b.no_fisico = h.no_fisico
    and b.serie_fisico = h.serie_fisico
    and b.cant_prorrogas = h.cant_prorrogas
    and b.no_cliente = h.no_cliente
    and trunc(b.fecha) = trunc(h.fecha)),0) saldoactual, e.total totalfactura
from arccmd a,arccmd b,arccrd c,arccmc d, fac_ventas_cab e, agencias f, arcjli g
where a.no_cia = $P{p_no_cia}
and trunc(a.fecha) >= trunc($P{p_fecha_inicio})
and trunc(a.fecha) <= trunc($P{p_fecha_fin})
and a.tipo_doc in ('CA')
and a.no_cia = c.no_cia
and a.no_docu = c.no_docu
and c.no_cia = b.no_cia
and c.no_refe = b.no_docu
and e.serie_fisico = nvl($P{p_linea_negocio},b.serie_fisico)
and nvl(b.incobrable,'0') not in ('1','2')
and nvl(a.anulado,' ') = 'N'
and a.no_cia = d.no_cia
and a.grupo = d.grupo
and a.no_cliente = d.no_cliente
and b.no_cia = f.no_cia
and b.centro = f.codigo
and e.no_cia = g.no_cia
and e.serie_fisico = g.no_linea
and (case when (nvl(d.relacion,'ER') <> 'ER' and 'SER' = $P{p_tipo}) then
    'SER'
     else (case when (nvl(d.relacion,'ER') = nvl($P{p_clase_cliente},d.relacion) and 'PCL' = $P{p_tipo}) then
            nvl(d.relacion,'ER') else nvl(d.relacion,'ER')
        end)end) = nvl($P{p_clase_cliente},d.relacion)
and a.no_cia = e.no_cia
and a.no_cliente = e.no_cliente
and a.no_fisico = e.no_factu
order by 1,7]]>
	</queryString>
