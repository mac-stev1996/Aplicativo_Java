<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="cxcDetalleCobrosPorLinea" language="groovy" pageWidth="1404" pageHeight="842" columnWidth="1364" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="fd2100e1-7504-4bb2-8eb7-c9ddc1f729bc">
	<property name="ireport.zoom" value="1.1000000000000005"/>
	<property name="ireport.x" value="774"/>
