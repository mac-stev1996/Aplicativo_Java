	<parameter name="p_no_cia" class="java.lang.String"/>
	<parameter name="p_nombre_empresa" class="java.lang.String"/>
	<parameter name="p_usuario" class="java.lang.String"/>
	<parameter name="p_linea_negocio" class="java.lang.String"/>
	<parameter name="p_fecha_inicio" class="java.util.Date"/>
	<parameter name="p_fecha_fin" class="java.util.Date"/>
	<parameter name="p_imprime_cabecera" class="java.lang.Boolean">
		<defaultValueExpression><![CDATA[new Boolean(true)]]></defaultValueExpression>
	</parameter>
	<parameter name="p_tipo_pago" class="java.lang.String"/>
	<parameter name="p_banco" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT distinct d.centro,(select ag.nombre from agencias ag where ag.no_cia=d.no_cia and ag.codigo=d.centro) descripcion,
d.no_fisico factura,d.serie_fisico linea,d.cant_prorrogas,d.no_docu_refe,b.relacion,
b.cedula,substr(b.nombre,1,30) nombre, case when a.monto_doc=a.saldo_anterior then 'C' else 'A' end ca,e.no_fisico INGRESO,
a.monto_doc,a.descuento,a.interes interes, (nvl(a.interes,0)- nvl(comision_mora,0)) interes_m,a.total_pago,a.fecha,
d.fecha_vence ,trunc($P{p_fecha_fin})-trunc(d.fecha_vence) dias,d.TIPO_DOC
from arccrd a, arccmc b,arcctd c,arccmd_all_view d,arccmd_all_view e
where a.no_cia = $P{p_no_cia}
   and  trunc(a.fecha) >= trunc($P{p_fecha_inicio})
  and trunc(a.fecha)  <= trunc($P{p_fecha_fin})
  and a.no_cia = b.no_cia
  and a.grupo = b.grupo
  and a.no_cliente = b.no_cliente
  and nvl(b.relacion,'EX') <> 'ER'
  and a.no_cia = d.no_cia
  and a.no_refe = d.no_docu
  and a.no_cliente = d.no_cliente
  and nvl(d.serie_fisico,'0')=nvl($P{p_linea_negocio},nvl(d.serie_fisico,'0'))
  and d.tipo_doc <> 'SE'
  and nvl(d.incobrable,' ') not in ('1','2')
  and NVL(d.banco,' ') =nvl($P{p_banco},nvl(d.banco,' '))
  and (A.NO_CIA='ZA' OR (a.tipo_doc not in ('DD','FD','DC','DE','TD','NC') and a.no_cia<>'ZA'))
  and a.no_cia = e.no_cia
  and a.no_docu = e.no_docu
  and  nvl(e.anulado,'N') = 'N'
  and nvl(e.serie_fisico,' ') = nvl($P{p_tipo_pago},nvl(e.serie_fisico,' '))
  and a.no_cia = c.no_cia
  and a.tipo_refe = c.tipo
  and c.tipo_mov = 'D'
order by INGRESO]]>
	</queryString>
