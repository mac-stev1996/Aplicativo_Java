<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="cxcNegociosCancelados" language="groovy" pageWidth="1070" pageHeight="842" orientation="Landscape" columnWidth="1070" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="43328d24-9177-42ff-a4b4-0c85f1553580">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="p_no_cia" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="p_fecha_inicio" class="java.util.Date"/>
	<parameter name="p_fecha_fin" class="java.util.Date"/>
	<parameter name="p_nombre_empresa" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="p_usuario" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="p_imprime_cabecera" class="java.lang.Boolean" isForPrompting="false">
		<defaultValueExpression><![CDATA[new Boolean (true)]]></defaultValueExpression>
	</parameter>
	<parameter name="p_linea_negocio" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="p_modulo" class="java.lang.String"/>
	<queryString>
		<![CDATA[select a.fecha, d.cedula, d.nombre nombre,b.centro,f.nombre nomagencia, b.no_fisico,b.serie_fisico,e.descripcion,
b.cant_prorrogas,
sum((select sum(m_original) from arccmd g
  where b.no_cia = g.no_cia
  and b.centro = g.centro
  and b.tipo_doc = g.tipo_doc
  and b.no_fisico = g.no_fisico
  and b.serie_fisico = g.serie_fisico
  and b.cant_prorrogas = g.cant_prorrogas
  and b.no_cliente = g.no_cliente
  and trunc(b.fecha) = trunc(g.fecha))) valor_original,
max((select max(no_fisico||' '||serie_fisico) from arccmd h
where a.no_cia = h.no_cia
  and a.no_docu = (select max(i.no_docu) from arccrd i
                  where i.no_cia = a.no_cia
                    and i.no_refe = (select max(j.no_docu) from arccmd j
                                      where j.no_cia  = b.no_cia
                                        and j.centro = b.centro
                                        and j.tipo_doc = b.tipo_doc
                                        and j.no_fisico = b.no_fisico
                                        and j.serie_fisico = b.serie_fisico
                                        and j.cant_prorrogas = b.cant_prorrogas
                                        and j.no_cliente = b.no_cliente
                                        and trunc(j.fecha) = trunc(b.fecha))))) ingreso,
max((select max(fecha) from arccmd h
where a.no_cia = h.no_cia
  and a.no_docu = (select max(i.no_docu) from arccrd i
                  where i.no_cia = a.no_cia
                    and i.no_refe = (select max(j.no_docu) from arccmd j
                                      where j.no_cia  = b.no_cia
                                        and j.centro = b.centro
                                        and j.tipo_doc = b.tipo_doc
                                        and j.no_fisico = b.no_fisico
                                        and j.serie_fisico = b.serie_fisico
                                        and j.cant_prorrogas = b.cant_prorrogas
                                        and j.no_cliente = b.no_cliente
                                        and trunc(j.fecha) = trunc(b.fecha))))) fechaingreso,
sum(b.saldo) saldo
from arccrd a,arccmd b, fac_ventas_cab c,arccmc d, arcjli e, agencias f
where a.no_cia = $P{p_no_cia}
and trunc(a.fecha) >= trunc($P{p_fecha_inicio})
and trunc(a.fecha) <= trunc($P{p_fecha_fin})
and a.no_cia = b.no_cia
and a.no_refe = b.no_docu
and b.serie_fisico = nvl($P{p_linea_negocio},b.serie_fisico)
and a.no_cia = c.no_cia
and b.centro = c.centrod
and b.no_fisico = c.no_fisico
and b.serie_fisico = c.serie_fisico
and b.cant_prorrogas = c.cant_prorrogas
and c.linea <> 'IT'
and a.no_cia = d.no_cia
and a.grupo = d.grupo
and a.no_cliente = d.no_cliente
and e.no_cia = c.no_cia
and e.no_linea = c.serie_fisico
and b.no_cia = f.no_cia
and b.centro = f.codigo
having sum(b.saldo) =  0
group by a.fecha, e.descripcion, d.cedula,d.nombre,b.centro,f.nombre, b.no_fisico,b.serie_fisico,b.cant_prorrogas
UNION
select  b.fecha, c.cedula,c.nombre nombre,b.centro,e.nombre nomagencia, b.no_fisico,b.serie_fisico,
d.descripcion, b.cant_prorrogas,
sum((select sum(m_original) from arccmd g
  where b.no_cia = g.no_cia
  and b.centro = g.centro
  and b.tipo_doc = g.tipo_doc
  and b.no_fisico = g.no_fisico
  and b.serie_fisico = g.serie_fisico
  and b.cant_prorrogas = g.cant_prorrogas
  and b.no_cliente = g.no_cliente
  and trunc(b.fecha) = trunc(g.fecha))) valor_original,
max((select max(no_fisico||' '||serie_fisico) from arccmd h
where a.no_cia = h.no_cia
  and a.no_docu = (select max(i.no_docu) from arccrd i
                  where i.no_cia = a.no_cia
                    and i.no_refe = (select max(j.no_docu) from arccmd j
                                      where j.no_cia  = b.no_cia
                                        and j.centro = b.centro
                                        and j.tipo_doc = b.tipo_doc
                                        and j.no_fisico = b.no_fisico
                                        and j.serie_fisico = b.serie_fisico
                                        and j.cant_prorrogas = b.cant_prorrogas
                                        and j.no_cliente = b.no_cliente
                                        and trunc(j.fecha) = trunc(b.fecha))))) ingreso,
max((select max(fecha) from arccmd h
where a.no_cia = h.no_cia
  and a.no_docu = (select max(i.no_docu) from arccrd i
                  where i.no_cia = a.no_cia
                    and i.no_refe = (select max(j.no_docu) from arccmd j
                                      where j.no_cia  = b.no_cia
                                        and j.centro = b.centro
                                        and j.tipo_doc = b.tipo_doc
                                        and j.no_fisico = b.no_fisico
                                        and j.serie_fisico = b.serie_fisico
                                        and j.cant_prorrogas = b.cant_prorrogas
                                        and j.no_cliente = b.no_cliente
                                        and trunc(j.fecha) = trunc(b.fecha))))) fechaingreso,
sum(b.saldo)
from arccrd a,arccmd b, arccmc c, arcjli d, agencias e
where a.no_cia = $P{p_no_cia}
and trunc(a.fecha) >= trunc($P{p_fecha_inicio})
and trunc(a.fecha) <= trunc($P{p_fecha_fin})
and a.no_cia = b.no_cia
and a.no_refe = b.no_docu
and b.serie_fisico = nvl($P{p_linea_negocio},b.serie_fisico)
and nvl(b.cant_prorrogas,0) > 1
and a.no_cia = c.no_cia
and a.grupo = c.grupo
and a.no_cliente = c.no_cliente
and b.no_cia = d.no_cia
and b.serie_fisico = d.no_linea
and b.no_cia = e.no_cia
and b.centro = e.codigo
having sum(b.saldo) =  0
group by b.fecha, d.descripcion, c.cedula,c.nombre, b.centro,b.no_fisico,b.serie_fisico,b.cant_prorrogas, e.nombre
order by 3]]>
	</queryString>
