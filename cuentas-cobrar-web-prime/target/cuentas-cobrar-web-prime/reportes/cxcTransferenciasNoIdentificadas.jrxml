	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String"/>
	<parameter name="IMPRIME_CABECERA" class="java.lang.Boolean" isForPrompting="false">
		<defaultValueExpression><![CDATA[new Boolean(true)]]></defaultValueExpression>
	</parameter>
	<parameter name="noCia" class="java.lang.String"/>
	<parameter name="envioBanco" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="idBanco" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT c.BANCO,  b.DESCRIP, e.ID_TRIBUTARIO, b.CTACON_ID, c.FECHA_DOCUMENTO, c.FECHA_SOLICITUD, c.NO_CIA, c.DOC_ESTADO_CUENTA,
c.TIPO_TRANSACCION, c.USUARIO, c.VALOR_DOCUMENTO, c.OBSERVACION_NO_IDENTIFICADA, c.AGENCIA
from CON_DEPOSITOS c
LEFT JOIN ARCKTB b ON b.BANCO = c.BANCO and b.Estado = 'A'
LEFT JOIN ARCGMC e ON e.NO_CIA = c.NO_CIA
WHERE c.NO_CIA = $P{noCia}
and c.ESTADO = 'B'
and c.BANCO = $P{idBanco}
and c.ENVIO_BANCO = $P{envioBanco}]]>
	</queryString>
