				<textFieldExpression><![CDATA[(($F{TIPO_TRANSACCION}.equals("TR")) ? "TRANSFERENCIA MISMO BANCO" :
($F{TIPO_TRANSACCION}.equals("E")) ? "DEPOSITO EFECTIVO":
($F{TIPO_TRANSACCION}.equals("CH")) ? "DEPOSITO CHEQUE":
