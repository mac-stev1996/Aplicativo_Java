	<field name="VALOR_DOCUMENTO" class="java.math.BigDecimal"/>
	<field name="OBSERVACION_NO_IDENTIFICADA" class="java.lang.String"/>
	<field name="AGENCIA" class="java.lang.String"/>
	<variable name="TIEMPOREV" class="java.math.BigDecimal" calculation="Average">
		<variableExpression><![CDATA[]]></variableExpression>
	</variable>
	<variable name="TIEMPOAPR" class="java.math.BigDecimal" calculation="Average">
