<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="cxcRepVentasMesSaldo" pageWidth="900" pageHeight="842" columnWidth="860" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="e498cd7a-6e38-4156-a9d1-dc46311931e6">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="226"/>
	<property name="ireport.y" value="0"/>
	<parameter name="P_NOCIA" class="java.lang.String"/>
	<parameter name="P_SERIE_FISICO" class="java.lang.String"/>
	<parameter name="P_FECHA_INI" class="java.util.Date"/>
	<parameter name="P_FECHA_FIN" class="java.util.Date"/>
	<parameter name="IMPRIME_CABECERA" class="java.lang.Boolean"/>
	<queryString>
		<![CDATA[select c.cedula,c.nombre,a.fecha,a.centrod,a.no_fisico,a.serie_fisico,a.cant_prorrogas, a.sub_total,a.impuesto, sum(saldo)
from fac_Ventas_cab a, arccmd b, arccmc c
where a.no_cia = $P{P_NOCIA}
and trunc(a.fecha) >=  $P{P_FECHA_INI}
and trunc(a.fecha) <  $P{P_FECHA_FIN} + 1
and nvl(a.ind_anu_dev,'N') <> 'A'
and a.serie_fisico = nvl($P{P_SERIE_FISICO} ,a.serie_fisico)
and a.tipo_doc = 'FC'
and a.no_cia = b.no_cia
and a.centrod = b.centro
and a.no_fisico = b.no_fisico
and a.cant_prorrogas = b.cant_prorrogas
and a.serie_fisico = b.serie_fisico
and a.no_cia = c.no_cia
and a.no_cliente = c.no_cliente
and a.grupo = c.grupo
having sum(b.saldo) > 0
group by c.cedula,c.nombre,a.fecha,a.centrod,a.no_fisico,a.serie_fisico,a.cant_prorrogas, a.sub_total,a.impuesto]]>
	</queryString>
	<field name="CEDULA" class="java.lang.String"/>
	<field name="NOMBRE" class="java.lang.String"/>
	<field name="FECHA" class="java.sql.Timestamp"/>
	<field name="CENTROD" class="java.lang.String"/>
	<field name="NO_FISICO" class="java.lang.String"/>
	<field name="SERIE_FISICO" class="java.lang.String"/>
	<field name="CANT_PRORROGAS" class="java.math.BigDecimal"/>
	<field name="SUB_TOTAL" class="java.math.BigDecimal"/>
	<field name="IMPUESTO" class="java.math.BigDecimal"/>
	<field name="SUM(SALDO)" class="java.math.BigDecimal"/>
	<variable name="totalSubtotal" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{SUB_TOTAL}]]></variableExpression>
	</variable>
	<variable name="totalImpuesto" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{IMPUESTO}]]></variableExpression>
	</variable>
	<variable name="totalSaldo" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{SUM(SALDO)}]]></variableExpression>
	</variable>
