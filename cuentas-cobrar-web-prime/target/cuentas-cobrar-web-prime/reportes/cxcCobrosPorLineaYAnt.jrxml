	<subDataset name="diariosA" uuid="7cc0bac7-ef51-44c4-b2cd-1b4cd67d7a22">
		<parameter name="p_no_cia" class="java.lang.String"/>
		<parameter name="p_fecha_inicio" class="java.util.Date"/>
		<parameter name="p_fecha_fin" class="java.util.Date"/>
		<queryString>
			<![CDATA[select a.centro,(select nombre from agencias where no_cia=a.no_cia and codigo=a.centro) nom_agencia,
b.no_linea,d.descripcion,c.cedula,substr(c.nombre,1,30) nombre_cli, a.no_fisico||a.serie_fisico ingreso,b.monto_doc
from  arccmd a,arccan b,arccmc c,arcjli d,arccda e
where a.no_cia = $P{p_no_cia}
 and  trunc(a.fecha) >= trunc($P{p_fecha_inicio})
  and trunc(a.fecha)  <= trunc($P{p_fecha_fin})
and a.serie_fisico = 'A'
and nvl(a.anulado,'N') = 'N'
and a.no_cia = b.no_cia
and a.no_docu = b.no_docu
and aplica_como = 'AN'
and a.no_cia = c.no_cia
and a.grupo = c.grupo
and a.no_cliente = c.no_cliente
and nvl(relacion,'EX') <> 'ER'
and b.no_cia = d.no_cia
and b.no_linea = d.no_linea
and a.no_cia = e.no_cia
and a.no_docu = e.no_docu
and nvl(e.depositos_$,0) > 0
and nvl(e.aplica,'N') = 'S']]>
		</queryString>
		<field name="CENTRO" class="java.lang.String"/>
		<field name="NOM_AGENCIA" class="java.lang.String"/>
		<field name="NO_LINEA" class="java.lang.String"/>
		<field name="DESCRIPCION" class="java.lang.String"/>
		<field name="CEDULA" class="java.lang.String"/>
		<field name="NOMBRE_CLI" class="java.lang.String"/>
		<field name="INGRESO" class="java.lang.String"/>
		<field name="MONTO_DOC" class="java.math.BigDecimal"/>
		<variable name="total_valor" class="java.lang.Number" calculation="Sum">
			<variableExpression><![CDATA[$F{MONTO_DOC}]]></variableExpression>
		</variable>
	</subDataset>
	<parameter name="p_no_cia" class="java.lang.String"/>
	<parameter name="p_nombre_empresa" class="java.lang.String"/>
	<parameter name="p_usuario" class="java.lang.String"/>
	<parameter name="p_linea_negocio" class="java.lang.String"/>
	<parameter name="p_fecha_inicio" class="java.util.Date"/>
	<parameter name="p_fecha_fin" class="java.util.Date"/>
	<parameter name="p_imprime_cabecera" class="java.lang.Boolean">
		<defaultValueExpression><![CDATA[new Boolean(true)]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT d.centro,(select nombre from agencias where no_cia=a.no_cia and codigo=d.centro) nom_agencia,
d.no_fisico factura,d.serie_fisico linea,(select descripcion from arcjli where no_cia=a.no_cia and no_linea=d.serie_fisico) desc_linea,
d.cant_prorrogas,d.no_docu_refe,b.relacion,b.cedula,
substr(b.nombre,1,30) nombre_cli,e.no_fisico||e.serie_fisico INGRESO,a.monto_doc,
a.descuento,a.interes,a.total_pago,a.fecha,  d.fecha_vence
from arccrd a, arccmc b,arcctd c,arccmd d,arccmd e,arccda f
where a.no_cia = $P{p_no_cia}
   and  trunc(a.fecha) >= trunc($P{p_fecha_inicio})
  and trunc(a.fecha)  <= trunc($P{p_fecha_fin})
  and a.no_cia = b.no_cia
  and a.grupo = b.grupo
  and a.no_cliente = b.no_cliente
  and nvl(b.relacion,'EX') <> 'ER'
  and a.no_cia = d.no_cia
  and a.no_refe = d.no_docu
  and d.serie_fisico = nvl($P{p_linea_negocio},d.serie_fisico)
  and d.tipo_doc <> 'SE'
  and nvl(d.incobrable,' ') not in ('1','2')
  and a.tipo_doc not in ('DD','FD')
  and a.no_cia = e.no_cia
  and a.no_docu = e.no_docu
  and nvl(e.serie_fisico,' ') = 'A'
  and a.no_cia = c.no_cia
  and a.tipo_refe = c.tipo
  and c.tipo_mov = 'D'
 and a.no_cia = f.no_cia
and a.no_docu = f.no_docu
and nvl(f.depositos_$,0) > 0
and nvl(f.aplica,'N') = 'S'
order by INGRESO]]>
	</queryString>
	<field name="CENTRO" class="java.lang.String"/>
	<field name="NOM_AGENCIA" class="java.lang.String"/>
	<field name="FACTURA" class="java.lang.String"/>
	<field name="LINEA" class="java.lang.String"/>
	<field name="DESC_LINEA" class="java.lang.String"/>
	<field name="CANT_PRORROGAS" class="java.math.BigDecimal"/>
	<field name="NO_DOCU_REFE" class="java.lang.String"/>
	<field name="RELACION" class="java.lang.String"/>
	<field name="CEDULA" class="java.lang.String"/>
	<field name="NOMBRE_CLI" class="java.lang.String"/>
	<field name="INGRESO" class="java.lang.String"/>
	<field name="MONTO_DOC" class="java.math.BigDecimal"/>
	<field name="DESCUENTO" class="java.math.BigDecimal"/>
	<field name="INTERES" class="java.math.BigDecimal"/>
	<field name="TOTAL_PAGO" class="java.math.BigDecimal"/>
	<field name="FECHA" class="java.sql.Timestamp"/>
	<field name="FECHA_VENCE" class="java.sql.Timestamp"/>
	<variable name="total_valor" class="java.lang.Number" calculation="Sum">
		<variableExpression><![CDATA[$F{MONTO_DOC}]]></variableExpression>
	</variable>
	<variable name="total_descuento" class="java.lang.Number" calculation="Sum">
		<variableExpression><![CDATA[$F{DESCUENTO}]]></variableExpression>
	</variable>
	<variable name="total_interes" class="java.lang.Number" calculation="Sum">
		<variableExpression><![CDATA[$F{INTERES}]]></variableExpression>
	</variable>
	<variable name="total_abono" class="java.lang.Number" calculation="Sum">
		<variableExpression><![CDATA[$F{TOTAL_PAGO}]]></variableExpression>
	</variable>
