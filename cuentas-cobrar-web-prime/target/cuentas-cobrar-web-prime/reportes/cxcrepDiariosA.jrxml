	<subDataset name="c_pagos" uuid="ca512b47-3ab6-46a3-83da-14573b52c32e">
		<parameter name="noCia" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="noDocu" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="totalValor" class="java.math.BigDecimal">
			<defaultValueExpression><![CDATA[0]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select b.tipo_doc,b.centro,b.no_fisico,b.serie_fisico,b.cant_prorrogas
,b.no_docu_refe,b.fecha_vence,a.monto_doc,a.descuento,a.interes,a.total_pago,' usd'
, (case when a.descuento > 0 then (a.descuento*-1) else a.interes end) descuento_interes
from arccrd a,arccmd b
where a.no_cia = $P{noCia}
and  a.no_docu = $P{noDocu}
and a.no_cia = b.no_cia
and a.no_refe = b.no_docu]]>
		</queryString>
		<field name="TIPO_DOC" class="java.lang.String"/>
		<field name="CENTRO" class="java.lang.String"/>
		<field name="NO_FISICO" class="java.lang.String"/>
		<field name="SERIE_FISICO" class="java.lang.String"/>
		<field name="CANT_PRORROGAS" class="java.math.BigDecimal"/>
		<field name="NO_DOCU_REFE" class="java.lang.String"/>
		<field name="FECHA_VENCE" class="java.sql.Timestamp"/>
		<field name="MONTO_DOC" class="java.math.BigDecimal"/>
		<field name="DESCUENTO" class="java.math.BigDecimal"/>
		<field name="INTERES" class="java.math.BigDecimal"/>
		<field name="TOTAL_PAGO" class="java.math.BigDecimal"/>
		<field name="&apos;USD&apos;" class="java.lang.String"/>
		<field name="DESCUENTO_INTERES" class="java.math.BigDecimal"/>
	</subDataset>
	<subDataset name="c_ant" uuid="620b824a-8617-422c-821a-8dea4b0cb2a9">
		<parameter name="noCia" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="noDocu" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select ' AN' an, b.no_fisico numero_doc,b.serie_fisico linea,a.monto_doc monto, '   usd'
from arccan a,arccmd b
      where a.no_cia       = $P{noCia} and
            a.no_docu      = $P{noDocu} and
            a.aplica_como ='SA' and
            b.no_cia = a.no_cia and
            b.no_docu = a.no_refe and
            b.moneda = 'D']]>
		</queryString>
		<field name="AN" class="java.lang.String"/>
		<field name="NUMERO_DOC" class="java.lang.String"/>
		<field name="LINEA" class="java.lang.String"/>
		<field name="MONTO" class="java.math.BigDecimal"/>
		<field name="&apos;USD&apos;" class="java.lang.String"/>
	</subDataset>
	<subDataset name="c_rtd" uuid="684eeb0d-e0b8-431d-a62e-72114379f99f">
		<parameter name="noCia" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="noDocu" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select ' RT' rt, numero_doc, monto, '   '||'usd' moneda
      from arccmm
      where no_cia       = $P{noCia}  and
            no_docu      = $P{noDocu} and
            moneda       = 'D' and
            tipo_mov='R']]>
		</queryString>
		<field name="RT" class="java.lang.String"/>
		<field name="NUMERO_DOC" class="java.lang.String"/>
		<field name="MONTO" class="java.math.BigDecimal"/>
		<field name="MONEDA" class="java.lang.String"/>
	</subDataset>
	<subDataset name="c_me" uuid="6393d77e-9d21-4423-8ba2-a23f1b4646a6">
		<parameter name="noCia" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="noDocu" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select 'ME' me, memo_$ memo_usd, '   '||'usd' moneda
      from arccda
      where no_cia       =  $P{noCia} and
            no_docu      = $P{noDocu}]]>
		</queryString>
		<field name="ME" class="java.lang.String"/>
		<field name="MEMO_USD" class="java.math.BigDecimal"/>
		<field name="MONEDA" class="java.lang.String"/>
	</subDataset>
	<subDataset name="c_ded" uuid="83f6e9b5-ae98-4326-bfe7-4791bf4e5eb6">
		<parameter name="noCia" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="noDocu" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select ' DP' dp, numero_doc,BANCO,FECHA,CUENTA, monto, '   '||simbolo_moneda('D') moneda
      from arccmm
      where no_cia       = $P{noCia}  and
            no_docu      = $P{noDocu} and
            moneda       = 'D' and
            tipo_mov='E']]>
		</queryString>
		<field name="DP" class="java.lang.String"/>
		<field name="NUMERO_DOC" class="java.lang.String"/>
		<field name="BANCO" class="java.lang.String"/>
		<field name="FECHA" class="java.sql.Timestamp"/>
		<field name="CUENTA" class="java.lang.String"/>
		<field name="MONTO" class="java.math.BigDecimal"/>
		<field name="MONEDA" class="java.lang.String"/>
	</subDataset>
	<subDataset name="c_ced" uuid="4a02deba-441e-492d-9b7c-7941b770ac9a">
		<parameter name="noCia" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="noDocu" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select ' CE' ce, numero_doc, BANCO,FECHA,CUENTA,monto, '   '||simbolo_moneda('D') moneda
      from arccmm
      where no_cia       = $P{noCia}  and
            no_docu      = $P{noDocu} and
            moneda       = 'D' and
            tipo_mov='C']]>
		</queryString>
		<field name="CE" class="java.lang.String"/>
		<field name="NUMERO_DOC" class="java.lang.String"/>
		<field name="BANCO" class="java.lang.String"/>
		<field name="FECHA" class="java.sql.Timestamp"/>
		<field name="CUENTA" class="java.lang.String"/>
		<field name="MONTO" class="java.math.BigDecimal"/>
		<field name="MONEDA" class="java.lang.String"/>
	</subDataset>
	<subDataset name="g_centro2" uuid="b93c7f4e-8a37-4576-bbba-6103cdd76517">
		<parameter name="noCia" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="noDocu" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select (a.uniadmin_id) centro, a.ctacon_id cuenta_con,
          substr(b.nombre,1,30) nombre_cta,a.tipo,a.monto_dol
	, (case when a.tipo = 'C' then a.monto_dol else 0 end) credito
	, (case when a.tipo = 'C' then 0 else a.monto_dol end) debito
from arccdc_scb a,con_planctas b
          where a.no_cia = $P{noCia}
            and a.no_cia = b.empresa_id
            and a.ctacon_id = b.ctacon_id
            and a.no_docu = $P{noDocu}]]>
		</queryString>
		<field name="CENTRO" class="java.lang.String"/>
		<field name="CUENTA_CON" class="java.lang.String"/>
		<field name="NOMBRE_CTA" class="java.lang.String"/>
		<field name="TIPO" class="java.lang.String"/>
		<field name="MONTO_DOL" class="java.math.BigDecimal"/>
		<field name="CREDITO" class="java.math.BigDecimal"/>
		<field name="DEBITO" class="java.math.BigDecimal"/>
	</subDataset>
	<subDataset name="c_discon" uuid="e53a1fd6-f67a-4211-a0c0-8fca384cf052">
		<parameter name="noCia" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="noDocu" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select (a.cc_1||' '||a.cc_2||' '||a.cc_3) centro, (substr(a.codigo,1,3)||'-'||
          substr(a.codigo,4,3)||'-'||substr(a.codigo,7,3)||'-'||
          substr(a.codigo,10,3)||'-'||substr(a.codigo,13,3)) cuenta_con,
          substr(b.descri,1,30) nombre_cta,a.tipo,a.monto_dol
	, (case when a.tipo = 'C' then a.monto_dol else 0 end) credito
	, (case when a.tipo = 'C' then 0 else a.monto_dol end) debito
	from arccdc a,con_cuentas b
          where a.no_cia = $P{noCia}
            and a.no_cia = b.no_cia
            and a.codigo = b.cuenta
            and a.no_docu = $P{noDocu}]]>
		</queryString>
		<field name="CENTRO" class="java.lang.String"/>
		<field name="CUENTA_CON" class="java.lang.String"/>
		<field name="NOMBRE_CTA" class="java.lang.String"/>
		<field name="TIPO" class="java.lang.String"/>
		<field name="MONTO_DOL" class="java.math.BigDecimal"/>
		<field name="CREDITO" class="java.math.BigDecimal"/>
		<field name="DEBITO" class="java.math.BigDecimal"/>
	</subDataset>
	<parameter name="noCia" class="java.lang.String"/>
	<parameter name="noDocu" class="java.lang.String"/>
	<parameter name="totalInteres" class="java.math.BigDecimal">
		<defaultValueExpression><![CDATA[BigDecimal.ZERO]]></defaultValueExpression>
	</parameter>
	<parameter name="totalDescuento" class="java.math.BigDecimal">
		<defaultValueExpression><![CDATA[BigDecimal.ZERO]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select a.fecha,a.centro,b.cedula,substr(b.nombre,1,20) nombre,a.no_fisico||'-'||a.serie_fisico||decode(nvl(a.anulado,'N'),'N',null,'ANULADO') comprobante
  ,SUBSTR(a.comentar,1,120) comentario,
  c.m_original, nvl(a.valor_seguro,0) valor_seguro, nvl(c.moneda_id,'02') moneda, d.nombre nomagencia, c.fecha_digitacion, a.usuario
, nvl(retenciones_$,0) + nvl(depositos_$,0) +
         nvl(certificados_$,0) + nvl(memo_$,0) + nvl(anticipo_$,0) total_diario,
         nvl(anticipo,0) anticipo
  from arccda a,arccmc b,arccmd c, agencias d
  where a.no_cia = $P{noCia}
  and a.no_docu = $P{noDocu}
  and a.no_cia = b.no_cia
  and a.grupo  = b.grupo
  and a.no_cliente = b.no_cliente
  and a.no_cia = c.no_cia
  and a.no_docu = c.no_docu
  and a.no_cia = d.no_cia
  and a.centro = d.codigo]]>
	</queryString>
	<field name="FECHA" class="java.sql.Timestamp"/>
	<field name="CENTRO" class="java.lang.String"/>
	<field name="CEDULA" class="java.lang.String"/>
	<field name="NOMBRE" class="java.lang.String"/>
	<field name="COMPROBANTE" class="java.lang.String"/>
	<field name="COMENTARIO" class="java.lang.String"/>
	<field name="M_ORIGINAL" class="java.math.BigDecimal"/>
	<field name="VALOR_SEGURO" class="java.math.BigDecimal"/>
	<field name="MONEDA" class="java.lang.String"/>
	<field name="NOMAGENCIA" class="java.lang.String"/>
	<field name="FECHA_DIGITACION" class="java.sql.Timestamp"/>
	<field name="USUARIO" class="java.lang.String"/>
	<field name="TOTAL_DIARIO" class="java.math.BigDecimal"/>
	<field name="ANTICIPO" class="java.math.BigDecimal"/>
