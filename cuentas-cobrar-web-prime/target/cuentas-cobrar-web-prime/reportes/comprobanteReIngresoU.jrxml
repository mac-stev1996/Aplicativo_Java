	<parameter name="pCodigoIngreso" class="java.lang.String"/>
	<queryString>
		<![CDATA[Select I.Svinnotaus,I.Ingreso_Por,C.NOMBRE,C.Cedula,Reingreso_Fecha,I.Svincodi,I.Svmrcodi,I.Svindesc,I.Svinmotor,I.Svincoex,I.Svinafabr, I.Svinplaca, I.Svinkilo, I.Svinmatr, F.Svvenomb,
i.SVINCOSTDO,  nvl(i.svinpvpinicial,i.SVINPVPDO) SVINPVPDO  ,i.RV_CENTRO,a.REINGRESO_FECHA,

(Select Ar1.Nombre From Arccmc Ar1  Where Ar1.No_Cliente=A.No_Cliente_Anterio And A.No_Cia=Ar1.No_Cia) Nombresanterio
,(Select Ar1.cedula From Arccmc Ar1  Where Ar1.No_Cliente=A.NO_CLIENTE_ANTERIO AND A.NO_CIA=AR1.NO_CiA) CedulaAnterio,a.tipo_usado
FROM svfinven i,usd_vehicle_avaluo a  ,usd_vehicle v,arccmc c,svfvend f
where i.no_cia = v.no_cia
and  i.svincodi = v.chasis
and a.vehicle_code = v.code
and a.no_cia = c.no_cia
and a.no_cliente = c.no_cliente
and a.grupo = c.grupo
and a.no_cia = f.no_cia
And A.Svvecodi = F.Svvecodi
And A.NO_CLIENTE_ANTERIO Is Not Null
and A.GRUPO_ANTERIOR is not null
and i.no_cia = $P{pNoCia} and i.svincodi = $P{pChasis}]]>
	</queryString>
