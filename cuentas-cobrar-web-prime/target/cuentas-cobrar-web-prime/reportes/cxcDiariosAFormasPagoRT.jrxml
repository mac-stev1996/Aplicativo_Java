	<parameter name="P_NO_CIA" class="java.lang.String"/>
	<parameter name="P_NO_DOCU" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT ' RT' rt,
  numero_doc,
  NULL LINEA,
  monto,
  '   '
  ||'$' moneda
FROM arccmm
WHERE no_cia = $P{P_NO_CIA}
AND no_docu  = $P{P_NO_DOCU}
AND moneda   = 'D'
AND tipo_mov ='R']]>
	</queryString>
	<field name="RT" class="java.lang.String"/>
	<field name="NUMERO_DOC" class="java.lang.String"/>
	<field name="LINEA" class="java.lang.String"/>
	<field name="MONTO" class="java.math.BigDecimal"/>
