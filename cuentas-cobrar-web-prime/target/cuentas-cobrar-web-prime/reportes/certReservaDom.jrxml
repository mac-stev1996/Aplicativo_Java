				</textElement>
				<textFieldExpression><![CDATA[$F{ANIO_FABRI}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement uuid="a5357833-aadf-4065-975c-054ed70c334a" x="0" y="263" width="555" height="37"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial" size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["El vehículo detallado anteriormente, fue vendido segun factura. "+$F{FACTURA}+" correspondiente al "+$F{FECHA}+"; "+$F{OBSERVACION}+"."]]></textFieldExpression>
			</textField>
