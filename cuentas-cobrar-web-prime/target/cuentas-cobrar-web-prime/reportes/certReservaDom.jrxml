				<textElement>
					<font fontName="Arial" size="11"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{CHASIS}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement uuid="377c183f-bf37-4129-b957-36a0a1274935" x="114" y="206" width="60" height="20"/>
				<textElement>
					<font fontName="Arial" size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[COLOR]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement uuid="cb3ca2bc-211e-44e1-85a2-4b9efb9b05f9" x="174" y="206" width="237" height="20"/>
				<textElement>
					<font fontName="Arial" size="11"/>
				</textElement>
				<textFieldExpression><![CDATA[!"6".equals($P{p_serie_fisico})? $F{COLOR_MASTER}:$F{COLOR_SEMI}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement uuid="ed7ab602-e16d-4d06-8c2d-46e09c904e49" x="114" y="226" width="60" height="20"/>
