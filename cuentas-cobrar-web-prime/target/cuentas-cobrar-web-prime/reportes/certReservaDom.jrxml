<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="certReservaDom" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="ccb64bad-041f-41d6-92a0-a349a347f3eb">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="p_no_cia" class="java.lang.String"/>
	<parameter name="p_agencia" class="java.lang.String"/>
	<parameter name="p_no_fisico" class="java.lang.String"/>
	<parameter name="p_serie_fisico" class="java.lang.String"/>
	<parameter name="p_cant_prorrogas" class="java.lang.Integer"/>
	<parameter name="p_no_cliente" class="java.lang.String"/>
	<queryString>
		<![CDATA[select b.cedula, substr(b.nombre,1,50)  nombre,
           decode(b.gracia,1,'Señor',2,'Señora',3,'Señorita',4,'Señores',5,'Señores',null,'Señores') gracia,
           a.chasis,TO_CHAR(a.fecha, 'DD/MM/YYYY') fecha,a.centrod||'-'||a.no_fisico factura,
           c.svmrcodi marca,  c.svinafabr modelo, c.svinmotor motor, c.svinafabr anio_fabri,
           nvl((select  d.svcodescri from svfmascol d where d.no_cia = a.no_cia  and d.svmamaster = c.svmamaster
    	     and d.svcotipo = 'E'  and d.svcocodi = c.svincoex),'***') color_master,
           nvl((select  e.svcodescri from svfcolor e  where e.no_cia = c.no_cia and e.svcotipo = 'E' and  e.svcocodi=c.svincoex),'***') color_semi,
          p.texto1 reponsable, p.texto2 cargo,
          (select substr(observaciones2,1,150) from svfcoti where no_cia = a.no_cia and numero_cotizacion =a.no_pedido) observacion
from fac_ventas_cab a, arccmc b, svfinven c, param_det p
where a.no_cia = $P{p_no_cia}
and a.centrod = $P{p_agencia}
and a.no_fisico =$P{p_no_fisico}
and a.serie_fisico = $P{p_serie_fisico}
and a.cant_prorrogas = $P{p_cant_prorrogas}
and a.no_cliente=$P{p_no_cliente}
and a.no_cia = b.no_cia
and a.no_cliente = b.no_cliente
and a.no_cia=c.no_cia(+)
and a.chasis=c.svincodi(+)
and a.no_cia=p.no_cia(+)
and p.codigo(+) = 'FDCXC'
and p.codigo_det(+) = '01']]>
	</queryString>
	<field name="CEDULA" class="java.lang.String"/>
	<field name="NOMBRE" class="java.lang.String"/>
	<field name="GRACIA" class="java.lang.String"/>
	<field name="CHASIS" class="java.lang.String"/>
	<field name="FECHA" class="java.lang.String"/>
	<field name="FACTURA" class="java.lang.String"/>
	<field name="MARCA" class="java.lang.String"/>
	<field name="MODELO" class="java.math.BigDecimal"/>
	<field name="MOTOR" class="java.lang.String"/>
	<field name="ANIO_FABRI" class="java.math.BigDecimal"/>
	<field name="COLOR_MASTER" class="java.lang.String"/>
	<field name="COLOR_SEMI" class="java.lang.String"/>
	<field name="REPONSABLE" class="java.lang.String"/>
	<field name="CARGO" class="java.lang.String"/>
	<field name="OBSERVACION" class="java.lang.String"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band height="79" splitType="Stretch">
			<textField pattern="">
				<reportElement uuid="2eca62a6-5e8c-40f5-9337-f2c19763a174" x="0" y="38" width="40" height="20"/>
