					<font fontName="Arial" size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[A QUIEN INTERESE:]]></text>
			</staticText>
			<textField>
				<reportElement uuid="370f407c-6756-4ee5-bf13-cb8292f803a6" x="0" y="64" width="555" height="52"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial" size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["Por medio de la presente, certificamos que el "+$F{GRACIA}+" "+$F{NOMBRE}+" con Cédula de Identidad  No. "+$F{CEDULA}+" adquirio en nuestra compañia un vehículo de las siguientes características:"]]></textFieldExpression>
			</textField>
			<staticText>
