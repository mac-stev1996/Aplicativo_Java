				</textElement>
				<textFieldExpression><![CDATA[$F{MODELO}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement uuid="a32704e1-a354-4a54-bf10-50fa83d6a3a1" x="114" y="166" width="60" height="20"/>
				<textElement>
					<font fontName="Arial" size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[MOTOR:]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement uuid="bf229b1f-b1a5-45d5-9d70-5c5a30dfca42" x="174" y="166" width="237" height="20"/>
				<textElement>
