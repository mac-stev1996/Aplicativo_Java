<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="cxcAnticiposMensualesCB" pageWidth="1065" pageHeight="802" whenNoDataType="AllSectionsNoDetail" columnWidth="1065" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="8bef2b7f-2fa7-478d-9fab-f989d854dbd8">
	<property name="ireport.zoom" value="1.9487171000000048"/>
	<property name="ireport.x" value="1285"/>
	<property name="ireport.y" value="0"/>
	<parameter name="NOCIA" class="java.lang.String"/>
	<parameter name="NOMBREEMPRESA" class="java.lang.String"/>
	<parameter name="USUARIO" class="java.lang.String"/>
	<parameter name="IMPRIME_CABECERA" class="java.lang.Boolean"/>
	<parameter name="ANIO" class="java.lang.Integer"/>
	<parameter name="MES" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[select  distinct b.no_linea, e.descripcion nomlinea,c.cedula,c.nombre nombre,
a.no_fisico||a.serie_fisico no_fisico,a.fecha,b.monto_doc, nvl(b.monto_utilizado,0) monto_utilizado,
a.saldo,a.fecha_digitacion, nvl(d.moneda_id,'02') moneda_id
from cxc_saldos_mensuales a, cxc_arcjan_mensual b,cxc_clientes_mensuales c, arccmd d, arcjli e
where a.no_cia = $P{NOCIA}
and nvl(a.anulado,'N') = 'N'
and nvl(a.saldo,0) < 0
and a.anio_cierre = $P{ANIO}
and a.mes_cierre = $P{MES}
and a.no_cia = b.no_cia
and a.no_docu = b.no_docu
and a.anio_cierre = b.anio_cierre
and a.mes_cierre = b.mes_cierre
and b.aplica_como = 'AN'
and a.no_cia = c.no_cia
and a.grupo = c.grupo
and a.no_cliente = c.no_cliente
and c.ano_cierre = a.anio_cierre
and c.mes_cierre = a.mes_cierre
and a.no_cia = d.no_cia
and a.no_cliente = d.no_cliente
and a.no_docu = d.no_docu
and b.no_cia = e.no_cia
and b.no_linea = e.no_linea
union
select distinct b.no_linea, e.descripcion nomlinea,c.cedula,c.nombre nombre,
a.no_fisico||a.serie_fisico no_fisico,a.fecha,b.monto_doc, nvl(b.monto_utilizado,0) monto_utilizado,
a.saldo,a.fecha_digitacion, nvl(d.moneda_id,'02') moneda_id
from cxc_saldos_mensuales a, cxc_arccan_mensual b,cxc_clientes_mensuales c, arccmd d, arcjli e
where a.no_cia = $P{NOCIA}
and nvl(a.anulado,'N') = 'N'
and nvl(a.saldo,0) < 0
and a.no_cliente = nvl(null,a.no_cliente)
and a.anio_cierre = $P{ANIO}
and a.mes_cierre = $P{MES}
and a.no_cia = b.no_cia
and a.no_docu = b.no_docu
and a.anio_cierre = b.anio_cierre
and a.mes_cierre = b.mes_cierre
and b.aplica_como = 'AN'
and a.no_cia = c.no_cia
and a.grupo = c.grupo
and a.no_cliente = c.no_cliente
and c.ano_cierre = a.anio_cierre
and c.mes_cierre = a.mes_cierre
and a.no_cia = d.no_cia
and a.no_cliente = d.no_cliente
and a.no_docu = d.no_docu
and b.no_cia = e.no_cia
and b.no_linea = e.no_linea
order by nombre, no_fisico]]>
	</queryString>
