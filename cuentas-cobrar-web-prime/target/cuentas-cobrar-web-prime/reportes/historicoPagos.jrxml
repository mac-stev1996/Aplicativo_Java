	<subDataset name="histPagosCliente" uuid="9d71d53d-eca9-4250-af65-2c2b62a0ea1e">
		<parameter name="p_agencia" class="java.lang.String"/>
		<parameter name="p_no_fisico" class="java.lang.String"/>
		<parameter name="p_serie_fisico" class="java.lang.String"/>
		<parameter name="p_cant_prorrogas" class="java.lang.Integer"/>
		<parameter name="p_no_cliente" class="java.lang.Long"/>
		<parameter name="p_no_cia" class="java.lang.String"/>
		<queryString>
			<![CDATA[select  c.no_docu_refe,
                       c.fecha_vence,a.fecha fecha_cancelacion,(c.fecha_vence-a.fecha) dias,
                       a.centro agencia_nota_ingreso,nvl((select no_fisico from arcjca d
                                                       where d.no_cia = a.no_cia
                                                         and d.no_cliente = a.no_cliente
                                                         and trunc(d.fecha) = trunc(a.fecha)
                                                         and d.no_docu = a.no_docu
                                                       union
                                                       select e.no_fisico from arccda e
                                                        where e.no_cia = a.no_cia
                                                          and e.no_cliente = a.no_cliente
                                                          and trunc(e.fecha) = trunc(a.fecha)
                                                          and e.no_docu = a.no_docu),(select g.no_fisico from arccmd g
                                                                                       where g.no_cia = a.no_cia
                                                                                         and g.no_cliente = a.no_cliente
                                                                                         and trunc(g.fecha) = trunc(a.fecha)
                                                                                         and g.no_docu = a.no_docu)) nota_ingreso,
                       a.monto_doc valor,a.interes valor_interes,a.descuento valor_descuento,
                       a.total_pago valor_total,a.fecha fecha_proceso, c.comentario
                          from arccrd a,arccmd_all_view c
                         where c.no_cia =$P{p_no_cia}
                           and c.centro =$P{p_agencia}
                           and c.no_fisico = $P{p_no_fisico}
                           and c.no_cliente = $P{p_no_cliente}
                           and c.serie_fisico = $P{p_serie_fisico}
                           and c.cant_prorrogas = $P{p_cant_prorrogas}
                           and a.no_cia = c.no_cia
                           and a.no_refe = c.no_docu
                           and a.no_cliente = c.no_cliente
                        order by a.fecha,to_number(c.no_docu_refe)]]>
		</queryString>
		<field name="NO_DOCU_REFE" class="java.lang.String"/>
		<field name="FECHA_VENCE" class="java.sql.Timestamp"/>
		<field name="FECHA_CANCELACION" class="java.sql.Timestamp"/>
		<field name="DIAS" class="java.math.BigDecimal"/>
		<field name="AGENCIA_NOTA_INGRESO" class="java.lang.String"/>
		<field name="NOTA_INGRESO" class="java.lang.String"/>
		<field name="VALOR" class="java.math.BigDecimal"/>
		<field name="VALOR_INTERES" class="java.math.BigDecimal"/>
		<field name="VALOR_DESCUENTO" class="java.math.BigDecimal"/>
		<field name="VALOR_TOTAL" class="java.math.BigDecimal"/>
		<field name="FECHA_PROCESO" class="java.sql.Timestamp"/>
		<field name="COMENTARIO" class="java.lang.String"/>
		<variable name="tota_interes" class="java.lang.Number" calculation="Sum">
			<variableExpression><![CDATA[$F{VALOR_INTERES}]]></variableExpression>
		</variable>
		<variable name="total_descuento" class="java.lang.Number" calculation="Sum">
			<variableExpression><![CDATA[$F{VALOR_DESCUENTO}]]></variableExpression>
		</variable>
		<variable name="total" class="java.lang.Number" calculation="Sum">
			<variableExpression><![CDATA[$F{VALOR_TOTAL}]]></variableExpression>
		</variable>
	</subDataset>
	<subDataset name="ingresosCliente" uuid="97b5f443-34f4-4105-b5f2-d9cd5720fca7">
		<parameter name="p_no_fisico" class="java.lang.String"/>
		<parameter name="p_no_cliente" class="java.lang.Long"/>
		<parameter name="p_no_cia" class="java.lang.String"/>
		<parameter name="p_agencia" class="java.lang.String"/>
		<queryString>
			<![CDATA[Select 'CJ' origen, A.Centrod, D.Fecha, D.No_Fisico, e.monto_doc, c.monto_utilizado, (e.monto_doc - c.monto_utilizado) saldo
  From Fac_Ventas_Cab A, svfcoti b, svfant c, arcjca d, arcjan e
 Where A.No_Cia = $P{p_no_cia}
   And A.Centrod = $P{p_agencia}
   And A.No_Cliente = $P{p_no_cliente}
   And A.No_Fisico = $P{p_no_fisico}
   And A.Cant_Prorrogas = '1'
   And A.No_Cia = B.No_Cia
   And A.Centrod = B.Centro
   And A.No_Pedido = B.Numero_Cotizacion
   And B.No_Cia = c.No_Cia
   And B.Numero_Cotizacion = C.Numero_Cotizacion
   And C.No_Cia = D.No_Cia
   And C.Centro = D.Centro
   And C.No_Refe = D.No_Docu
   And D.No_Cia = E.No_Cia
   And D.No_Docu = E.No_Docu
   and e.aplica_como = 'AN'
   and nvl(c.monto_utilizado,0) <> 0
union all
Select 'DA'origen, A.Centrod, D.Fecha, D.No_Fisico, E.Monto_Doc, c.Monto_Utilizado, (E.Monto_Doc - c.Monto_Utilizado) Saldo
  From Fac_Ventas_Cab A, svfcoti b, svfant c, arccda d, arccan e
 Where A.No_Cia = $P{p_no_cia}
   And A.Centrod = $P{p_agencia}
   And A.No_Cliente = $P{p_no_cliente}
   And A.No_Fisico =$P{p_no_fisico}
   And A.Cant_Prorrogas = '1'
   And A.No_Cia = B.No_Cia
   And A.Centrod = B.Centro
   And A.No_Pedido = B.Numero_Cotizacion
   And B.No_Cia = c.No_Cia
   And B.Numero_Cotizacion = C.Numero_Cotizacion
   And C.No_Cia = D.No_Cia
   And C.Centro = D.Centro
   And C.No_docu = D.No_Docu
   And D.No_Cia = E.No_Cia
   And D.No_Docu = E.No_Docu
   and e.aplica_como = 'AN'
   and nvl(c.monto_utilizado,0) <> 0]]>
		</queryString>
		<field name="ORIGEN" class="java.lang.String"/>
		<field name="CENTROD" class="java.lang.String"/>
		<field name="FECHA" class="java.sql.Timestamp"/>
		<field name="NO_FISICO" class="java.lang.String"/>
		<field name="MONTO_DOC" class="java.math.BigDecimal"/>
		<field name="MONTO_UTILIZADO" class="java.math.BigDecimal"/>
		<field name="SALDO" class="java.math.BigDecimal"/>
		<variable name="total_monto_doc" class="java.lang.Number" calculation="Sum">
			<variableExpression><![CDATA[$F{MONTO_DOC}]]></variableExpression>
		</variable>
		<variable name="total_monto_utilizado" class="java.lang.Number" calculation="Sum">
			<variableExpression><![CDATA[$F{MONTO_UTILIZADO}]]></variableExpression>
		</variable>
		<variable name="total_saldo" class="java.lang.Number" calculation="Sum">
			<variableExpression><![CDATA[$F{SALDO}]]></variableExpression>
		</variable>
	</subDataset>
	<parameter name="p_no_cia" class="java.lang.String"/>
	<parameter name="p_nombre_empresa" class="java.lang.String"/>
	<parameter name="p_usuario" class="java.lang.String"/>
	<parameter name="p_agencia" class="java.lang.String"/>
	<parameter name="p_no_fisico" class="java.lang.String"/>
	<parameter name="p_serie_fisico" class="java.lang.String"/>
	<parameter name="p_cant_prorrogas" class="java.lang.Integer"/>
	<parameter name="p_no_cliente" class="java.lang.Long"/>
	<queryString>
		<![CDATA[select  b.cedula,substr(b.nombre,1,30) nombre
from arccmc b
where no_cia = $P{p_no_cia}
and grupo  = '01' and no_cliente = $P{p_no_cliente}]]>
	</queryString>
	<field name="CEDULA" class="java.lang.String"/>
	<field name="NOMBRE" class="java.lang.String"/>
