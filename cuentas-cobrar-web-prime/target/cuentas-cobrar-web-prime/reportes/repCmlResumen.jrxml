	<parameter name="p_no_cia" class="java.lang.String"/>
	<parameter name="p_periodo" class="java.lang.String"/>
	<parameter name="p_anio" class="java.lang.String"/>
	<queryString>
		<![CDATA[select (select b.codigo_uaf from arcgmc b where b.no_cia = $P{p_no_cia}) cod_registro,LPAD(periodo,2,'0') periodo_reporte,to_char(fecha,'yyyyMMdd') fecha_reporte,usuario cod_usuario,
tot_reg_clientes,tot_reg_operaciones,tot_reg_transacciones,total_operaciones,total_debitos,total_creditos,total_efectivo,
total_cheque,total_tc total_tarjeta_credito,tot_tvalores_bienes total_tvalores_bienes,tot_valor_total total_valor_total
from cml_resumen
where no_cia=$P{p_no_cia}
and periodo=$P{p_periodo}
and anio=$P{p_anio}]]>
	</queryString>
