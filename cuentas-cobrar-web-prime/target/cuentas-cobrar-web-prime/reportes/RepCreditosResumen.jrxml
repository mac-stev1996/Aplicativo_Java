			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="pFechaFin" class="java.util.Date">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select a.numero, b.nombre,a.agencia,
(select count(*) from cxc_credito c, svfcoti d where c.no_cia=$P{pNoCia} and c.concesionario=a.agencia
and trunc(c.fecha_enviada) >= trunc($P{pFechaInicio})
and trunc(c.fecha_enviada) <= trunc($P{pFechaFin}) and c.estado in ('A')
and c.numero_cotizacion =d.numero_cotizacion
and c.no_cia = d.no_cia
and d.svlicodi in(70,3)
) as aprobados
,
(select count(*) from cxc_credito c, svfcoti d where c.no_cia=$P{pNoCia} and c.concesionario=a.agencia
and trunc(c.fecha_enviada) >= trunc($P{pFechaInicio})
and trunc(c.fecha_enviada) <= trunc($P{pFechaFin}) and c.estado in ('N')
and c.numero_cotizacion =d.numero_cotizacion
and d.svlicodi in(70,3)
and c.no_cia = d.no_cia
) as negados,
(select count(*) from cxc_credito c, svfcoti d where c.no_cia=$P{pNoCia} and c.concesionario=a.agencia
and trunc(c.fecha_enviada) >= trunc($P{pFechaInicio})
and trunc(c.fecha_enviada) <= trunc($P{pFechaFin}) and c.estado in ('D')
and c.numero_cotizacion =d.numero_cotizacion
and c.no_cia = d.no_cia
and d.svlicodi in(70,3)
) as devueltos
from
(select distinct(a.concesionario) agencia, count(a.concesionario) numero
from cxc_credito a,  svfcoti c where a.no_cia= $P{pNoCia}
and trunc(a.fecha_enviada) >= trunc($P{pFechaInicio})
and trunc(a.fecha_enviada) <= trunc($P{pFechaFin})
and a.numero_cotizacion =c.numero_cotizacion
and a.no_cia = c.no_cia
and c.svlicodi in(70,3)
and a.estado in ('A','D','N')
group by a.concesionario
order by numero desc
)  a , agencias b
where b.No_cia=$P{pNoCia}
and a.agencia = b.codigo]]>
		</queryString>
		<field name="NUMERO" class="java.math.BigDecimal"/>
		<field name="NOMBRE" class="java.lang.String"/>
		<field name="AGENCIA" class="java.lang.String"/>
		<field name="APROBADOS" class="java.math.BigDecimal"/>
		<field name="NEGADOS" class="java.math.BigDecimal"/>
		<field name="DEVUELTOS" class="java.math.BigDecimal"/>
	</subDataset>
