	<subDataset name="DataAutosOk" uuid="4e8d0093-75de-4835-8fe9-dacd86ed8409">
		<parameter name="pNoCia" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="pFechaInicio" class="java.util.Date">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="pFechaFin" class="java.util.Date">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select orden, etiqueta, total, totalMinutos, totalSegundos,totalMinutosRA, totalSegundosRA,
round(total/(max(nullif(total,0)) over ())*100,2) || '%' as porcentaje
from (
select 1 orden, 'TOTAL CREDITOS CALIFICADOS' etiqueta, count (*) total,
(TRUNC(MOD((AVG(fin-inicio)) * (60 * 24), 60))) totalMinutos,  TRUNC(MOD((AVG(fin-inicio)) * (60 * 60 * 24), 60)) totalSegundos,
(TRUNC(MOD((AVG(finRA-inicioRA)) * (60 * 24), 60))) totalMinutosRA,  TRUNC(MOD((AVG(finRA-inicioRA)) * (60 * 60 * 24), 60)) totalSegundosRA
from (
select a.solicitud, nvl(a.fecha_finaliza_revision, (select max(fecha) from cxc_credito_estado e where e.no_cia =a.no_cia and e.solicitud = a.solicitud and e.estado='R')) fin,
a.fecha_inicia_revision inicio,
nvl(a.fecha_usuario_revision,(select max(e.fecha) from cxc_credito_estado e where e.no_cia=a.no_cia and e.solicitud = a.solicitud and e.estado='E' and a.revisa_comite is null)) iniciora,
nvl((select max(e.fecha) from cxc_credito_estado e where e.no_cia=a.no_cia and e.solicitud = a.solicitud and e.estado='A' and a.revisa_comite is null),
nvl((select max(e.fecha) from cxc_credito_estado e where e.no_cia=a.no_cia and e.solicitud = a.solicitud and e.estado='N' and a.revisa_comite is null),
nvl((select max(e.fecha) from cxc_credito_estado e where e.no_cia=a.no_cia and e.solicitud = a.solicitud and e.estado='D' and a.revisa_comite is null),
(select max(e.fecha) from cxc_credito_estado e where e.no_cia=a.no_cia and e.solicitud = a.solicitud and e.estado='R' and a.revisa_comite is null)))) finra
from cxc_credito a, svfcoti c where a.no_cia=  $P{pNoCia}
and trunc(a.FECHA_ENVIADA) >= trunc($P{pFechaInicio})
and trunc(a.FECHA_ENVIADA) <= trunc($P{pFechaFin})
and a.numero_cotizacion =c.numero_cotizacion
and a.no_cia = c.no_cia
and a.estado in ('A','N','D')
and c.svlicodi in('26')
)
UNION --aprobados
select 2 orden, 'TOTAL CREDITOS APROBADOS' etiqueta, count (*) total,
(TRUNC(MOD((AVG(fin-inicio)) * (60 * 24), 60))) totalMinutos,  TRUNC(MOD((AVG(fin-inicio)) * (60 * 60 * 24), 60)) totalSegundos,
(TRUNC(MOD((AVG(finRA-inicioRA)) * (60 * 24), 60))) totalMinutosRA,  TRUNC(MOD((AVG(finRA-inicioRA)) * (60 * 60 * 24), 60)) totalSegundosRA
from (select a.solicitud, nvl(a.fecha_finaliza_revision, (select max(fecha) from cxc_credito_estado e where  e.no_cia =a.no_cia and e.solicitud = a.solicitud and e.estado='A')) fin,
a.fecha_inicia_revision inicio,
nvl(a.fecha_usuario_revision,(select max(e.fecha) from cxc_credito_estado e where e.no_cia=a.no_cia and e.solicitud = a.solicitud and e.estado='E' and a.revisa_comite is null)) iniciora,
nvl((select max(e.fecha) from cxc_credito_estado e where e.no_cia=a.no_cia and e.solicitud = a.solicitud and e.estado='A' and a.revisa_comite is null),
(select max(e.fecha) from cxc_credito_estado e where e.no_cia=a.no_cia and e.solicitud = a.solicitud and e.estado='R' and a.revisa_comite is null)) finra

from cxc_credito a, svfcoti c where a.no_cia=  $P{pNoCia}
and trunc(a.FECHA_ENVIADA) >= trunc($P{pFechaInicio})
and trunc(a.FECHA_ENVIADA) <= trunc($P{pFechaFin})
and a.numero_cotizacion =c.numero_cotizacion
and a.no_cia = c.no_cia
and a.estado = 'A'
and c.svlicodi in('26')
)
UNION --negados
select 3 orden, 'TOTAL CREDITOS NEGADOS' etiqueta, count (*) total,
(TRUNC(MOD((AVG(fin-inicio)) * (60 * 24), 60))) totalMinutos,  TRUNC(MOD((AVG(fin-inicio)) * (60 * 60 * 24), 60)) totalSegundos,
(TRUNC(MOD((AVG(finRA-inicioRA)) * (60 * 24), 60))) totalMinutosRA,  TRUNC(MOD((AVG(finRA-inicioRA)) * (60 * 60 * 24), 60)) totalSegundosRA
from (select a.solicitud, nvl(a.fecha_finaliza_revision, (select max(fecha) from cxc_credito_estado e where  e.no_cia =a.no_cia and e.solicitud = a.solicitud and e.estado='N')) fin,
a.fecha_inicia_revision inicio,
nvl(a.fecha_usuario_revision,(select max(e.fecha) from cxc_credito_estado e where e.no_cia=a.no_cia and e.solicitud = a.solicitud and e.estado='E' and a.revisa_comite is null)) iniciora,
nvl((select max(e.fecha) from cxc_credito_estado e where e.no_cia=a.no_cia and e.solicitud = a.solicitud and e.estado='N' and a.revisa_comite is null),
(select max(e.fecha) from cxc_credito_estado e where e.no_cia=a.no_cia and e.solicitud = a.solicitud and e.estado='R' and a.revisa_comite is null)) finra
from cxc_credito a, svfcoti c where a.no_cia=  $P{pNoCia}
and trunc(a.FECHA_ENVIADA) >= trunc($P{pFechaInicio})
and trunc(a.FECHA_ENVIADA) <= trunc($P{pFechaFin})
and a.numero_cotizacion =c.numero_cotizacion
and a.no_cia = c.no_cia
and a.estado = 'N'
and c.svlicodi in('26')
)
UNION --devueltos
select 4 orden, 'TOTAL CREDITOS DEVUELTOS' etiqueta, count (*) total,
(TRUNC(MOD((AVG(fin-inicio)) * (60 * 24), 60))) totalMinutos,  TRUNC(MOD((AVG(fin-inicio)) * (60 * 60 * 24), 60)) totalSegundos,
(TRUNC(MOD((AVG(finRA-inicioRA)) * (60 * 24), 60))) totalMinutosRA,  TRUNC(MOD((AVG(finRA-inicioRA)) * (60 * 60 * 24), 60)) totalSegundosRA
from (select a.solicitud, nvl(a.fecha_finaliza_revision, (select max(fecha) from cxc_credito_estado e where  e.no_cia =a.no_cia and e.solicitud = a.solicitud and e.estado='D')) fin,
a.fecha_inicia_revision inicio,
nvl(a.fecha_usuario_revision,(select max(e.fecha) from cxc_credito_estado e where e.no_cia=a.no_cia and e.solicitud = a.solicitud and e.estado='E' and a.revisa_comite is null)) iniciora,
nvl((select max(e.fecha) from cxc_credito_estado e where e.no_cia=a.no_cia and e.solicitud = a.solicitud and e.estado='D' and a.revisa_comite is null),
(select max(e.fecha) from cxc_credito_estado e where e.no_cia=a.no_cia and e.solicitud = a.solicitud and e.estado='R' and a.revisa_comite is null)) finra
from cxc_credito a, svfcoti c where a.no_cia=  $P{pNoCia}
and trunc(a.FECHA_ENVIADA) >= trunc($P{pFechaInicio})
and trunc(a.FECHA_ENVIADA) <= trunc($P{pFechaFin})
and a.numero_cotizacion =c.numero_cotizacion
and a.no_cia = c.no_cia
and a.estado = 'D'
and c.svlicodi in('26'))
)x]]>
		</queryString>
		<field name="ORDEN" class="java.math.BigDecimal"/>
		<field name="ETIQUETA" class="java.lang.String"/>
		<field name="TOTAL" class="java.math.BigDecimal"/>
		<field name="TOTALMINUTOS" class="java.math.BigDecimal"/>
		<field name="TOTALSEGUNDOS" class="java.math.BigDecimal"/>
		<field name="TOTALMINUTOSRA" class="java.math.BigDecimal"/>
		<field name="TOTALSEGUNDOSRA" class="java.math.BigDecimal"/>
		<field name="PORCENTAJE" class="java.lang.String"/>
		<variable name="tiempoColaTotalCreditos" class="java.lang.String" calculation="Average">
			<variableExpression><![CDATA[$F{TOTALMINUTOSRA} +":"+ $F{TOTALSEGUNDOSRA}]]></variableExpression>
		</variable>
	</subDataset>
