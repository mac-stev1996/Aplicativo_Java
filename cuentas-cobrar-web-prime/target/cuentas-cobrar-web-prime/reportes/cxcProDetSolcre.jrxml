<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="cxcProDetSolcre" language="groovy" pageWidth="700" pageHeight="900" columnWidth="660" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="9bee3609-52ad-45b9-bf2a-024a6d26a3ed">
	<property name="ireport.zoom" value="0.9090909090909091"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="200"/>
	<parameter name="P_NO_CIA" class="java.lang.String"/>
	<parameter name="P_CENTRO" class="java.lang.String"/>
	<parameter name="P_NUMERO_COTIZACION" class="java.lang.String"/>
	<parameter name="P_NOMBRE_EMPRESA" class="java.lang.String"/>
	<parameter name="P_ES_IT" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
C.NUMERO_COTIZACION,c.CEDULA_DUENO,
C.CEDULA_GARANTE,
(SELECT NOMBRE FROM ARCCMC WHERE NO_CIA=C.NO_CIA AND CEDULA=C.CEDULA_GARANTE) NOMBRE_GARANTE,
C.CEDULA_DEUDOR,
(SELECT NOMBRE FROM ARCCMC WHERE NO_CIA=C.NO_CIA AND CEDULA=C.CEDULA_DEUDOR) NOMBRE_DEUDOR,
c.tipo_financiacion,(select entidad from ARCCTF where no_cia=C.NO_CIA and tipo=C.tipo_financiacion) tipo_financiacion_dESCRIPCION,
C.SUBTOTAL,C.TASA_FINANCIA,C.DESCUENTO,C.CUOTA_DE_ENTRADA,C.NETO,C.CUOTA_DE_ALCANCE,C.FECHA_DE_ALCANCE,
C.IVA,C.MONTO_ADICIONAL, C.OTROS_CARGOS, C.SALDO_FINANCIAR,
C.GASTOS_INCRIPCION, C.PLAZO_CREDITO, C.PAGOS_POR_ANO,C.PERIODO,
C.INTERESES, C.CUOTA_MENSUAL,
C.TOTAL_GENERAL, C.CUOTA_SEGURO,
C.NO_SOLICITUD_CRED,
DECODE(c.aprobado_credito,'S','APROBADA','N','NEGADA','B','DADA DE BAJA','NULO') ESTADO,
COMENTARIO_APROB,
c.comentario_aprobcxc COMENTARIO_APROB_IT
FROM SVFCOTI C WHERE
c.no_cia=$P{P_NO_CIA} and c.CENTRO=$P{P_CENTRO} and c.NUMERO_COTIZACION=$P{P_NUMERO_COTIZACION}]]>
	</queryString>
