	<queryString>
		<![CDATA[select a.fecha,
TO_CHAR(A.FECHA,'HH24:MM:SS')HORAS,
a.centro,b.cedula,b.nombre nombre,a.no_fisico||'-'||a.serie_fisico||decode(nvl(a.anulado,'N'),'N',null,'ANULADO') comprobante
  ,a.comentar,
  c.m_original,
UPPER(letras( c.m_original,'D'))valor_letras,
 nvl(a.valor_seguro,0), nvl(c.moneda_id,'02'), d.nombre nomagencia, c.fecha_digitacion, a.usuario,
 decode(nvl(a.anulado,'N'),'S','ANULADO','N',null)estado

  from arccda a,arccmc b,arccmd c, agencias d
  where a.no_cia = $P{P_NO_CIA}
  and a.no_docu = $P{P_NO_DOCU}
  and a.no_cia = b.no_cia
  and a.grupo  = b.grupo
  and a.no_cliente = b.no_cliente
  and a.no_cia = c.no_cia
  and a.no_docu = c.no_docu
  and a.no_cia = d.no_cia
  and a.centro = d.codigo]]>
	</queryString>
