	<queryString>
		<![CDATA[select tipo_identificacion,cedula,documento,tipooperacion,tipofinanciamiento,finandirecto,finanexterno,total,TO_CHAR(fecha,'yyyyMMdd') fecha,anio_fabricacion svinafabri,
tipo_vehiculo,modelo,marca,chasis,cilindraje,nivelblindaje,condicion_bien,placa,domicilio_provincia,domicilio_ciudad,domicilio_parroquia
from cml_operaciones
where no_cia=$P{p_no_cia}
and periodo=$P{p_periodo}
and anio=$P{p_anio}]]>
	</queryString>
