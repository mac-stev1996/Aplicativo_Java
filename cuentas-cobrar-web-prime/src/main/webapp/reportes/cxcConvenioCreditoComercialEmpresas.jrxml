				</box>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Arial" size="8"/>
				</textElement>
				<text><![CDATA[ Correo:]]></text>
			</staticText>
			<textField>
				<reportElement uuid="388a109c-b5dd-4445-bc2b-aedbad7d45eb" x="73" y="527" width="314" height="13"/>
				<box>
					<topPen lineWidth="0.25"/>
					<bottomPen lineWidth="0.25"/>
					<rightPen lineWidth="0.25"/>
				</box>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Arial" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{NOMBRES}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement uuid="966984cf-1559-4e0b-a255-b152fab6bded" x="73" y="539" width="314" height="13"/>
				<box>
