<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="cxcConvenioCreditoComercialEmpresas" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="9b2b76ce-203d-41fd-bd4e-4e6dc8a197df">
	<property name="ireport.zoom" value="1.9487171000000099"/>
	<property name="ireport.x" value="29"/>
	<property name="ireport.y" value="130"/>
	<parameter name="NO_SOLICITUD" class="java.lang.Long">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="NO_CIA" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="P_LOGO" class="java.lang.Object"/>
	<queryString>
		<![CDATA[select c.CEDULA, c.NOMBRES,c.EMAIL, c.DOMICILIO_CALLE, a.DESCRIP,
a.REP_LEG_NOMBRES ||' '||a. REP_LEG_APEP ||' '|| a. REP_LEG_APEM as GERENTE
from CXC_CREDITO_POSTVENTA c
left join NOM_COMPANIAS a on a.NO_CIA = c.NO_CIA
where c.NO_SOLICITUD = $P{NO_SOLICITUD}
AND c.NO_CIA = $P{NO_CIA}]]>
	</queryString>
	<field name="CEDULA" class="java.lang.String"/>
	<field name="NOMBRES" class="java.lang.String"/>
	<field name="EMAIL" class="java.lang.String"/>
	<field name="DOMICILIO_CALLE" class="java.lang.String"/>
	<field name="DESCRIP" class="java.lang.String"/>
	<field name="GERENTE" class="java.lang.String"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<detail>
		<band height="802" splitType="Stretch">
			<staticText>
				<reportElement uuid="186bf30a-400b-4bb1-8194-abd4374e5fe8" x="0" y="435" width="555" height="24"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Arial" size="8"/>
				</textElement>
				<text><![CDATA[SÉPTIMA.- Si cualquier estipulación o grupo de estipulaciones contenidas en este convenio se considerase inválida, nula o sin efecto por cualquier motivo, este hecho no afectará la validez de las restantes estipulaciones de este instrumento.]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="186bf30a-400b-4bb1-8194-abd4374e5fe8" x="0" y="458" width="555" height="33"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Arial" size="8"/>
				</textElement>
				<text><![CDATA[OCTAVA.- Las partes dejan expresa constancia de que en caso de mora en el cumplimiento de las obligaciones por parte de EL CLIENTE, se aplicará la tasa máxima de interés establecida por el Banco Central del Ecuador sin necesidad de requerimiento notarial o judicial de ninguna clase, siendo suficiente, el mero vencimiento del plazo convenido.]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="186bf30a-400b-4bb1-8194-abd4374e5fe8" x="0" y="490" width="555" height="22"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Arial" size="8"/>
				</textElement>
				<text><![CDATA[NOVENA.- NOTIFICACIONES Y CITACIONES. - Para efectos de recibir notificaciones, las partes fijan su domicilio en esta ciudad, en los lugares que se detallan a continuación:]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="186bf30a-400b-4bb1-8194-abd4374e5fe8" x="0" y="581" width="555" height="22"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Arial" size="8"/>
				</textElement>
				<text><![CDATA[De igual forma y aceptación de lo dispuesto en el Art. 55 numeral 2 del Código Orgánico General de Procesos, las partes fijan sus correos electrónicos para recibir citaciones y/o notificaciones.]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="186bf30a-400b-4bb1-8194-abd4374e5fe8" x="0" y="602" width="555" height="33"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Arial" size="8"/>
				</textElement>
				<text><![CDATA[DÉCIMA.- Las partes convienen en que toda controversia que no pueda ser resuelta amigablemente, se la someterá ante los jueces y tribunales del domicilio del demandado. Los comparecientes aceptan en contenido del presente convenio y lo suscriben en tres ejemplares de igual tenor y valor, en la fecha de suscripción de la solicitud de crédito aparejada a este instrumento.]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="d2ecd98a-6cf9-473a-91e9-9a1c5248b538" x="0" y="0" width="350" height="56"/>
				<textElement textAlignment="Center" verticalAlignment="Middle" markup="styled">
					<font fontName="Arial" size="12" isBold="true"/>
				</textElement>
				<text><![CDATA[CONVENIO DE CRÉDITO COMERCIAL]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="8c9e5b50-dfb8-43ad-b7d7-5f4c5d9b22f5" x="0" y="527" width="74" height="13"/>
				<box>
					<topPen lineWidth="0.25"/>
					<leftPen lineWidth="0.25"/>
					<bottomPen lineWidth="0.25"/>
				</box>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Arial" size="8"/>
				</textElement>
				<text><![CDATA[ 2.- EL CLIENTE:]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="fb769c60-1511-4c72-84d2-ced6faa799db" x="0" y="539" width="74" height="13"/>
				<box>
					<leftPen lineWidth="0.25"/>
				</box>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Arial" size="8"/>
				</textElement>
				<text><![CDATA[ Dirrección:]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="730965b2-4753-46fe-beef-900f1e6470e5" x="0" y="551" width="74" height="13"/>
				<box>
