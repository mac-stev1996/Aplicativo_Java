<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="cxcRefinanciamientoCuadre" language="groovy" pageWidth="1500" pageHeight="842" orientation="Landscape" columnWidth="1500" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="43328d24-9177-42ff-a4b4-0c85f1553580">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="p_no_cia" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="p_fecha_inicio" class="java.util.Date"/>
	<parameter name="p_fecha_fin" class="java.util.Date"/>
	<parameter name="p_nombre_empresa" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["CASABACA S.A."]]></defaultValueExpression>
	</parameter>
	<parameter name="p_usuario" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["SPATRICS"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_imprime_cabecera" class="java.lang.Boolean" isForPrompting="false">
		<defaultValueExpression><![CDATA[new Boolean (true)]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT a.centrod,e.nombre nomagencia, a.cedula, a.nbr_cliente, a.fecha, a.serie, a.no_fisico,a.serie_fisico, d.descripcion, a.cant_prorrogas,a.tot_lin, a.descuento,
a.impuesto,sum(nvl(b.intereses,0)) interes,a.total2, nvl(a.valor_ingresos,0) valor_ingresos,a.total, sum(nvl(b.m_original,0)) monto,
sum(b.saldo) saldoactual, max((select distinct f.descripcion from cxc_clase_cliente f where a.no_cia = f.no_cia and c.relacion = f.clase and Rownum = 1)) clase
from fac_ventas_cab a, arccmd b,arccmc c, arcjli d, agencias e
where a.no_cia = $P{p_no_cia}
   and TRUNC(A.fecha) >= trunc($P{p_fecha_inicio})
  and trunc(a.fecha)  <= trunc($P{p_fecha_fin})
  and a.no_cia = b.no_cia
  and a.centrod = b.centro
  and a.no_fisico = b.no_fisico
  and a.serie_fisico = b.serie_fisico
  and a.cant_prorrogas = b.cant_prorrogas
  and a.cant_prorrogas > '1'
 and  substr(a.no_fisico,1,4) <> '6000'
  and nvl(a.ind_anu_dev,' ') = ' '
  and nvl(a.saldo_factura,0) >= 0
  and c.no_cia = a.no_cia
  and c.grupo = a.grupo
  and c.no_cliente = a.no_cliente
  and c.relacion <> 'ER'
  and a.no_cia = d.no_cia
  and a.serie_fisico = d.no_linea
  and a.no_cia = e.no_cia
  and a.centrod = e.codigo
group by a.centrod,a.no_fisico,a.serie_fisico, d.descripcion,e.nombre, a.cedula, a.nbr_cliente,
a.cant_prorrogas,a.tot_lin,a.descuento,a.impuesto,a.total2,a.valor_ingresos,a.total,a.fecha, a.serie
order by 5]]>
	</queryString>
