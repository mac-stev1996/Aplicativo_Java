	<parameter name="NOCIA" class="java.lang.String"/>
	<parameter name="NOMBREEMPRESA" class="java.lang.String"/>
	<parameter name="USUARIO" class="java.lang.String"/>
	<parameter name="IMPRIME_CABECERA" class="java.lang.Boolean"/>
	<parameter name="CEDULA" class="java.lang.String"/>
	<queryString>
		<![CDATA[select
a.cedula,
a.nombre,
(select descripcion from CXC_CLASE_CLIENTE where no_cia = a.no_cia and negocio = 'REP' and clase =  a.clase_repuestos) canal,
a.limite_credi,
b.sobregiros,
a.centro agencia,
b.fecha_aprob_cred,
b.usuario_aprob
from  ARCCMC a, SRFCOTI b
where a.no_cia = $P{NOCIA}
and a.cedula = $P{CEDULA}
and b.no_cia = a.no_cia
and b.cedula_deudor = a.cedula]]>
	</queryString>
	<field name="CEDULA" class="java.lang.String"/>
