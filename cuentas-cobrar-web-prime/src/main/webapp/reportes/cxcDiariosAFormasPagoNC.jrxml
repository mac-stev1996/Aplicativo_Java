	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="P_NO_CIA" class="java.lang.String"/>
	<parameter name="P_NO_DOCU" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 'NC' dp,
  numero_doc,
  BANCO,
  FECHA,
  CUENTA,
  monto,
  '   '
  ||'$ ' moneda
FROM arccmm
WHERE no_cia = $P{P_NO_CIA}
AND no_docu  = $P{P_NO_DOCU}
AND moneda   = 'D'
AND tipo_mov in ('C')
AND tipo_retencion = 'NC']]>
	</queryString>
	<field name="DP" class="java.lang.String"/>
	<field name="NUMERO_DOC" class="java.lang.String"/>
