<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="cxcRepCobrosSegurosMensual" pageWidth="1610" pageHeight="842" columnWidth="1570" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="ac7576c1-2ec5-49c6-8c9f-0176468031ef">
	<property name="ireport.zoom" value="1.3310000000000004"/>
	<property name="ireport.x" value="1093"/>
	<property name="ireport.y" value="0"/>
	<parameter name="p_no_cia" class="java.lang.String"/>
	<parameter name="p_nombre_empresa" class="java.lang.String"/>
	<parameter name="p_fecha_inicio" class="java.util.Date"/>
	<parameter name="p_fecha_fin" class="java.util.Date"/>
	<parameter name="p_modulo" class="java.lang.String"/>
	<parameter name="p_imprime_cabecera" class="java.lang.Boolean"/>
	<queryString>
		<![CDATA[select   a.centro, ag. nombre agrencia,a.usuario usuuarioCaja, u.nombre nombreUsuario,to_char(a.fecha,'MM')mes
,rownum id, to_char(a.fecha,'DD/MM/RRRR')FECHA, a.no_fisico ci, d.cedula, d.nombre, c.no_fisico, c.no_docu_refe, b.total_pago monto, c.saldo montoCxc,
b.total_pago - c.saldo diferencia,e.cuenta_clientes_scb
from arcjca a, arccrd b, arccmd c, arccmc d, arcjli e, usuarios_sis u, agencias ag
where a.no_cia = $P{p_no_cia}
and trunc(a.fecha) >= $P{p_fecha_inicio}
and trunc(a.fecha) < $P{p_fecha_fin} + 1
and nvl(a.anulado,'N') = 'N'
and a.no_cia = b.no_cia
and a.no_docu = b.no_docu
and b.no_cia = c.no_cia
and b.no_refe = c.no_docu
and a.no_cia = d.no_cia
and a.no_cliente = d.no_cliente
and c.serie_fisico = (SELECT p.TEXTO1 FROM PARAM_DET p
WHERE NO_CIA = $P{p_no_cia}
AND CODIGO = 'SEGL'
AND CODIGO_DET = c.serie_fisico)
and c.no_cia = e.no_cia
and c.serie_fisico = e.no_linea
and a.usuario = u.usuario
and a.no_cia = ag.no_cia
and a.centro = ag.codigo]]>
	</queryString>
