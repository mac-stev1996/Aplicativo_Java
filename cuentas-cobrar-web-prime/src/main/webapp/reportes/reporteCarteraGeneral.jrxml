<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="reporteCarteraGeneral" pageWidth="6500" pageHeight="802" columnWidth="6500" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" isIgnorePagination="true" uuid="9b3eb703-052a-4e3e-a46c-04f99300b711">
	<property name="ireport.zoom" value="1.3310000000000057"/>
	<property name="ireport.x" value="7443"/>
	<property name="ireport.y" value="0"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Casbaca Prod Replica "/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="P_NOCIA" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="P_ANIO" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="P_MES" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select 	a.NO_CIA,
	a.ANO,
	a.MES,
	a.NO_DOCU,
	a.NOMEMPRESA,
	a.CEDULA,
	a.NO_CLIENTE,
	a.NOMBRECLI,
	a.TIPO_DOC,
	a.FECHA,
	a.FECHA_VENCE,
	a.CENTRO,
	a.NOMAGENCIA,
	a.NO_FISICO,
	a.LINEA_NEGOCIO,
	a.DESCLINEA_NEGOCIO,
	a.CANT_PRORROGAS,
	a.VALOR_ORIGINAL,
	a.VALOR_PAGO,
	a.SALDO,
	a.CAPITAL,
	a.INTERES,
	a.PORVENCER,
	a.VENCIDO,
	a.VALORTOTKF,
	a.SALDOSINCKF,
	a.PAGOCONNC,
	a.ESTADOCARTERA,
	a.DIASVENCE,
	a.RANGO_ANTIGUEDAD,
	a.LINEA_INTERNA,
	a.PLACA,
	a.NO_SINIESTRO,
	a.TIPOENTIDADFIN,
	a.DESC_FINANCIERA,
	a.VENDEDOR,
	a.DIAS_TEMPORALES,
	a.RELACION,
	a.TIPO_CLIENTE,
	a.COMENTARIO_APROBACION,
	a.ZONA,
	a.CANAL,
	a.PROVINCIA,
	a.CIUDAD,
	a.APLICA_RETENCION,
	a.TIENE_RETENCION,
	a.GIRO,
	a.CLIENTE_RELACIONADO,
	a.ANIOVENCE,
	a.LINEACARTERA,
	a.CARTERA,
	b.LINEA_NEGOCIO_REAL ,
	fc.refer ORDEN_REPARACION,
   	nvl((SELECT decode(nvl(c1.paga_cliente, 'N'), 'S', 'SI', 'NO') paga_cliente
          FROM
            svfcoti b1, veh_param_cuota_alcance c1
          WHERE
            b1.no_cia = a.no_cia
            AND b1.cedula_deudor = a.CEDULA
            AND b1.serie_fisico = a.linea_negocio
            AND b1.no_fisico = a.NO_FISICO
            AND c1.no_cia = b1.no_cia
            AND c1.tipo = b1.tipo_financiacion
            AND c1.estado = 'A'
            AND ROWNUM = 1),'-')  PAGA_CLIENTE,
    NVL(fc.man_prepagado,'N') man_prepagado
from cxc_cartera_general_mesano a
left join arccmd b on  a.no_cia = b.no_cia  AND a.no_docu = b.no_docu
left join fac_ventas_cab fc on fc.no_cia = a.no_cia and fc.no_fisico = a.no_fisico and fc.no_cliente = a.no_cliente and fc.tipo_doc = a.tipo_doc and fc.centrod = a.centro
      and trunc(fc.fecha) = trunc(a.fecha) and fc.serie_fisico = b.serie_fisico
      and fc.cant_prorrogas = b.cant_prorrogas
WHERE a.no_cia = $P{P_NOCIA}
and a.ano = $P{P_ANIO}
and a.mes = $P{P_MES}
order by 12,5]]>
	</queryString>
