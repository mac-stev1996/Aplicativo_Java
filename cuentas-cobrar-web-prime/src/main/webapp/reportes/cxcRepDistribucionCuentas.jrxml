<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="cxcRepDistribucionCuentas" pageWidth="1512" pageHeight="802" columnWidth="1512" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="ee1f736a-a296-4017-81a8-abb5f74c04a8">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="479"/>
	<property name="ireport.y" value="0"/>
	<parameter name="P_NO_CIA" class="java.lang.String"/>
	<parameter name="P_NOM_CIA" class="java.lang.String"/>
	<parameter name="P_CTA_DESDE" class="java.lang.String"/>
	<parameter name="P_CTA_HASTA" class="java.lang.String"/>
	<parameter name="P_CENTRO" class="java.lang.String"/>
	<parameter name="P_FECHA_DESDE" class="java.util.Date"/>
	<parameter name="P_FECHA_HASTA" class="java.util.Date"/>
	<queryString>
		<![CDATA[SELECT  a.no_fisico||'-'||a.serie_fisico comprobante, c.tipo_doc, c.centro||'-'||g.nombre centro,c.no_docu, c.ano, c.no_asiento,r.cedula, r.nombre,c.grupo,
              c.CTACON_ID codigo,c.tipo, monto_DOL, m.nombre  descri, decode(c.tipo,'D',monto_DOL) debito,
                        decode(c.tipo,'C',monto_DOL) credito, a.fecha
FROM    arcjca a,arcjdc_scb c, CON_PLANCTAS m, arccmc r, agencias g
WHERE a.no_cia = $P{P_NO_CIA}
      AND a.fecha  >= $P{P_FECHA_DESDE}
      AND a.fecha <= $P{P_FECHA_HASTA}
      and a.centro = nvl($P{P_CENTRO}, a.centro)
     and a.no_cia  	=  c.no_cia
      and  a.centro = c.centro
      and  a.no_docu = c.no_docu
  and c.CTACON_ID >= nvl($P{P_CTA_DESDE}, c.CTACON_ID)
      and  c.CTACON_ID <= nvl($P{P_CTA_HASTA}, c.CTACON_ID)
      AND c.no_cia  	=  m.EMPRESA_ID
      AND c.CTACON_ID   =  m.CTACON_ID
      AND c.no_cliente = r.no_cliente
      AND c.no_cia= r.no_cia
      AND c.centro = g.codigo
      AND c.no_cia = g.no_cia
ORDER BY  c.CTACON_ID,c.centro, a.fecha,a.no_docu,c.no_asiento]]>
	</queryString>
	<field name="COMPROBANTE" class="java.lang.String"/>
	<field name="TIPO_DOC" class="java.lang.String"/>
	<field name="CENTRO" class="java.lang.String"/>
