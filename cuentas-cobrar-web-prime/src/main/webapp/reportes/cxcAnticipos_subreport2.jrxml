<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="cxcAnticipos_subreport2" pageWidth="244" pageHeight="802" columnWidth="244" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" isFloatColumnFooter="true" uuid="552165c7-c91a-40f3-8723-eb20be7d4667">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PNO_CIA" class="java.lang.String"/>
	<parameter name="PREFER" class="java.lang.String"/>
	<queryString>
		<![CDATA[select a.no_cia,a.no_refe,a.monto_doc,b.no_fisico||'-'||b.serie_fisico vingreso,b.fecha from arccan a, arccmd b
where a.no_cia =$P{PNO_CIA}
and a.no_refe =  $P{PREFER}
and a.no_cia = b.no_cia
and a.no_docu = b.no_docu
and a.aplica_como ='SA'
and nvl(b.anulado,'N') = 'N']]>
	</queryString>
	<field name="NO_CIA" class="java.lang.String"/>
	<field name="NO_REFE" class="java.lang.String"/>
	<field name="MONTO_DOC" class="java.math.BigDecimal"/>
	<field name="VINGRESO" class="java.lang.String"/>
	<field name="FECHA" class="java.sql.Timestamp"/>
	<variable name="monto2" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{MONTO_DOC}]]></variableExpression>
	</variable>
