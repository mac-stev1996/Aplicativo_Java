	<property name="ireport.zoom" value="0.6050000000000001"/>
	<property name="ireport.x" value="127"/>
	<property name="ireport.y" value="0"/>
	<parameter name="p_no_cia" class="java.lang.String"/>
	<parameter name="p_fecha_inicio" class="java.util.Date"/>
	<parameter name="p_fecha_fin" class="java.util.Date"/>
	<parameter name="p_linea_negocio" class="java.lang.String"/>
	<parameter name="p_imprime_cabecera" class="java.lang.Boolean">
		<defaultValueExpression><![CDATA[new Boolean(true)]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select b.centro,c.nombre agencia, a.cedula, a.nombre,b.no_fisico,b.serie_fisico,d.descripcion,
b.cant_prorrogas,b.m_original, b.saldo
from arccmc a,arccmd b, agencias c, arcjli d
where b.no_cia =$P{p_no_cia}
and trunc(b.fecha) >=trunc($P{p_fecha_inicio})
and trunc(b.fecha) <= trunc($P{p_fecha_fin})
and b.serie_fisico = nvl($P{p_linea_negocio},b.serie_fisico)
and b.cant_prorrogas = '1'
and nvl(anulado,'N') = 'N'
and b.tipo_doc = 'ND'
and origen = 'CC'
and b.no_cia = a.no_cia
and b.grupo = a.grupo
and b.no_cliente = a.no_cliente
and b.no_cia = c.no_cia
and b.centro = c.codigo
and b.no_cia = d.no_cia
and b.serie_fisico = d.no_linea]]>
	</queryString>
