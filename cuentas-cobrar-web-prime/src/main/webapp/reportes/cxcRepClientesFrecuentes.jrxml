<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="serRepClientesFrecuentes" pageWidth="1350" pageHeight="802" columnWidth="1346" leftMargin="2" rightMargin="2" topMargin="0" bottomMargin="0" uuid="8bef2b7f-2fa7-478d-9fab-f989d854dbd8">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="508"/>
	<property name="ireport.y" value="0"/>
	<parameter name="NOCIA" class="java.lang.String"/>
	<parameter name="NOMBREEMPRESA" class="java.lang.String"/>
	<parameter name="USUARIO" class="java.lang.String"/>
	<parameter name="FECHADESDE" class="java.util.Date"/>
	<parameter name="FECHAHASTA" class="java.util.Date"/>
	<parameter name="IMPRIME_CABECERA" class="java.lang.Boolean"/>
	<queryString>
		<![CDATA[WITH CLIFREC AS (
SELECT A.FECHA,CA.FECHA FECHA_PAGO,B.CEDULA, B.NOMBRE,A.CENTROD, C.NOMBRE NOMBRE_AGENCIA,A.TOTAL,NO_FACTU,a.no_cliente,A.NO_FISICO,
CA.efectivo_$ EFECTIVO,CA.CHEQUES_$ CHEQUES,
CA.TARJETA_$ TARJETA,CA.RETENCIONES_$ RETENCIONES,CA.COMISIONES_$ COMISIONES,CA.DEPOSITOS_$ DEPOSITOS,
(SELECT MIN(PLACA_ID) FROM SE_ORDENREP O, SE_VEHICULOS VE
 WHERE O.NO_CIA = A.NO_CIA
   AND O.CODIGO = A.CENTROD
   AND O.FACTURA_NO = A.NO_FISICO
  AND O.NO_CLIENTE_FAC = A.NO_CLIENTE
  AND O.NO_CIA = VE.NO_CIA
  AND O.NUMCBS = VE.NUMCBS) AS PLACA
FROM FAC_VENTAS_CAB A, ARCCMC B, AGENCIAS C,
ARCCMD X, ARCCRD Z, ARCCMD Y, ARCJCA CA
WHERE A.NO_CIA =$P{NOCIA}
AND B.TIPO_CLIENTE='01'
and nvl(a.IND_ANU_DEV,'1')  NOT IN ('S','A')
AND A.FECHA>= $P{FECHADESDE}
AND A.FECHA < $P{FECHAHASTA}
AND A.TIPO_DOC = 'FA'
AND A.SERIE_FISICO IN ('30','90')
AND A.NO_CIA = B.NO_CIA
AND A.NO_CLIENTE = B.NO_CLIENTE
AND A.NO_CIA = C.NO_CIA
AND A.CENTROD = C.CODIGO
AND X.NO_CLIENTE = A.NO_CLIENTE
AND X.NO_FISICO = A.NO_FISICO
AND X.NO_CIA = A.NO_CIA
AND X.NO_CIA = Z.NO_CIA AND X.NO_DOCU = Z.NO_DOCU
AND X.NO_CIA = Y.NO_CIA AND Z.NO_REFE = Y.NO_DOCU
AND Y.NO_CIA = CA.NO_CIA
AND Y.NO_DOCU =CA.NO_DOCU
)
SELECT FECHA,FECHA_PAGO, CEDULA,NOMBRE,CENTROD,NOMBRE_AGENCIA,TOTAL,NO_FACTU,no_cliente,NO_FISICO,PLACA, SUM(EFECTIVO) EFECTIVO, SUM(CHEQUES) CHEQUES,SUM(TARJETA) TARJETA,SUM(RETENCIONES) RETENCIONES,SUM(COMISIONES) COMISIONES,SUM(DEPOSITOS) DEPOSITOS
FROM CLIFREC
GROUP BY FECHA,FECHA_PAGO, CEDULA,NOMBRE,CENTROD,NOMBRE_AGENCIA,TOTAL,NO_FACTU,no_cliente,NO_FISICO, PLACA
order by fecha]]>
	</queryString>
