<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="RepCreditosPostventaExpress" pageWidth="3800" pageHeight="900" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="3740" leftMargin="30" rightMargin="30" topMargin="10" bottomMargin="10" isIgnorePagination="true" uuid="441503f2-1753-4a76-85d2-c8fbb6c6f18b">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="0.7697371773460628"/>
	<property name="ireport.x" value="1918"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String"/>
	<parameter name="fechaFin" class="java.util.Date"/>
	<parameter name="fechaIni" class="java.util.Date"/>
	<parameter name="estado" class="java.lang.String"/>
	<parameter name="IMPRIME_CABECERA" class="java.lang.Boolean" isForPrompting="false">
		<defaultValueExpression><![CDATA[new Boolean(true)]]></defaultValueExpression>
	</parameter>
	<parameter name="agencia" class="java.lang.String"/>
	<parameter name="asesor" class="java.lang.String"/>
	<parameter name="noCia" class="java.lang.String"/>
	<parameter name="NombreCia" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT to_char(c.FECHA, 'DD-MON-YYYY') Fecha, to_char(c.FECHA, 'HH24:MI') HoraEnvio,
ag.NOMBRE as NOM_AGENCIA, c.USUARIO, u.NOMBRE AS NOM_USUARIO, c.NO_SOLICITUD, c.CEDULA, c.NOMBRES,  c.MONTO_DISPONIBLE, c.LIMITE_CREDI,
c.LIMITE_FACT, c.ESTADO, c.USUARIO_REVISA, c.FECHA_EST_REVISADO, c.OBSERVACION_EST_REVISADO,
abs(TRUNC(MOD((c.FECHA_EST_REVISADO - c.FECHA_EST_ENVIADO) * (60 * 24), 60))) tiempo,
DECODE(c.ESTADO, 'I', 'INGRESADO','E','ENVIADO','R','REVISADO','A','APROBADO','N','NEGADO', 'D','DEVUELTO','') Destado,
abs(TRUNC(MOD((c.FECHA_EST_REVISADO - c.FECHA_EST_ENVIADO) * (60 * 24), 60))) tiempoRev,
(select e.USUARIO_REVISA||' '||to_char(e.FECHA_EST_REVISADO, 'HH24:MI-DD-MON-YYYY') from CXC_CREDITO_POSTVENTA e where e.no_cia= c.no_cia and e.no_solicitud= c.no_solicitud and rownum<2) usuFechaRev,
(select e.USUARIO_APRUEBA||' '||to_char(e.FECHA_EST_APROBADO, 'HH24:MI-DD-MON-YYYY') from CXC_CREDITO_POSTVENTA e
where e.no_cia= c.no_cia and e.no_solicitud= c.no_solicitud and rownum<2) usuFechaApr,
abs(TRUNC(MOD((c.FECHA_EST_APROBADO - c.FECHA_EST_REVISADO) * (60 * 24), 60))) tiempoApr,
c.USUARIO_APRUEBA, c.FECHA_EST_APROBADO, c.OBSERVACION_EST_APROBADO, r.NOMBRE AS NOM_USUARIO_R, p.NOMBRE AS NOM_USUARIO_A
from CXC_CREDITO_POSTVENTA c
left join ARAFMC a on a.NO_CIA = c.NO_CIA
left join AGENCIAS ag on (ag.CODIGO = c.CENTRO AND ag.no_cia= $P{noCia})
left join USUARIOS_SIS u on u.USUARIO = c.USUARIO
left join USUARIOS_SIS r on r.USUARIO = c.USUARIO_REVISA
left join USUARIOS_SIS p on p.USUARIO = c.USUARIO_APRUEBA
WHERE c.NO_CIA = $P{noCia}
and trunc(c.FECHA) >= trunc($P{fechaIni})
and trunc(c.FECHA) <= trunc($P{fechaFin})
and c.USUARIO = nvl($P{asesor}, c.USUARIO)
and c.ESTADO = nvl($P{estado}, c.ESTADO)
and c.CENTRO = nvl($P{agencia}, c.CENTRO)]]>
	</queryString>
