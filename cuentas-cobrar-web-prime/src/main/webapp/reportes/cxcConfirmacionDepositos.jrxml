<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="cxcConfirmacionDepositos" pageWidth="2710" pageHeight="842" columnWidth="2670" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="6d433171-ea85-46e7-bc0d-83b49a5b2ace">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="VFECHAINI" class="java.util.Date"/>
	<parameter name="VFECHAFIN" class="java.util.Date"/>
	<parameter name="NO_CIA" class="java.lang.String"/>
	<parameter name="IMPRIME_CABECERA" class="java.lang.Boolean" isForPrompting="false">
		<defaultValueExpression><![CDATA[new Boolean (false)]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT 'CONFIRMADOS Y APLICADOS' TIPO, A.BANCO, A.NO_CTA, A.NO_FISICO DOCUMENTO,
       A.FECHA_DEPOSITO, A.NO_CLIENTE, B.CEDULA, B.NOMBRE, A.VALOR, A.USUARIO_SOLICITA,
       A.FECHA_SOLICITA, A.FECHA_CONFIRMA, A.USUARIO_CONFIRMA, A.USUARIO_UTILIZA, A.CENTRO_UTILIZA,
       A.INGRESO_CAJA, A.FECHA_CAJA, A.COMENTARIO, A.REFERENCIA_1, A.REFERENCIA_2
  FROM CHE_CONFIRMAR_DEPOSITO A, ARCCMC B
 WHERE A.FECHA_CONFIRMA >= $P{VFECHAINI}
   AND A.FECHA_CONFIRMA < $P{VFECHAFIN}+1
   AND A.NO_CIA =$P{NO_CIA}
   AND A.NO_CIA = B.NO_CIA(+)
   AND A.NO_CLIENTE = B.NO_CLIENTE(+)
   AND A.USUARIO_UTILIZA IS NOT NULL
UNION
SELECT 'CONFIRMADOS Y  NO APLICADOS' TIPO, A.BANCO, A.NO_CTA, A.NO_FISICO DOCUMENTO,
       A.FECHA_DEPOSITO, A.NO_CLIENTE, B.CEDULA, B.NOMBRE, A.VALOR, A.USUARIO_SOLICITA,
       A.FECHA_SOLICITA, A.FECHA_CONFIRMA, A.USUARIO_CONFIRMA, A.USUARIO_UTILIZA, A.CENTRO_UTILIZA,
       A.INGRESO_CAJA, A.FECHA_CAJA, A.COMENTARIO, A.REFERENCIA_1, A.REFERENCIA_2
  FROM CHE_CONFIRMAR_DEPOSITO A, ARCCMC B
 WHERE A.FECHA_CONFIRMA >= $P{VFECHAINI}
   AND A.FECHA_CONFIRMA < $P{VFECHAFIN}+1
   AND A.NO_CIA =$P{NO_CIA}
   AND A.NO_CIA = B.NO_CIA(+)
   AND A.NO_CLIENTE = B.NO_CLIENTE(+)
   AND A.USUARIO_CONFIRMA IS NOT NULL
   AND A.USUARIO_UTILIZA IS NULL
UNION
SELECT 'NO CONFIRMADOS' TIPO, A.BANCO, A.NO_CTA, A.NO_FISICO DOCUMENTO,
       A.FECHA_DEPOSITO, A.NO_CLIENTE, B.CEDULA, B.NOMBRE, A.VALOR, A.USUARIO_SOLICITA,
       A.FECHA_SOLICITA, A.FECHA_CONFIRMA, A.USUARIO_CONFIRMA, A.USUARIO_UTILIZA, A.CENTRO_UTILIZA,
       A.INGRESO_CAJA, A.FECHA_CAJA, A.COMENTARIO, A.REFERENCIA_1, A.REFERENCIA_2
  FROM CHE_CONFIRMAR_DEPOSITO A, ARCCMC B
 WHERE A.FECHA_DEPOSITO >= $P{VFECHAINI}
   AND A.FECHA_DEPOSITO < $P{VFECHAFIN}+1
   AND A.NO_CIA =$P{NO_CIA}
   AND A.NO_CIA = B.NO_CIA(+)
   AND A.NO_CLIENTE = B.NO_CLIENTE(+)
   AND A.USUARIO_CONFIRMA IS NULL
   AND A.USUARIO_UTILIZA IS NULL
ORDER BY 1 DESC,2,3,4]]>
	</queryString>
