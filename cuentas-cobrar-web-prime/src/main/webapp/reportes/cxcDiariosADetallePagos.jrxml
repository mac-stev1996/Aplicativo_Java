<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="cxcDiariosADetallePagos" pageWidth="559" pageHeight="782" columnWidth="559" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="ee1f736a-a296-4017-81a8-abb5f74c04a8">
	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="387"/>
	<property name="ireport.y" value="0"/>
	<parameter name="P_NO_CIA" class="java.lang.String"/>
	<parameter name="P_NO_DOCU" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT b.tipo_doc,
  b.centro,
  b.no_fisico,
  b.serie_fisico,
  b.cant_prorrogas,
  b.no_docu_refe,
  b.fecha_vence,
  a.monto_doc,
  a.descuento,
  a.interes,
  a.total_pago,
  ' $us' moneda
FROM arccrd a,
  arccmd b
WHERE a.no_cia = $P{P_NO_CIA}
AND a.no_docu  = $P{P_NO_DOCU}
AND a.no_cia   = b.no_cia
AND a.no_refe  = b.no_docu]]>
	</queryString>
	<field name="TIPO_DOC" class="java.lang.String"/>
	<field name="CENTRO" class="java.lang.String"/>
