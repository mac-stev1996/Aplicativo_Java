			</textField>
			<staticText>
				<reportElement uuid="345d5e44-e9ba-4583-b77b-5c5f642280aa" x="115" y="156" width="60" height="20"/>
				<textElement>
					<font fontName="Arial" size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[MODELO:]]></text>
			</staticText>
			<textField>
				<reportElement uuid="370f407c-6756-4ee5-bf13-cb8292f803a6" x="1" y="74" width="555" height="52"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial" size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["Por medio de la presente, certificamos que el "+$F{GRACIA}+" "+$F{NOMBRE}+" con Cédula de Identidad  No. "+$F{CEDULA}+" adquirio en nuestra compañia un vehículo de las siguientes características:"]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement uuid="cb3ca2bc-211e-44e1-85a2-4b9efb9b05f9" x="175" y="216" width="237" height="20"/>
				<textElement>
					<font fontName="Arial" size="11"/>
				</textElement>
				<textFieldExpression><![CDATA[!"6".equals($P{p_serie_fisico})? $F{COLOR_MASTER}:$F{COLOR_SEMI}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement uuid="a32704e1-a354-4a54-bf10-50fa83d6a3a1" x="115" y="176" width="60" height="20"/>
				<textElement>
					<font fontName="Arial" size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[MOTOR:]]></text>
			</staticText>
			<textField>
				<reportElement uuid="a5357833-aadf-4065-975c-054ed70c334a" x="1" y="273" width="555" height="88"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial" size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["El vehículo detallado anteriormente, fue vendido según factura."+$F{FACTURA}+" correspondiente al "+$F{FECHA}+"; mediante credito otorgado  por  "+$F{NOMBRE_COMPANIA}+" a "+$F{LETRAS}+" dividendo(s), el mismo que se encuentra cancelado en su totalidad segun comprobante de ingreso a Caja No."+($F{INGRESO1}!=null?$F{INGRESO1}:$F{INGRESO2})+($F{FECHA_INGRESO}!=null?" del "+$F{FECHA_INGRESO}:"")+"."]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement uuid="f8e9cd0c-5fbd-4b67-999a-b52bd1a6fa83" x="175" y="196" width="237" height="20"/>
				<textElement>
					<font fontName="Arial" size="11"/>
