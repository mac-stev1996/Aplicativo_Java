				<textFieldExpression><![CDATA[$F{NOMBRE}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement uuid="27d73dde-2819-4995-b73e-e3d7543fc487" x="180" y="40" width="370" height="20" forecolor="#000000"/>
