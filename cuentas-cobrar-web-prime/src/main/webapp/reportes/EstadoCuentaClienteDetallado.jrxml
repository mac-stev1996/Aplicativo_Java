			<staticText>
				<reportElement uuid="8b7f4f2a-b03b-4c50-b50d-aabd3c3c7b23" x="0" y="140" width="180" height="20" forecolor="#000000"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Arial" size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[DIRECCIÓN :]]></text>
			</staticText>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement uuid="27d73dde-2819-4995-b73e-e3d7543fc487" x="180" y="140" width="370" height="20" forecolor="#000000"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Arial" size="11" isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{DIRECCION}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement uuid="27d73dde-2819-4995-b73e-e3d7543fc487" x="180" y="160" width="370" height="20" forecolor="#000000"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Arial" size="11" isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{DOMICILIO_TELEFONO}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" pattern="#,##0.00;-#,##0.00" isBlankWhenNull="true">
