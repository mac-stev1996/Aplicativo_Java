<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="EstadoCuentaClienteDetallado" pageWidth="2100" pageHeight="555" orientation="Landscape" whenNoDataType="BlankPage" columnWidth="2100" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" isIgnorePagination="true" uuid="1d40d291-b6fb-46bc-8e67-a4fb48ce8c8c">
	<property name="ireport.zoom" value="1.6105100000000008"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="NO_CIA" class="java.lang.String"/>
	<parameter name="CIA" class="java.lang.String"/>
	<parameter name="SERIE_FISICO" class="java.lang.String"/>
	<parameter name="NO_CLIENTE" class="java.lang.String"/>
	<queryString>
		<![CDATA[select f.no_docu, f.canal_repuestos, f.clase_repuestos, f.no_cliente, f.nombre, f.nombre_comercial, f.domicilio_telefono,
f.direccion, f.centro, f.serie_fisico, f.tipo_doc, f.desctipo_docmento, f.serie, f.no_fisico, f.no_docu_refe, f.fecha, f.fecha_vence,
f.m_original, f.saldo, f.nockf, f.montockf, f.valorcuotackf, f.venceckf, f.saldomenosckf, f.valortotckf, f.cupo_asignado, f.limitefac, f.totalfc,
nvl(f.placa,
(select max(placa) from   factura_servicio_v h
where h.no_cia = $P{NO_CIA}
and h.no_factu = f.no_factu)) placa,
nvl(f.no_siniestro,(select max(siniestro)  from   factura_servicio_v h
where h.no_cia = $P{NO_CIA}
and h.no_factu = f.no_factu)) no_siniestro,
f.vencido30, f.vencido60, f.vencido90, f.vencidomas90, f.totalcartera, f.no_factu, (f.cupo_asignado - (    (SELECT SUM (nvl(t.saldo, 0)) monto_fac
           FROM arccmd t
          WHERE t.no_cia = $P{NO_CIA}
            AND t.tipo_doc <> 'SE'
            AND t.no_cliente = $P{NO_CLIENTE}
            AND t.tipo_doc <> 'PC'
            AND nvl (t.anulado, 'N') = 'N'))) cupo_disponible,  (f.cupo_asignado) cupo_asignado, (nvl(f.saldo,0)-nvl(f.valortotckf,0)) saldoreal, f.cedula , vendedor,interes from (
select a.no_docu, g.descripcion canal_repuestos, h.descripcion clase_repuestos, a.no_cliente, b.nombre, b.nombre_comercial, b.domicilio_telefono, b.direccion,
a.centro, a.serie_fisico, a.tipo_doc, c.descripcion desctipo_docmento,
(select g.serie
   from fac_ventas_cab g
  where a.no_cia = g.no_cia
    and a.centro = g.centrod
    and a.tipo_doc = g.tipo_doc
    and a.no_cliente = g.no_cliente
    and a.serie_fisico = g.serie_fisico
    and a.cant_prorrogas = g.cant_prorrogas
    and a.no_fisico = g.no_fisico
    and trunc(a.fecha) = trunc(g.fecha)) serie, a.no_fisico, a.no_docu_refe,
a.fecha, a.fecha_vence, a.m_original, a.saldo, nvl((select max(e.cheque)
   from arccckf_fac d, arccckf e
  where d.no_cia = a.no_cia
    and d.no_refe = a.no_docu
    and d.no_cia = e.no_cia
    and d.centro = e.centro
    and d.no_docu = e.no_docu
    and e.estado = 'P'),0) nockf, nvl((select avg(e.monto)
   from arccckf_fac d, arccckf e
  where d.no_cia = a.no_cia
    and d.no_refe = a.no_docu
    and d.no_cia = e.no_cia
    and d.centro = e.centro
    and d.no_docu = e.no_docu
    and e.estado = 'P'),0) montockf,
decode(nvl((select avg(e.monto)
   from arccckf_fac d, arccckf e
  where d.no_cia = a.no_cia
    and d.no_refe = a.no_docu
    and d.no_cia = e.no_cia
    and d.centro = e.centro
    and d.no_docu = e.no_docu
    and e.estado = 'P'),0),null,0,nvl((select sum(d.monto)
   from arccckf_fac d, arccckf e
  where d.no_cia = a.no_cia
    and d.no_refe = a.no_docu
    and d.no_cia = e.no_cia
    and d.centro = e.centro
    and d.no_docu = e.no_docu
    and e.estado = 'P'),0)) valorcuotaCkf, (select max(e.fecha_vence)
   from arccckf_fac d, arccckf e
  where d.no_cia = a.no_cia
    and d.no_refe = a.no_docu
    and d.no_cia = e.no_cia
    and d.centro = e.centro
    and d.no_docu = e.no_docu
    and e.estado = 'P') venceckf, (nvl(a.saldo,0) - nvl((select sum(d.monto)
   from arccckf_fac d, arccckf e
  where d.no_cia = a.no_cia
    and d.no_refe = a.no_docu
    and d.no_cia = e.no_cia
    and d.centro = e.centro
    and d.no_docu = e.no_docu
    and e.estado = 'P'),0)) saldomenosckf,
nvl((select sum(d.monto)
   from arccckf_fac d, arccckf e
  where d.no_cia = a.no_cia
    and d.no_refe = a.no_docu
    and d.no_cia = e.no_cia
    and d.centro = e.centro
    and d.no_docu = e.no_docu
    and e.estado = 'P'),0) valortotCkf
, nvl (limite_credi, 0) CUPO_ASIGNADO, nvl (b.limite_fact, 0) limitefac,
(select max(j.total)
   from fac_ventas_cab j
  where j.no_cia = a.no_cia
    and j.centrod = a.centro
    and j.tipo_doc = a.tipo_doc
    and j.no_fisico = a.no_fisico
    and j.serie_fisico = a.serie_fisico
    and j.cant_prorrogas = a.cant_prorrogas
    and j.no_cliente = a.no_cliente
    and trunc(j.fecha) = trunc(a.fecha)) totalfc,
(select max(h.placa)
   from fac_ventas_cab j, proformas_cab h
  where j.no_cia = a.no_cia
    and j.centrod = a.centro
    and j.tipo_doc = a.tipo_doc
    and j.no_fisico = a.no_fisico
    and j.serie_fisico = a.serie_fisico
    and j.cant_prorrogas = a.cant_prorrogas
    and j.no_cliente = a.no_cliente
    and trunc(j.fecha) = trunc(a.fecha)
    and h.no_cia = j.no_cia
    and h.centrod = j.centrod
    and h.no_fisico = j.no_profor) placa,
(select j.no_siniestro
   from fac_ventas_cab j
  where j.no_cia = a.no_cia
    and j.centrod = a.centro
    and j.tipo_doc = a.tipo_doc
    and j.no_fisico = a.no_fisico
    and j.serie_fisico = a.serie_fisico
    and j.cant_prorrogas = a.cant_prorrogas
    and j.no_cliente = a.no_cliente
    and trunc(j.fecha) = trunc(a.fecha)) no_siniestro,
    nvl((select sum(saldo) valor
      from arccmd_all_view
     where no_cia = $P{NO_CIA}
       and no_cliente = $P{NO_CLIENTE}
        and nvl(a.serie_fisico,'X') = nvl($P{SERIE_FISICO},nvl(a.serie_fisico   ,'X'))
       and saldo > 0
       and nvl(anulado,'N') = 'N'
       and trunc(fecha_vence) between trunc(sysdate-30) and trunc(sysdate)),0) vencido30,
    nvl((select sum(saldo) valor
      from arccmd_all_view
     where no_cia = $P{NO_CIA}
       and no_cliente = $P{NO_CLIENTE}
        and nvl(a.serie_fisico,'X') = nvl($P{SERIE_FISICO},nvl(a.serie_fisico   ,'X'))
       and saldo > 0
       and nvl(anulado,'N') = 'N'
       and trunc(fecha_vence) between trunc(sysdate-60) and trunc(sysdate-31)),0) vencido60,
    nvl((select sum(saldo) valor
      from arccmd_all_view
     where no_cia = $P{NO_CIA}
       and no_cliente = $P{NO_CLIENTE}
        and nvl(a.serie_fisico,'X') = nvl($P{SERIE_FISICO},nvl(a.serie_fisico   ,'X'))
       and saldo > 0
       and nvl(anulado,'N') = 'N'
       and trunc(fecha_vence) between trunc(sysdate-90) and trunc(sysdate-61)),0) vencido90,
    nvl((select sum(saldo) valor
      from arccmd_all_view
     where no_cia = $P{NO_CIA}
       and no_cliente = $P{NO_CLIENTE}
        and nvl(a.serie_fisico,'X') = nvl($P{SERIE_FISICO},nvl(a.serie_fisico   ,'X'))
       and saldo > 0
       and nvl(anulado,'N') = 'N'
       and trunc(fecha_vence) < trunc(sysdate-91)),0) vencidomas90,
    nvl((select nvl(sum(saldo),0) valor
      from arccmd_all_view
     where no_cia = $P{NO_CIA}
       and no_cliente = $P{NO_CLIENTE}
       and nvl(a.serie_fisico,'X') = nvl($P{SERIE_FISICO},nvl(a.serie_fisico   ,'X'))
       and saldo > 0
       and nvl(anulado,'N') = 'N'
       and trunc(fecha_vence) <= trunc(sysdate)),0) totalcartera,
(select max(j.no_factu)
   from fac_ventas_cab j
  where j.no_cia = a.no_cia
    and j.centrod = a.centro
    and j.tipo_doc = a.tipo_doc
    and j.no_fisico = a.no_fisico
    and j.serie_fisico = a.serie_fisico
    and j.cant_prorrogas = a.cant_prorrogas
    and j.no_cliente = a.no_cliente
    and trunc(j.fecha) = trunc(a.fecha)) no_factu, b.cedula,
(select (select i.nombre from inv_vendedores i where i.no_cia =g.no_cia and i.codigo = g.no_vendedor)
   from fac_ventas_cab g
  where a.no_cia = g.no_cia
    and a.centro = g.centrod
    and a.tipo_doc = g.tipo_doc
    and a.no_cliente = g.no_cliente
    and a.serie_fisico = g.serie_fisico
    and a.cant_prorrogas = g.cant_prorrogas
    and a.no_fisico = g.no_fisico
    and trunc(a.fecha) = trunc(g.fecha)) vendedor,
    nvl((select obtenerDescInteres($P{NO_CIA}, a.No_docu)from dual),0) interes
  from arccmd a, arccmc b, arcctd c, param_det g, cxc_clase_cliente h
 where a.no_cia = $P{NO_CIA}
   and nvl(a.serie_fisico   ,'X') = nvl($P{SERIE_FISICO}               ,nvl(a.serie_fisico   ,'X'))
   and nvl(a.anulado,'N') = 'N'
   and a.saldo <> 0
   and a.no_cia = b.no_cia
   and a.no_cliente = b.no_cliente
   and a.no_cia = c.no_cia
   and a.tipo_doc = c.tipo
   and a.no_cliente = $P{NO_CLIENTE}
   and b.no_cia = g.no_cia
   and upper(g.codigo) = 'CANALR'
   and g.codigo_det = b.canal_repuestos
   and b.no_cia = h.no_cia
   and h.negocio = 'REP'
   and b.clase_repuestos = h.clase
   order by a.no_cliente, a.no_fisico, a.no_docu_refe) f
order by 17]]>
	</queryString>
	<field name="NO_DOCU" class="java.lang.String"/>
	<field name="CANAL_REPUESTOS" class="java.lang.String"/>
	<field name="CLASE_REPUESTOS" class="java.lang.String"/>
	<field name="NO_CLIENTE" class="java.math.BigDecimal"/>
	<field name="NOMBRE" class="java.lang.String"/>
	<field name="NOMBRE_COMERCIAL" class="java.lang.String"/>
	<field name="DOMICILIO_TELEFONO" class="java.lang.String"/>
	<field name="DIRECCION" class="java.lang.String"/>
	<field name="CENTRO" class="java.lang.String"/>
	<field name="SERIE_FISICO" class="java.lang.String"/>
	<field name="TIPO_DOC" class="java.lang.String"/>
	<field name="DESCTIPO_DOCMENTO" class="java.lang.String"/>
	<field name="SERIE" class="java.lang.String"/>
	<field name="NO_FISICO" class="java.lang.String"/>
	<field name="NO_DOCU_REFE" class="java.lang.String"/>
	<field name="FECHA" class="java.sql.Timestamp"/>
	<field name="FECHA_VENCE" class="java.sql.Timestamp"/>
	<field name="M_ORIGINAL" class="java.math.BigDecimal"/>
	<field name="SALDO" class="java.math.BigDecimal"/>
	<field name="NOCKF" class="java.lang.String"/>
	<field name="MONTOCKF" class="java.math.BigDecimal"/>
	<field name="VALORCUOTACKF" class="java.math.BigDecimal"/>
	<field name="VENCECKF" class="java.sql.Timestamp"/>
	<field name="SALDOMENOSCKF" class="java.math.BigDecimal"/>
	<field name="VALORTOTCKF" class="java.math.BigDecimal"/>
	<field name="CUPO_ASIGNADO" class="java.math.BigDecimal"/>
	<field name="LIMITEFAC" class="java.math.BigDecimal"/>
	<field name="TOTALFC" class="java.math.BigDecimal"/>
	<field name="PLACA" class="java.lang.String"/>
	<field name="NO_SINIESTRO" class="java.lang.String"/>
	<field name="VENCIDO30" class="java.math.BigDecimal"/>
	<field name="VENCIDO60" class="java.math.BigDecimal"/>
	<field name="VENCIDO90" class="java.math.BigDecimal"/>
	<field name="VENCIDOMAS90" class="java.math.BigDecimal"/>
	<field name="TOTALCARTERA" class="java.math.BigDecimal"/>
	<field name="NO_FACTU" class="java.lang.String"/>
	<field name="CUPO_DISPONIBLE" class="java.math.BigDecimal"/>
	<field name="SALDOREAL" class="java.math.BigDecimal"/>
	<field name="CEDULA" class="java.lang.String"/>
	<field name="VENDEDOR" class="java.lang.String"/>
	<field name="INTERES" class="java.math.BigDecimal"/>
	<variable name="total_saldo" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{SALDO}]]></variableExpression>
	</variable>
	<variable name="total_monto" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{M_ORIGINAL}]]></variableExpression>
	</variable>
	<variable name="total_monto_ckf" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{MONTOCKF}]]></variableExpression>
	</variable>
	<variable name="total_valor_pago" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{VALORCUOTACKF}]]></variableExpression>
	</variable>
	<variable name="total_saldo_menos" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{SALDOREAL}]]></variableExpression>
	</variable>
	<variable name="total_Interes" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{INTERES}]]></variableExpression>
	</variable>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band height="200" splitType="Stretch">
			<staticText>
				<reportElement uuid="8b7f4f2a-b03b-4c50-b50d-aabd3c3c7b23" x="0" y="40" width="180" height="20" forecolor="#000000"/>
