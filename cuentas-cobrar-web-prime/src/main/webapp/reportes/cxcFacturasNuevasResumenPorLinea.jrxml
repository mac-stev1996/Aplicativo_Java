<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="cxcFacturasNuevasResumenPorLinea" language="groovy" pageWidth="940" pageHeight="842" columnWidth="900" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="3de12715-616d-4f40-9062-750d645b4909">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="p_no_cia" class="java.lang.String"/>
	<parameter name="p_nombre_empresa" class="java.lang.String"/>
	<parameter name="p_usuario" class="java.lang.String"/>
	<parameter name="p_lineas_negocio" class="java.util.List"/>
	<parameter name="p_clase_cliente" class="java.lang.String"/>
	<parameter name="p_fecha_inicio" class="java.util.Date"/>
	<parameter name="p_fecha_fin" class="java.util.Date"/>
	<parameter name="p_imprime_cabecera" class="java.lang.Boolean">
		<defaultValueExpression><![CDATA[new Boolean(true)]]></defaultValueExpression>
	</parameter>
	<parameter name="p_sql_emp_relacionadas" class="java.lang.String"/>
	<queryString>
		<![CDATA[select a.serie_fisico,d.descripcion,
sum(nvl(tot_lin,0)) valor, decode(a.serie_fisico,'9',sum(nvl(a.total1,0)),sum(nvl(a.tot_lin1,0))) val_seguro,
sum(nvl(descuento,0)) descuento,sum(nvl(impuesto,0))iva,decode(a.serie_fisico,'9',sum(nvl(a.total2,0)),sum(nvl(a.total1,0))) interes,
decode(a.serie_fisico,'9',0,sum(nvl(a.total2,0))) otros_cargos,sum(nvl(valor_ingresos,0)) ingresos,
sum(nvl(total,0))total_general,sum(nvl(saldo_factura,0)) saldo
from fac_ventas_cab a,arccmc c , arcjli d
where a.no_cia = $P{p_no_cia}
and trunc(a.fecha) >= trunc($P{p_fecha_inicio})
and trunc(a.fecha)  <= trunc($P{p_fecha_fin})
and  a.tipo_doc <> 'SE'
and  $X{IN,a.serie_fisico,p_lineas_negocio}
and nvl(a.cant_prorrogas,'1') = '1'
and a.no_cia = c.no_cia
and a.grupo = c.grupo
and a.no_cliente = c.no_cliente
and nvl(c.relacion,'EX') = nvl($P{p_clase_cliente},nvl(c.relacion,'EX'))
$P!{p_sql_emp_relacionadas}
and nvl(ind_anu_dev,' ') = ' '
and a.no_cia = d.no_cia
and a.serie_fisico = d.no_linea
group by a.serie_fisico,d.descripcion]]>
	</queryString>
