<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="cxcRepSeguimientoCartera" pageWidth="3100" pageHeight="802" columnWidth="3096" leftMargin="2" rightMargin="2" topMargin="0" bottomMargin="0" uuid="8bef2b7f-2fa7-478d-9fab-f989d854dbd8">
	<property name="ireport.zoom" value="1.7715610000000015"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="NOCIA" class="java.lang.String"/>
	<parameter name="NOMBREEMPRESA" class="java.lang.String"/>
	<parameter name="USUARIO" class="java.lang.String"/>
	<parameter name="IMPRIME_CABECERA" class="java.lang.Boolean"/>
	<parameter name="FECHA_DESDE" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="FECHA_HASTA" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
a.cedula,
a.nombre NombreCliente,
d.tipo_doc,
d.no_fisico,
d.fecha,
d.fecha_vence,
d.no_docu_refe letra,
d.m_original saldo_original,
d.saldo saldo_actual,
(d.m_original - d.saldo) pago,
nvl((select sum(d.monto) from arccckf_fac d, arccckf e
    where d.no_cia = c.no_cia
    and d.no_refe = c.no_docu
    and d.no_cia = e.no_cia
    and d.centro = e.centro
    and d.no_docu = e.no_docu
    and e.estado = 'P'),0) valorcuotaCkf,
c.saldo_gestion,
c.usuario_creacion,
c.usuario_cobro,
c.comentario,
c.fecha_creacion,
c.fecha_seguimiento,
c.fecha_proximo_contacto,
c.canal_gestion,
f.descripcion,
c.no_docu,
d.fecha_ultimo_pago
FROM CXC_SEGUIMIENTOS_CARTERA c,arccmc a, CXC_RESULTADO_GESTION f, arccmd d
where c.no_cia = $P{NOCIA}
and c.no_Cia = a.no_Cia
and c.no_Cliente = a.no_cliente
and c.no_Cia = f.no_Cia
and c.codigo_resultado = f.codigo
and c.no_Cia = d.no_Cia
and c.no_docu = d.no_docu
and trunc (c.fecha_creacion) between $P{FECHA_DESDE} and $P{FECHA_HASTA}
order by 11, 1, 6]]>
	</queryString>
