<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="pagosAnticipados" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="ab581871-a1aa-4e12-9e81-c5b0b954aa41">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="p_no_cia" class="java.lang.String"/>
	<parameter name="p_nombre_empresa" class="java.lang.String"/>
	<parameter name="p_usuario" class="java.lang.String"/>
	<parameter name="p_no_fisico" class="java.lang.String"/>
	<parameter name="p_agencia" class="java.lang.String"/>
	<parameter name="p_serie_fisico" class="java.lang.String"/>
	<parameter name="p_cant_prorrogas" class="java.lang.Integer"/>
	<parameter name="p_no_cliente" class="java.lang.Long"/>
	<queryString>
		<![CDATA[SELECT a.no_docu_refe, a.fecha_vence_original,  (select nvl(dia_proceso_cxc,dia_proceso_caja) from inv_control where no_cia=a.no_cia and centro='01')-a.fecha_vence_original dias, a.saldo,
CXC_GENERAL_PCK.obt_interes_descuento(a.no_cia,a.no_cliente,a.no_docu,
a.serie_fisico,a.saldo,a.m_original,a.tasa_financiacion,a.fecha_vence_original,a.clase_documento)interes,
b.cedula,substr(b.nombre,1,30) nombre
      FROM arccmd_all_view a ,arccmc b
      WHERE a.no_cia         = $P{p_no_cia} AND
            a.centro         = $P{p_agencia} AND
            a.no_fisico      = $P{p_no_fisico} AND
            a.serie_fisico   = $P{p_serie_fisico} AND
            a.cant_prorrogas = $P{p_cant_prorrogas} and
            a.no_cliente = $P{p_no_cliente}
            and a.no_cia = b.no_Cia
            and a.grupo = b.grupo
            and a.no_cliente = b.no_cliente
            ORDER BY TO_NUMBER(a.no_docu_refe)]]>
	</queryString>
	<field name="NO_DOCU_REFE" class="java.lang.String"/>
	<field name="FECHA_VENCE_ORIGINAL" class="java.sql.Timestamp"/>
	<field name="DIAS" class="java.math.BigDecimal"/>
	<field name="SALDO" class="java.math.BigDecimal"/>
	<field name="INTERES" class="java.math.BigDecimal"/>
	<field name="CEDULA" class="java.lang.String"/>
	<field name="NOMBRE" class="java.lang.String"/>
	<variable name="total_saldo" class="java.lang.Number" calculation="Sum">
		<variableExpression><![CDATA[$F{SALDO}]]></variableExpression>
	</variable>
	<variable name="total_interes" class="java.lang.Number" calculation="Sum">
		<variableExpression><![CDATA[$F{INTERES}]]></variableExpression>
	</variable>
	<variable name="total" class="java.lang.Number" calculation="Sum">
		<variableExpression><![CDATA[$F{SALDO}+$F{INTERES}]]></variableExpression>
	</variable>
