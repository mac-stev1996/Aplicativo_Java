<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="cxcRepCarteraVencidaPorVencer" pageWidth="950" pageHeight="802" columnWidth="946" leftMargin="2" rightMargin="2" topMargin="0" bottomMargin="0" uuid="8bef2b7f-2fa7-478d-9fab-f989d854dbd8">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="267"/>
	<property name="ireport.y" value="0"/>
	<parameter name="NOCIA" class="java.lang.String"/>
	<parameter name="NOMBREEMPRESA" class="java.lang.String"/>
	<parameter name="USUARIO" class="java.lang.String"/>
	<parameter name="IMPRIME_CABECERA" class="java.lang.Boolean"/>
	<parameter name="PANIO" class="java.lang.Integer"/>
	<parameter name="PMES" class="java.lang.Integer"/>
	<parameter name="LINEA_NEGOCIO" class="java.lang.String"/>
	<queryString>
		<![CDATA[select b.cedula,substr(b.nombre,1,33) nombre,a.centro,no_fisico,serie_fisico,cant_prorrogas,sum(nvl(saldo,0)) sald
from CXC_SALDOS_MENSUALES a,CXC_CLIENTES_MENSUALES b
where a.no_cia =$P{NOCIA}
and a.ANIO_CIERRE=b.ANO_CIERRE
and a.MES_CIERRE=b.MES_CIERRE
and a.ANIO_CIERRE=$P{PANIO}
and a.MES_CIERRE=$P{PMES}
and a.serie_fisico =$P{LINEA_NEGOCIO}
and nvl(anulado,' ') = 'N'
and substr(no_fisico,1,3) <> '600'
and nvl(saldo,0) > 0
and nvl(no_docu_refe,' ') >= '1'
and b.no_cia = a.no_cia
and b.grupo = a.grupo
and b.no_cliente = a.no_cliente
and NVL(b.RELACION,' ') <> 'ER'
and nvl(incobrable,' ') not in ('1','2')
group by b.cedula,b.nombre,a.centro,no_fisico,serie_fisico,cant_prorrogas
order by b.nombre]]>
	</queryString>
	<field name="CEDULA" class="java.lang.String"/>
	<field name="NOMBRE" class="java.lang.String"/>
	<field name="CENTRO" class="java.lang.String"/>
	<field name="NO_FISICO" class="java.lang.String"/>
