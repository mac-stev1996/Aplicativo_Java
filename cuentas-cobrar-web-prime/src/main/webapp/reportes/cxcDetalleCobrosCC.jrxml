<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="cxcDetalleCobrosCC" language="groovy" pageWidth="1090" pageHeight="842" columnWidth="1050" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="696bc593-2e93-4489-90d5-9712413c9cab">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="p_no_cia" class="java.lang.String"/>
	<parameter name="p_nombre_empresa" class="java.lang.String"/>
	<parameter name="p_usuario" class="java.lang.String"/>
	<parameter name="p_linea_negocio" class="java.lang.String"/>
	<parameter name="p_fecha_inicio" class="java.util.Date"/>
	<parameter name="p_fecha_fin" class="java.util.Date"/>
	<parameter name="p_imprime_cabecera" class="java.lang.Boolean">
		<defaultValueExpression><![CDATA[new Boolean(true)]]></defaultValueExpression>
	</parameter>
	<parameter name="p_tipo_pago" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT DISTINCT d.centro,d.no_fisico factura,d.serie_fisico linea,d.cant_prorrogas,d.no_docu_refe,b.relacion,
 b.cedula,substr(b.nombre,1,30) nombre,e.no_fisico||e.serie_fisico INGRESO,
a.monto_doc,a.descuento,a.interes,a.total_pago,a.fecha, d.fecha_vence ,
case b.relacion when 'ER' then trunc($P{p_fecha_fin}) - trunc(d.fecha_vence) else 0 end dias
from arccrd a, arccmc b,arcctd c,arccmd d,arccmd e
where a.no_cia = $P{p_no_cia}
   and  trunc(a.fecha) >= trunc($P{p_fecha_inicio})
  and trunc(a.fecha)  <= trunc($P{p_fecha_fin})
  and a.no_cia = b.no_cia
  and a.grupo = b.grupo
  and a.no_cliente = b.no_cliente
 and nvl(relacion,'EX') = 'ER'
  and a.no_cia = d.no_cia
  and a.no_refe = d.no_docu
  and nvl(d.serie_fisico,'0')=nvl($P{p_linea_negocio},d.serie_fisico)
  and d.tipo_doc <> 'SE'
  and nvl(d.incobrable,' ') not in ('1','2')
  and a.tipo_doc not in ('DD','FD','DC','TD')
  and a.no_cia = e.no_cia
  and a.no_cliente = e.no_cliente
  and a.no_docu = e.no_docu
  and e.serie_fisico =nvl($P{p_tipo_pago},e.serie_fisico)
  and a.no_cia = c.no_cia
  and a.tipo_refe = c.tipo
  and c.tipo_mov = 'D'
order by INGRESO]]>
	</queryString>
