<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="cxcRegistroMercantil" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="182c1d55-c764-404a-b66f-c24833ab4f28">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="231"/>
	<parameter name="p_no_cia" class="java.lang.String"/>
	<parameter name="p_agencia" class="java.lang.String"/>
	<parameter name="p_no_fisico" class="java.lang.String"/>
	<parameter name="p_serie_fisico" class="java.lang.String"/>
	<parameter name="p_cant_prorrogas" class="java.lang.Integer"/>
	<parameter name="p_no_cliente" class="java.lang.String"/>
	<parameter name="p_no_inscripcion" class="java.lang.String"/>
	<parameter name="p_tomo" class="java.lang.String"/>
	<parameter name="p_anio" class="java.lang.String"/>
	<parameter name="p_fecha" class="java.util.Date"/>
	<queryString>
		<![CDATA[select b.cedula, substr(b.nombre,1,50)  nombre,
           decode(b.gracia,1,'Señor',2,'Señora',3,'Señorita',4,'Señores',5,'Señores',null,'Señores') gracia,
           a.chasis,TO_CHAR(a.fecha, 'DD/MM/YYYY') fecha,a.centrod||'-'||a.no_fisico factura,
           c.svmrcodi marca,  c.svinafabr modelo, c.svinmotor motor, c.svinafabr anio_fabri,
           nvl((select  d.svcodescri from svfmascol d where d.no_cia = a.no_cia  and d.svmamaster = c.svmamaster
    	     and d.svcotipo = 'E'  and d.svcocodi = c.svincoex),'***') color_master,
           nvl((select  e.svcodescri from svfcolor e  where e.no_cia = c.no_cia and e.svcotipo = 'E' and  e.svcocodi=c.svincoex),'***') color_semi,
          p.texto1 reponsable, p.texto2 cargo,
          (select  count(*) from arccmd
  where no_cia = a.no_cia  and centro = a.centrod  and no_fisico = a.no_fisico  and serie_fisico =  a.serie_fisico and cant_prorrogas = a.cant_prorrogas ) letras,
(select nombre from arcgmc where no_cia=a.no_cia) nombre_compania,
(select no_fisico||serie_fisico
 from arccmd
where no_cia =a.no_cia
and no_docu = (select max(no_docu) from arccrd
                where no_cia =a.no_cia
                and no_refe = (select max(no_docu) from arccmd
                                where no_cia  =a.no_cia
                                and no_fisico = a.no_fisico
                                and serie_fisico =a.serie_fisico
                                and centro = a.centrod
                                and no_cliente = a.no_cliente
                                and cant_prorrogas = a.cant_prorrogas))) ingreso1,
    nvl((select max(nota_ingreso) from svfant	where no_cia = a.no_cia	and no_factu_refe = a.no_factu),'***') ingreso2
from fac_ventas_cab a, arccmc b, svfinven c, param_det p
where a.no_cia = $P{p_no_cia}
and a.centrod = $P{p_agencia}
and a.no_fisico =$P{p_no_fisico}
and a.serie_fisico = $P{p_serie_fisico}
and a.cant_prorrogas = $P{p_cant_prorrogas}
and a.no_cliente=$P{p_no_cliente}
and a.no_cia = b.no_cia
and a.no_cliente = b.no_cliente
and a.no_cia=c.no_cia(+)
and a.chasis=c.svincodi(+)
and a.no_cia=p.no_cia(+)
and p.codigo(+) = 'FDCXC'
and p.codigo_det(+) = '01']]>
	</queryString>
