<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="cxcNotaCredito" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="bcc6fdda-cfb0-40d0-a39c-3951b0921f60">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="p_no_cia" class="java.lang.String"/>
	<parameter name="p_no_docu" class="java.lang.String"/>
	<parameter name="p_nombre_empresa" class="java.lang.String"/>
	<queryString>
		<![CDATA[select a.fecha,b.centro,b.no_fisico,b.serie_fisico,b.cant_prorrogas,b.no_docu_refe,a.monto,a.descuento,a.interes,a.total_pago,
c.cedula,c.nombre,
(select no_fisico from arccmd where no_cia=a.no_cia and no_docu=a.no_docu) no_docu
from arccrd a,arccmd b,arccmc c
where a.no_cia = $P{p_no_cia}
and   a.no_docu = $P{p_no_docu}
and a.no_cia = b.no_cia
and a.no_refe = b.no_docu
and a.no_cia=c.no_cia
and a.no_cliente=c.no_cliente]]>
	</queryString>
	<field name="FECHA" class="java.sql.Timestamp"/>
	<field name="CENTRO" class="java.lang.String"/>
	<field name="NO_FISICO" class="java.lang.String"/>
	<field name="SERIE_FISICO" class="java.lang.String"/>
	<field name="CANT_PRORROGAS" class="java.math.BigDecimal"/>
	<field name="NO_DOCU_REFE" class="java.lang.String"/>
	<field name="MONTO" class="java.math.BigDecimal"/>
	<field name="DESCUENTO" class="java.math.BigDecimal"/>
	<field name="INTERES" class="java.math.BigDecimal"/>
	<field name="TOTAL_PAGO" class="java.math.BigDecimal"/>
	<field name="CEDULA" class="java.lang.String"/>
	<field name="NOMBRE" class="java.lang.String"/>
	<field name="NO_DOCU" class="java.lang.String"/>
	<variable name="total_monto" class="java.lang.Number" calculation="Sum">
		<variableExpression><![CDATA[$F{MONTO}]]></variableExpression>
	</variable>
	<variable name="total_descuento" class="java.lang.Number" calculation="Sum">
