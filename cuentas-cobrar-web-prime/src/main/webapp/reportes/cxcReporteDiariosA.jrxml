<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="cxcReporteDiariosA" pageWidth="2760" pageHeight="802" columnWidth="2760" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="3c2c442b-31bf-491c-9a72-b1b2170bf9ab">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="P_NOCIA" class="java.lang.String"/>
	<parameter name="P_NOMBRE_EMPRESA" class="java.lang.String"/>
	<parameter name="IMPRIME_CABECERA" class="java.lang.Boolean"/>
	<parameter name="P_FECHA_INI" class="java.util.Date"/>
	<parameter name="P_FECHA_FIN" class="java.util.Date"/>
	<queryString>
		<![CDATA[SELECT
  a.no_fisico,
  A.serie_fisico,
  A.NO_DOCU ,
  A.TIPO_DOC ,
  a.fecha,
  A.CENTRO ,
  ag.nombre AGENCIA,
  a.no_cliente,
  c.cedula,
  c.nombre,
  b.ctacon_id,
  b.tipo,
  d.nombre descripcion_cta,
  NVL(A.DEPOSITOS_$,0) DEP$,
  NVL(A.ANTICIPO,0) ANT,
  NVL(A.ANTICIPO_$,0) ANT$,
  NVL(A.MEMO_$,0) MEM$,
  NVL(A.DESCUENTO,0) DESCU,
  SUBSTR(A.SERIE_FISICO,1,3) Tipo_Comp,

  b.monto_dol,
    A.usuario,
    u.NOMBRE nombre_usuario,
  b.no_asiento ,
  '   '
  ||a.comentar COMENTAR
FROM
  arccda a,
  arccdc_scb b,
  arccmc c,
  con_planctas d,
  agencias ag,
  USUARIOS_SIS u
WHERE
  a.no_cia = $P{P_NOCIA}
AND a.fecha >=  $P{P_FECHA_INI}
AND a.fecha < $P{P_FECHA_FIN} +1
AND NVL(a.anulado,'N') = 'N'
AND a.no_cia           = b.no_cia
AND a.centro           = b.centro
AND a.no_docu          = b.no_docu
AND a.no_cia           = c.no_cia
AND a.no_cliente       = c.no_cliente
AND b.no_cia           = d.empresa_id
AND b.ctacon_id        = d.ctacon_id
and a.NO_CIA =  ag.no_cia(+)
and a.centro = ag.codigo(+)
and a.USUARIO = u.USUARIO(+)
ORDER BY  a.fecha]]>
	</queryString>
