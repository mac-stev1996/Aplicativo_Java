			<textField pattern="###0.00;-###0.00">
				<reportElement uuid="8ae9e7dd-f60f-465f-8865-02970270c910" x="828" y="20" width="100" height="20"/>
				<textElement textAlignment="Right"/>
				<textFieldExpression><![CDATA[$F{VENCIDO30}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement uuid="8b7f4f2a-b03b-4c50-b50d-aabd3c3c7b23" x="650" y="20" width="178" height="20" forecolor="#000000"/>
				<textElement verticalAlignment="Top">
