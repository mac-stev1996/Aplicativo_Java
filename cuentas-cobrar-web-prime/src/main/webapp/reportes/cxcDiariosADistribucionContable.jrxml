<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="cxcDiariosADistribucionContable" pageWidth="800" pageHeight="802" columnWidth="800" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="ee1f736a-a296-4017-81a8-abb5f74c04a8">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="P_NO_CIA" class="java.lang.String"/>
	<parameter name="P_NO_DOCU" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT (a.uniadmin_id) centro,
  a.ctacon_id cuenta_con,
  b.nombre nombre_cta,
  a.tipo,
  decode(a.tipo,'D',a.monto_dol,0) debito,
decode(a.tipo,'C',a.monto_dol,0) credito
FROM arccdc_scb a,
  con_planctas b
WHERE a.no_cia  = $P{P_NO_CIA}
AND a.no_cia    = b.empresa_id
AND a.ctacon_id = b.ctacon_id
AND a.no_docu   = $P{P_NO_DOCU}]]>
	</queryString>
	<field name="CENTRO" class="java.lang.String"/>
	<field name="CUENTA_CON" class="java.lang.String"/>
	<field name="NOMBRE_CTA" class="java.lang.String"/>
	<field name="TIPO" class="java.lang.String"/>
	<field name="DEBITO" class="java.math.BigDecimal"/>
	<field name="CREDITO" class="java.math.BigDecimal"/>
	<variable name="SUMDEBITO" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{DEBITO}]]></variableExpression>
	</variable>
	<variable name="SUMCREDITO" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{CREDITO}]]></variableExpression>
	</variable>
