<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="cxcRepAnticiposMensuales" pageWidth="2125" pageHeight="802" columnWidth="2121" leftMargin="2" rightMargin="2" topMargin="0" bottomMargin="0" isIgnorePagination="true" uuid="8bef2b7f-2fa7-478d-9fab-f989d854dbd8">
	<property name="ireport.zoom" value="2.3579476910000046"/>
	<property name="ireport.x" value="576"/>
	<property name="ireport.y" value="0"/>
	<parameter name="NOCIA" class="java.lang.String"/>
	<parameter name="NOMBREEMPRESA" class="java.lang.String"/>
	<parameter name="USUARIO" class="java.lang.String"/>
	<parameter name="IMPRIME_CABECERA" class="java.lang.Boolean"/>
	<parameter name="ANIO" class="java.lang.Integer"/>
	<parameter name="MES" class="java.lang.Integer"/>
	<parameter name="LINEA_NEGOCIO" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT DISTINCT
    b.no_linea,
    e.descripcion   nomlinea,
    (select nombre from agencias where no_cia = a.no_cia and codigo = a.centro) as agencia,
    c.cedula,
    c.nombre        nombre,
    a.no_fisico || a.serie_fisico no_fisico,
    a.fecha,
    b.monto_doc,
    nvl(b.monto_utilizado, 0) monto_utilizado,
    a.saldo,
    a.fecha_digitacion,
    nvl(d.moneda_id, '02') moneda_id,
    nvl(nvl(nvl(d.comentario,(
        SELECT
            comentar
        FROM
            arcjca
        WHERE
            no_cia = d.no_cia
            AND no_cliente = d.no_cliente
            AND no_docu = d.no_docu
    )),(
        SELECT
            f2.vehiculo
        FROM
            fac_ventas_cab f1,
            fac_ventas_vehiculos f2
        WHERE
            f1.no_cia = f2.no_cia
            AND f1.no_factu = f2.no_factu
            AND f1.no_cia = d.no_cia
            AND f1.centrod = d.centro
            AND f1.tipo_doc = d.tipo_doc
            AND f1.no_cliente = d.no_cliente
            AND f1.linea_negocio = d.no_linea
            AND f1.no_fisico = d.no_fisico
            AND ROWNUM = 1
    )),((
        SELECT
            f1.observ1
        FROM
            fac_ventas_cab f1
        WHERE
            f1.no_cia = d.no_cia
            AND f1.centrod = d.centro
            AND f1.tipo_doc = d.tipo_doc
            AND f1.no_cliente = d.no_cliente
            AND f1.no_fisico = d.no_fisico
            AND ROWNUM = 1
    ))) comentario,
    CASE
        WHEN a.fecha_digitacion IS NULL THEN NULL
        WHEN TRUNC(SYSDATE) - TRUNC(a.fecha_digitacion) <= 30  THEN '1-30 D'
        WHEN TRUNC(SYSDATE) - TRUNC(a.fecha_digitacion) <= 60  THEN '31-60 D'
        WHEN TRUNC(SYSDATE) - TRUNC(a.fecha_digitacion) <= 90  THEN '61-90 D'
        WHEN TRUNC(SYSDATE) - TRUNC(a.fecha_digitacion) <= 120 THEN '91-120 D'
        WHEN TRUNC(SYSDATE) - TRUNC(a.fecha_digitacion) <= 150 THEN '121-150 D'
        WHEN TRUNC(SYSDATE) - TRUNC(a.fecha_digitacion) <= 180 THEN '151-180 D'
        ELSE '+180 D'
    END AS rango_dias,

    CASE
        WHEN ABS(NVL(a.saldo, 0)) <= 1    THEN '0-1'
        WHEN ABS(NVL(a.saldo, 0)) <= 10   THEN '1-10'
        WHEN ABS(NVL(a.saldo, 0)) <= 50   THEN '11-50'
        WHEN ABS(NVL(a.saldo, 0)) <= 100  THEN '51-100'
        WHEN ABS(NVL(a.saldo, 0)) <= 500  THEN '101-500'
        WHEN ABS(NVL(a.saldo, 0)) <= 1000 THEN '501-1000'
        WHEN ABS(NVL(a.saldo, 0)) <= 5000 THEN '1001-5000'
        ELSE '+5000'
    END AS rango_valor
FROM
    cxc_saldos_mensuales     a,
    cxc_arcjan_mensual       b,
    cxc_clientes_mensuales   c,
    arccmd                   d,
    arcjli                   e
WHERE
    a.no_cia = $P{NOCIA}
    AND nvl(a.anulado, 'N') = 'N'
    AND nvl(a.saldo, 0) < 0
    AND a.anio_cierre = $P{ANIO}
    AND a.mes_cierre = $P{MES}
    AND a.no_cia = b.no_cia
    AND a.no_docu = b.no_docu
    AND a.anio_cierre = b.anio_cierre
    AND a.mes_cierre = b.mes_cierre
    and nvl(b.no_linea,'0') =  nvl( $P{LINEA_NEGOCIO} ,nvl(b.no_linea,'0'))
    AND b.aplica_como = 'AN'
    AND a.no_cia = c.no_cia
    AND a.grupo = c.grupo
    AND a.no_cliente = c.no_cliente
    AND c.ano_cierre = a.anio_cierre
    AND c.mes_cierre = a.mes_cierre
    AND a.no_cia = d.no_cia
    AND a.no_cliente = d.no_cliente
    AND a.no_docu = d.no_docu
    AND b.no_cia = e.no_cia
    AND b.no_linea = e.no_linea
UNION
SELECT DISTINCT
    b.no_linea,
    e.descripcion   nomlinea,
    (select nombre from agencias where no_cia = a.no_cia and codigo = a.centro) as agencia,
    c.cedula,
    c.nombre        nombre,
    a.no_fisico || a.serie_fisico no_fisico,
    a.fecha,
    b.monto_doc,
    nvl(b.monto_utilizado, 0) monto_utilizado,
    a.saldo,
    a.fecha_digitacion,
    nvl(d.moneda_id, '02') moneda_id,
    nvl(nvl(nvl(d.comentario,(
        SELECT
            comentar
        FROM
            arcjca
        WHERE
            no_cia = d.no_cia
            AND no_cliente = d.no_cliente
            AND no_docu = d.no_docu
    )),(
        SELECT
            f2.vehiculo
        FROM
            fac_ventas_cab f1,
	  fac_ventas_vehiculos   f2
        WHERE
            f1.no_cia = f2.no_cia
            AND f1.no_factu = f2.no_factu
            AND f1.no_cia = d.no_cia
            AND f1.centrod = d.centro
            AND f1.tipo_doc = d.tipo_doc
            AND f1.no_cliente = d.no_cliente
            AND f1.linea_negocio = d.no_linea
            AND f1.no_fisico = d.no_fisico
            AND ROWNUM = 1
    )),((
        SELECT
            f1.observ1
        FROM
            fac_ventas_cab f1
        WHERE
            f1.no_cia = d.no_cia
            AND f1.centrod = d.centro
            AND f1.tipo_doc = d.tipo_doc
            AND f1.no_cliente = d.no_cliente
            AND f1.no_fisico = d.no_fisico
            AND ROWNUM = 1
    ))) comentario,
    CASE
        WHEN a.fecha_digitacion IS NULL THEN NULL
        WHEN TRUNC(SYSDATE) - TRUNC(a.fecha_digitacion) <= 30  THEN '1-30 D'
        WHEN TRUNC(SYSDATE) - TRUNC(a.fecha_digitacion) <= 60  THEN '31-60 D'
        WHEN TRUNC(SYSDATE) - TRUNC(a.fecha_digitacion) <= 90  THEN '61-90 D'
        WHEN TRUNC(SYSDATE) - TRUNC(a.fecha_digitacion) <= 120 THEN '91-120 D'
        WHEN TRUNC(SYSDATE) - TRUNC(a.fecha_digitacion) <= 150 THEN '121-150 D'
        WHEN TRUNC(SYSDATE) - TRUNC(a.fecha_digitacion) <= 180 THEN '151-180 D'
        ELSE '+180 D'
    END AS rango_dias,

    CASE
        WHEN ABS(NVL(a.saldo, 0)) <= 1    THEN '0-1'
        WHEN ABS(NVL(a.saldo, 0)) <= 10   THEN '1-10'
        WHEN ABS(NVL(a.saldo, 0)) <= 50   THEN '11-50'
        WHEN ABS(NVL(a.saldo, 0)) <= 100  THEN '51-100'
        WHEN ABS(NVL(a.saldo, 0)) <= 500  THEN '101-500'
        WHEN ABS(NVL(a.saldo, 0)) <= 1000 THEN '501-1000'
        WHEN ABS(NVL(a.saldo, 0)) <= 5000 THEN '1001-5000'
        ELSE '+5000'
    END AS rango_valor

FROM
    cxc_saldos_mensuales     a,
    cxc_arccan_mensual       b,
    cxc_clientes_mensuales   c,
    arccmd                   d,
    arcjli                   e
WHERE
    a.no_cia = $P{NOCIA}
    AND nvl(a.anulado, 'N') = 'N'
    AND nvl(a.saldo, 0) < 0
    AND a.anio_cierre = $P{ANIO}
    AND a.mes_cierre = $P{MES}
    AND a.no_cia = b.no_cia
    AND a.no_docu = b.no_docu
    AND a.anio_cierre = b.anio_cierre
    AND a.mes_cierre = b.mes_cierre
    and nvl(b.no_linea,'0') = nvl($P{LINEA_NEGOCIO},nvl(b.no_linea,'0'))
    AND b.aplica_como = 'AN'
    AND a.no_cia = c.no_cia
    AND a.grupo = c.grupo
    AND a.no_cliente = c.no_cliente
    AND c.ano_cierre = a.anio_cierre
    AND c.mes_cierre = a.mes_cierre
    AND a.no_cia = d.no_cia
    AND a.no_cliente = d.no_cliente
    AND a.no_docu = d.no_docu
    AND b.no_cia = e.no_cia
    AND b.no_linea = e.no_linea
ORDER BY
    nombre,
    no_fisico]]>
	</queryString>
