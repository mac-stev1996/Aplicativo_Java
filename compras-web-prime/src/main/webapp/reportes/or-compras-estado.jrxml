<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="or-compras-estado" language="groovy" pageWidth="5780" pageHeight="595" orientation="Landscape" columnWidth="5740" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isIgnorePagination="true" uuid="a3d071ce-60df-44ed-868e-2fb4f71089fc">
	<property name="ireport.zoom" value="1.6105100000000028"/>
	<property name="ireport.x" value="2675"/>
	<property name="ireport.y" value="0"/>
	<parameter name="no_cia" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="fecha_inicio" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="fecha_fin" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
c.no_cia,
C.NO_ORDEN_COMPRA,
C.CODE,
CAST(C.fecha AS DATE) FECHA,
nvl (c.usuario_registra,'-') as USUARIO_CREA,
nvl (u.nombre, ' ') AS NOMBRE_CREA,
nvl (substr(c.usuarios_aprobacion,1,instr(c.usuarios_aprobacion,'|')-1),'-') as USUARIO_APROBADOR1,
nvl (UA1.nombre, ' ') AS NOMBRE_APROBADOR1,
nvl (substr(c.usuarios_aprobacion,instr(c.usuarios_aprobacion,'|')+1,length(c.usuarios_aprobacion)), '-') as USUARIO_APROBADOR2,
nvl (UA2.nombre, ' ') AS NOMBRE_APROBADOR2,
c.agencia codigo_agencia,
A.NOMBRE AGENCIA,
G.CUENTA_CONTABLE,
plancta.NOMBRE AS NOMBRE_CUENTA,

nvl(cmpcostos.CODIGO_CENTRO, (select codigo_centro_costos from cmp_centro_de_costos
                                                                        WHERE no_cia=c.no_cia and codigo_agencia=c.agencia  and code_orden_compra=c.code and rownum=1)) AS CENTRO_COSTOS,

                nvl(cc.nombre,(select gu.nombre from cmp_centro_de_costos ccc, g_uniadmin gu
                                            WHERE ccc.no_cia=gu.empresa_id and ccc.codigo_centro_costos=gu.uniadmin_id  and codigo_agencia=c.agencia  and code_orden_compra=c.code and rownum=1))NOMBE_CENTRO_COSTOS,


R.DESCRIPCION TIPO_FLUJO,
C.CODIGO_GRUPO_COMPRA,
G.DESCRIPCION GRUPO_DE_COMPRA,
(SELECT DESCRIPCION FROM (
SELECT '0' CODIGO, 'SOLICITUD COMPRA NEGADA' DESCRIPCION FROM DUAL UNION
SELECT '1' CODIGO, 'SOLICITUD INGRESADA' DESCRIPCION FROM DUAL UNION
SELECT '2' CODIGO, 'SOLICITUD ENVIADA' DESCRIPCION FROM DUAL UNION
SELECT '3' CODIGO, 'COTIZANDO ORDEN DE COMPRA' DESCRIPCION FROM DUAL UNION
SELECT '4' CODIGO, 'DECISION COTIZACIONES' DESCRIPCION FROM DUAL UNION
SELECT '5' CODIGO, 'ORDEN DE COMPRA RETORNADA' DESCRIPCION FROM DUAL UNION
SELECT '6' CODIGO, 'ESPERA APROBACION' DESCRIPCION FROM DUAL UNION
SELECT '7' CODIGO, 'ESPERA APROBACION GERENCIA GENERAL' DESCRIPCION FROM DUAL UNION
SELECT '8' CODIGO, 'ORDEN DE COMPRA APROBADA' DESCRIPCION FROM DUAL UNION
SELECT '9' CODIGO, 'ESPERA REVISION COORDINADOR COMPRAS' DESCRIPCION FROM DUAL UNION
SELECT '10' CODIGO, 'ENVIADO PARCIALMENTE PROVEEDOR' DESCRIPCION FROM DUAL UNION
SELECT '11' CODIGO, 'ENVIADO A PROVEEDOR' DESCRIPCION FROM DUAL UNION
SELECT '12' CODIGO, 'RECEPCION PRODUCTO O SERVICIO' DESCRIPCION FROM DUAL UNION
SELECT '13' CODIGO, 'VALIDACION PRODUCTO SERVICIO FACTURA' DESCRIPCION FROM DUAL UNION
SELECT '14' CODIGO, 'ENVIADO TESORERIA PARCIALMENTE' DESCRIPCION FROM DUAL UNION
SELECT '15' CODIGO, 'ENVIADO TESORERIA' DESCRIPCION FROM DUAL UNION
SELECT '16' CODIGO, 'PAGADO TESORERIA' DESCRIPCION FROM DUAL UNION
SELECT '17' CODIGO, 'REVISION COORDINADOR ADMINISTRATIVO' DESCRIPCION FROM DUAL UNION
SELECT '21' CODIGO, 'ESPERA AUTORIZACION JEFE COMPRAS' DESCRIPCION FROM DUAL UNION
SELECT '22' CODIGO, 'DECISION PRESUPUESTO' DESCRIPCION FROM DUAL UNION
SELECT '23' CODIGO, 'ESPERA APROBACION DEL GASTO' DESCRIPCION FROM DUAL UNION
SELECT '24' CODIGO, 'INFORMACION PRESUPUESTO' DESCRIPCION FROM DUAL UNION
SELECT '25' CODIGO, 'DESCION PRESUPUESTO MONTOS' DESCRIPCION FROM DUAL UNION
SELECT '27' CODIGO, 'ESPERA APROBACION DEPARTAMENTO FINANCIERO' DESCRIPCION FROM DUAL UNION
SELECT '28' CODIGO, 'EN ESPERA SALIDA INVENTARIO' DESCRIPCION FROM DUAL UNION
SELECT '33' CODIGO, 'RETORNADO FACTURA' DESCRIPCION FROM DUAL UNION
SELECT '34' CODIGO, 'DECISION RECEPCION FACTURAS' DESCRIPCION FROM DUAL UNION
SELECT '37' CODIGO, 'INFORMACION COMPRAS' DESCRIPCION FROM DUAL UNION
SELECT '50' CODIGO, 'ELIMINADO ORDEN COMPRA' DESCRIPCION FROM DUAL UNION
SELECT '61' CODIGO, 'DECISION ESPERA APROBACION' DESCRIPCION FROM DUAL UNION
SELECT '80' CODIGO, 'ENVIO FACTURAS CUENTAS POR PAGAR' DESCRIPCION FROM DUAL UNION
SELECT '85' CODIGO, 'DECISION PRODUCTO SERVICIO INTERNO' DESCRIPCION FROM DUAL UNION
SELECT '91' CODIGO, 'DECISION APROBACION COTIZACIONES' DESCRIPCION FROM DUAL UNION
SELECT '92' CODIGO, 'DECISION ORDEN FINALIZADA' DESCRIPCION FROM DUAL UNION
SELECT '94' CODIGO, 'DECISION ENVIO TESORERIA' DESCRIPCION FROM DUAL UNION
SELECT '95' CODIGO, 'SOLICITUD RETORNADA A PROVEEDOR' DESCRIPCION FROM DUAL UNION
SELECT '96' CODIGO, 'ESPERA RECEPCION PRODUCTO O SERVICIO' DESCRIPCION FROM DUAL UNION
SELECT '97' CODIGO, 'DECISION RECEPCION PRODUCTO O SERVICIO' DESCRIPCION FROM DUAL UNION
SELECT '98' CODIGO, 'DECISION ENVIO PROVEEDOR' DESCRIPCION FROM DUAL UNION
SELECT '99' CODIGO, 'SOLICITUD COMPRA FINALIZADA' DESCRIPCION FROM DUAL )
WHERE CODIGO = C.ESTADO_ORDEN_COMPRA) ESTADO_COMPRA,
prove.cedula ruc,
prove.nombre AS proveedor,
c.no_orden_compra,
cmpprov.no_orden_envio AS ordenenvio,
d.razon_compra,
d.descripicion_maestro_item AS descipcion_compra,
d.cantidad_solicitada,
d.cantidad_recibida,
d.precio,
d.subtotal,
d.iva,
d.porcentaje_iva,
d.subtotal AS total,
cmpprov.fecha_estimada,
d.usuario_solicita,
d.persona_recibe_pedido,
orfact.no_factura,
orfact.numero_autorizacion,
orfact.fecha_factura,
orfact.iva AS iva_factura,
orfact.total AS total_factura
FROM
    admscb.cmp_orden_compra                 c
    LEFT JOIN admscb.cmp_detalle_orden_compra         d ON c.code = d.code_orden_compra
    LEFT JOIN admscb.cmp_grupo_compra                 g ON c.codigo_grupo_compra = g.code
                                           AND c.no_cia = g.no_cia
    LEFT JOIN admscb.cmp_grupo_tipo_compra            t ON c.codigo_grupo_compra = t.codigo_grupo_compra
    LEFT JOIN admscb.cmp_ruteo_compras                r ON c.no_cia = r.no_cia
                                            AND t.codigo_tipo_compra = r.code
    LEFT JOIN admscb.cmp_detalle_compra_costos        cmpcostos ON d.code = cmpcostos.codigo_detalle_compra
    LEFT JOIN admscb.g_uniadmin                       cc ON cmpcostos.codigo_centro = cc.uniadmin_id
    LEFT JOIN admscb.con_planctas                     plancta ON c.no_cia = plancta.empresa_id
                                             AND g.cuenta_contable = plancta.ctacon_id
    LEFT JOIN admscb.cmp_detalle_compra_proveedores   cmpprov ON cmpcostos.code = cmpprov.codigo_centro_costos
    LEFT JOIN admscb.arcpmp                           prove ON cmpprov.no_prove = prove.no_prove
                                     AND cmpprov.no_cia = prove.no_cia
    LEFT JOIN admscb.cmp_orden_compra_factura         orfact ON c.code = orfact.code_orden_compra
                                                        AND prove.no_prove = orfact.codigo_proveedor
    LEFT JOIN admscb.agencias                         a ON c.no_cia = a.no_cia
                                   AND c.agencia = a.codigo
    LEFT JOIN admscb.usuarios_sis                     u ON c.usuario_registra = u.usuario
    LEFT JOIN admscb.usuarios_sis                     ua1 ON substr(c.usuarios_aprobacion, 1, instr(c.usuarios_aprobacion, '|') - 1) = ua1.usuario
    LEFT JOIN admscb.usuarios_sis                     ua2 ON substr(c.usuarios_aprobacion, instr(c.usuarios_aprobacion, '|') + 1, length(c.usuarios_aprobacion
    )) = ua2.usuario
WHERE
    trunc(c.fecha) BETWEEN trunc($P{fecha_inicio}) AND trunc($P{fecha_fin})
    AND c.no_cia = $P{no_cia}
-- and C.NO_ORDEN_COMPRA IN (2723) AND C.agencia = '03'
ORDER BY c.no_cia,
         c.hora,
         a.nombre,
         g.descripcion,
         c.no_orden_compra DESC]]>
	</queryString>
